@@ -0,0 +1,510 @@
+package dynamic
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+)
+
+// FailureCause names why a classified provider failure happened. One cause
+// decides how far a suspension reaches and how long it lasts, so two notices
+// with the same wording on two paths can mean different things: OpenCode Zen's
+// "Rate limit exceeded. Please try again later" is its free daily allowance,
+// while the same code from another gateway is a short per-minute limit.
+//
+// The mapping is data: failureCauseRules picks the cause from the classifier
+// rule, the code and the candidate's path, and failureCausePolicies gives each
+// cause its scope and duration. A newly collected signature is one rule in
+// routingerr plus one row here.
+type FailureCause string
+
+const (
+	// CauseAccountQuota is an exhausted subscription or prepaid plan: every
+	// model the account reaches through this path stops until the stated reset.
+	CauseAccountQuota FailureCause = "account_quota"
+	// CauseGoUsageLimit is the OpenCode Go subscription usage limit. It covers
+	// the paid models of the account; its free models keep working.
+	CauseGoUsageLimit FailureCause = "go_usage_limit"
+	// CauseFreeDailyLimit is a per-model free daily allowance. It resets at
+	// 00:00 UTC (09:00 KST), so a retry the same day only spends a turn.
+	CauseFreeDailyLimit FailureCause = "free_daily_limit"
+	// CauseFreeAccountDailyLimit is a daily allowance shared by every free model
+	// of one account (OpenRouter "free-models-per-day").
+	CauseFreeAccountDailyLimit FailureCause = "free_account_daily_limit"
+	// CauseUsageLimit is any other rate or quota limit. It keeps the metering
+	// rules that predate this table: model scope for free and OpenCode Go
+	// models, account scope otherwise, and the existing ladders.
+	CauseUsageLimit FailureCause = "usage_limit"
+	// CauseUpstreamHostLimit is a gateway's shared upstream pool that is
+	// rate-limited for one model ("temporarily rate-limited upstream").
+	CauseUpstreamHostLimit FailureCause = "upstream_host_limit"
+	// CauseGatewayRateLimit is a gateway notice that does not name its window.
+	CauseGatewayRateLimit FailureCause = "gateway_rate_limit"
+	// CauseModelWithdrawn is a model the gateway no longer serves.
+	CauseModelWithdrawn FailureCause = "model_withdrawn"
+	// CauseAccountSetting is an account setting that excludes the model until
+	// the owner changes it.
+	CauseAccountSetting FailureCause = "account_setting"
+	// CauseEndpointIntermittent is one model's upstream endpoint on one gateway
+	// that drops out for minutes at a time.
+	CauseEndpointIntermittent FailureCause = "endpoint_intermittent"
+	// CauseModelHost is a slow or failing model host. A host serves the model
+	// on every path, so a second path failing within the window suspends the
+	// model everywhere.
+	CauseModelHost FailureCause = "model_host"
+	// CauseNetwork is a connection that could not be made or was dropped.
+	CauseNetwork FailureCause = "network"
+	// CauseCredential is a missing, expired or unentitled credential.
+	CauseCredential FailureCause = "credential"
+	// CauseAccountBlocked is an account the gateway restricted. The execution
+	// profile is held until its owner releases it (account_block:<profile>);
+	// the same model on another path stays available.
+	CauseAccountBlocked FailureCause = "account_blocked"
+	// CauseLocalRuntime is the local agent runtime failing. It is not a
+	// provider condition and suspends nothing.
+	CauseLocalRuntime FailureCause = "local_runtime"
+	// CauseTransient is an unavailable, overloaded or at-capacity notice with
+	// no more specific signature.
+	CauseTransient FailureCause = "transient"
+)
+
+// Provider prefixes of model IDs, which name the path a candidate reaches its
+// model through.
+const (
+	pathOpenCodeZen = "opencode"
+	pathOpenRouter  = "openrouter"
+)
+
+// causeRule maps one classified failure to its cause. Rules are tried in
+// order and the first one whose non-empty fields all match wins, so a
+// signature row precedes the code-only fallback for the same code.
+type causeRule struct {
+	// rule is the routingerr classifier rule ID; empty matches any rule.
+	rule string
+	// code is the normalized code; empty matches any code.
+	code routingerr.Code
+	// path is the provider prefix of the candidate's model ID; empty matches
+	// any path.
+	path  string
+	cause FailureCause
+}
+
+// failureCauseRules is the single cause table. Evidence for each row is the
+// 2026-10-12 failover error catalogue (signature, path, recovery and
+// cross-path behaviour).
+var failureCauseRules = []causeRule{
+	// Account allowances with a stated reset or renewal.
+	{rule: routingerr.RuleOpenCodeCredit, cause: CauseAccountQuota},
+	{rule: routingerr.RuleOpenCodeUsageLimit, cause: CauseAccountQuota},
+	{rule: routingerr.RuleClaudeQuota, cause: CauseAccountQuota},
+	{rule: routingerr.RuleClaudeSessionLimit, cause: CauseAccountQuota},
+	{rule: routingerr.RuleClaudeWeeklyLimit, cause: CauseAccountQuota},
+	{rule: routingerr.RuleCodexQuota, cause: CauseAccountQuota},
+	{rule: routingerr.RuleProviderQuotaNotice, cause: CauseAccountQuota},
+	{rule: routingerr.RuleOpenCodeGoUsageLimit, cause: CauseGoUsageLimit},
+	// Zen recovered after 09:00 KST in 500 of 506 observations. OpenRouter's
+	// AI-SDK notice hides whether its free allowance is per-minute or per-day;
+	// the single withdrawn-model observation does not establish a daily reset.
+	{rule: routingerr.RuleOpenCodeRateTryLater, path: pathOpenCodeZen, cause: CauseFreeDailyLimit},
+	{rule: routingerr.RuleOpenCodeRateTryLater, path: pathOpenRouter, cause: CauseGatewayRateLimit},
+	{rule: routingerr.RuleOpenCodeFreeModelsPerDay, cause: CauseFreeAccountDailyLimit},
+	{rule: routingerr.RuleOpenCodeModelPerDay, cause: CauseFreeDailyLimit},
+	{rule: routingerr.RuleOpenCodeUpstreamHostLimit, cause: CauseUpstreamHostLimit},
+	// An account restricted by its gateway (403 user_blocked) holds that
+	// execution profile until the owner releases it. openCircuitForFailure
+	// applies that hold before this table, so the row only names the cause.
+	{code: routingerr.CodeAccountBlocked, cause: CauseAccountBlocked},
+	{rule: routingerr.RuleOpenCodeModelWithdrawn, cause: CauseModelWithdrawn},
+	{rule: routingerr.RuleOpenCodeGoAccountSetting, cause: CauseAccountSetting},
+	{rule: routingerr.RuleOpenCodeEndpointUnavailable, cause: CauseEndpointIntermittent},
+	{rule: routingerr.RuleProviderHeaderTimeout, cause: CauseModelHost},
+	{rule: routingerr.RuleProviderStreamServerError, cause: CauseModelHost},
+	{rule: routingerr.RuleProviderInternalServerError, cause: CauseModelHost},
+	{rule: routingerr.RuleProviderNvidiaHost, cause: CauseModelHost},
+	{rule: routingerr.RuleOpenCodeServiceFailure, cause: CauseLocalRuntime},
+	// Code defaults.
+	{code: routingerr.CodeRateLimited, cause: CauseUsageLimit},
+	{code: routingerr.CodeQuotaLimited, cause: CauseUsageLimit},
+	{code: routingerr.CodeNetworkUnavailable, cause: CauseNetwork},
+	{code: routingerr.CodeAuthRequired, cause: CauseCredential},
+	{code: routingerr.CodeMissingCredentials, cause: CauseCredential},
+	{code: routingerr.CodeSubscriptionRequired, cause: CauseCredential},
+	{code: routingerr.CodeProviderNotConfigured, cause: CauseCredential},
+	{code: routingerr.CodeModelUnavailable, cause: CauseModelWithdrawn},
+	{code: routingerr.CodeProviderUnavailable, cause: CauseTransient},
+	{code: routingerr.CodeProviderOverloaded, cause: CauseTransient},
+	{code: routingerr.CodeModelCapacity, cause: CauseTransient},
+}
+
+// BlockScope is how far one cause's suspension reaches.
+type BlockScope string
+
+const (
+	// BlockNone suspends nothing.
+	BlockNone BlockScope = "none"
+	// BlockPathModel suspends this model on this path only.
+	BlockPathModel BlockScope = "path_model"
+	// BlockPath suspends the path's credential binding.
+	BlockPath BlockScope = "path"
+	// BlockAccount suspends every model the path's account reaches.
+	BlockAccount BlockScope = "account"
+	// BlockAccountTier suspends every model of the same cost tier (free or
+	// paid) on the path's account.
+	BlockAccountTier BlockScope = "account_tier"
+	// BlockUsageLimit is the metering rule that predates the cause table: the
+	// model for providers that meter models separately, the account otherwise.
+	BlockUsageLimit BlockScope = "usage_limit"
+)
+
+// causePolicy is one cause's scope and duration.
+type causePolicy struct {
+	scope BlockScope
+	// ladder is the block length by consecutive strike; the last step repeats.
+	ladder []time.Duration
+	// usageLimitDuration keeps the ladders, calendar and monthly resets that
+	// predate the cause table.
+	usageLimitDuration bool
+	// holdUntilRenewal blocks until a stated renewal instant still ahead.
+	holdUntilRenewal bool
+	// untilNextUTCDay blocks until the next 00:00 UTC.
+	untilNextUTCDay bool
+	// nextUTCDayAfterStrikes switches to the next 00:00 UTC once strikes pass
+	// this count; zero never switches.
+	nextUTCDayAfterStrikes int
+	// dailyStrikes counts only failures on the current UTC date.
+	dailyStrikes bool
+	// crossPathWindow suspends the model on every path when another path
+	// reported the same cause for the same model within the window.
+	crossPathWindow time.Duration
+	// excludeSameModel keeps the same model on other paths out of the
+	// successor search that this failure starts.
+	excludeSameModel bool
+}
+
+// Durations. A reset hint stated by the provider always comes first.
+var (
+	// transientLadder lengthens repeated unavailable, overloaded and
+	// at-capacity notices instead of retrying every minute.
+	transientLadder = []time.Duration{time.Minute, 5 * time.Minute, 15 * time.Minute, 30 * time.Minute, time.Hour}
+	// endpointLadder: 64% of "Endpoint is unavailable" recovered on the same
+	// path within ten minutes, median twelve.
+	endpointLadder = []time.Duration{time.Minute, 2 * time.Minute, 5 * time.Minute, 10 * time.Minute, 15 * time.Minute}
+	// modelHostLadder: header timeouts and 5xx recovered in 1 to 22 minutes.
+	modelHostLadder = []time.Duration{5 * time.Minute, 15 * time.Minute, 30 * time.Minute}
+	// gatewayRateLadder retries notices whose per-minute/per-day window is hidden.
+	gatewayRateLadder = []time.Duration{5 * time.Minute, 15 * time.Minute, 30 * time.Minute}
+	// upstreamHostLadder: a shared upstream pool that stays limited for more
+	// than about six hours waits for the next daily reset.
+	upstreamHostLadder = []time.Duration{5 * time.Minute, 15 * time.Minute, 30 * time.Minute, time.Hour}
+	// withdrawnLadder: no withdrawn model recovered; it is probed once a day.
+	withdrawnLadder = []time.Duration{24 * time.Hour}
+	// accountSettingLadder: the owner changed the setting 3 to 10 hours later.
+	accountSettingLadder = []time.Duration{6 * time.Hour, 24 * time.Hour}
+	// networkLadder: dropped connections recovered in 1 to 8 minutes.
+	networkLadder = []time.Duration{2 * time.Minute, 5 * time.Minute}
+	// goUsageLadder: the Go notice states no reset; the window is unknown.
+	goUsageLadder = []time.Duration{5 * time.Hour, 24 * time.Hour, 7 * 24 * time.Hour}
+)
+
+// modelHostWindow is how close in time two paths must fail for the model host
+// to be the shared cause.
+const modelHostWindow = 15 * time.Minute
+
+// upstreamHostDailyAfterStrikes is the strike count after which the upstream
+// ladder has spent about six hours (5+15+30 minutes, then hourly).
+const upstreamHostDailyAfterStrikes = 8
+
+var failureCausePolicies = map[FailureCause]causePolicy{
+	CauseAccountQuota:          {scope: BlockAccount, usageLimitDuration: true, holdUntilRenewal: true},
+	CauseGoUsageLimit:          {scope: BlockAccountTier, ladder: goUsageLadder},
+	CauseFreeDailyLimit:        {scope: BlockPathModel, untilNextUTCDay: true},
+	CauseFreeAccountDailyLimit: {scope: BlockAccountTier, untilNextUTCDay: true},
+	CauseUsageLimit:            {scope: BlockUsageLimit, usageLimitDuration: true},
+	CauseUpstreamHostLimit:     {scope: BlockPathModel, ladder: upstreamHostLadder, nextUTCDayAfterStrikes: upstreamHostDailyAfterStrikes},
+	CauseGatewayRateLimit:      {scope: BlockPathModel, ladder: gatewayRateLadder, nextUTCDayAfterStrikes: upstreamHostDailyAfterStrikes, dailyStrikes: true},
+	CauseModelWithdrawn:        {scope: BlockPathModel, ladder: withdrawnLadder},
+	CauseAccountSetting:        {scope: BlockPathModel, ladder: accountSettingLadder},
+	CauseEndpointIntermittent:  {scope: BlockPathModel, ladder: endpointLadder},
+	CauseModelHost:             {scope: BlockPathModel, ladder: modelHostLadder, crossPathWindow: modelHostWindow, excludeSameModel: true},
+	CauseNetwork:               {scope: BlockPathModel, ladder: networkLadder},
+	CauseCredential:            {scope: BlockPath, ladder: []time.Duration{circuitBackoff}},
+	CauseLocalRuntime:          {scope: BlockNone},
+	// The owner-release hold is applied before the table (see
+	// openCircuitForFailure); nothing else is suspended.
+	CauseAccountBlocked: {scope: BlockNone},
+	// An unrecognized unavailable notice may be the path or the host, so the
+	// successor search keeps the same model out as it did before the table.
+	CauseTransient: {scope: BlockPathModel, ladder: transientLadder, excludeSameModel: true},
+}
+
+// FailureCauseFor returns the cause of a classified failure on a candidate.
+func FailureCauseFor(candidate Candidate, failure *routingerr.Error) FailureCause {
+	if failure == nil {
+		return ""
+	}
+	path := ProviderOf(candidate.ModelID)
+	for _, row := range failureCauseRules {
+		if row.rule != "" && row.rule != failure.ClassifierRule {
+			continue
+		}
+		if row.code != "" && row.code != failure.Code {
+			continue
+		}
+		if row.path != "" && row.path != path {
+			continue
+		}
+		return row.cause
+	}
+	return CauseTransient
+}
+
+func policyForFailure(candidate Candidate, failure *routingerr.Error) causePolicy {
+	return failureCausePolicies[FailureCauseFor(candidate, failure)]
+}
+
+// pathModelKey is this model on this path. A model-scoped candidate already
+// carries it; any other candidate derives it from its binding.
+func (c Candidate) pathModelKey() string {
+	if c.ModelKey != "" {
+		return c.ModelKey
+	}
+	if c.ModelID == "" || c.BindingKey == "" {
+		return c.BindingKey
+	}
+	return ResourceKey(ScopeModel, c.BindingKey+modelKeySeparator+c.ModelID)
+}
+
+// accountKey is every model the candidate's account reaches through its path.
+// Without a resolved account the binding is the narrowest safe answer.
+func (c Candidate) accountKey() string {
+	if c.AccountKey != "" {
+		return c.AccountKey
+	}
+	return c.BindingKey
+}
+
+// accountTierKey is every model of this candidate's cost tier on its account.
+func (c Candidate) accountTierKey() string {
+	if c.AccountKey == "" {
+		return ""
+	}
+	tier := "paid"
+	if freeCandidate(c) {
+		tier = "free"
+	}
+	return c.AccountKey + modelKeySeparator + tier
+}
+
+// modelIdentityKey is this model on every path.
+func (c Candidate) modelIdentityKey() string {
+	identity := ModelIdentity(c.ModelID)
+	if identity == "" {
+		return ""
+	}
+	return ResourceKey(ScopeModel, anyBindingMarker+modelKeySeparator+identity)
+}
+
+// pathIdentity names the path a candidate reaches its model through, so two
+// profiles of one model on one path are not counted as two paths.
+func (c Candidate) pathIdentity() string {
+	if c.AccountKey != "" {
+		return c.AccountKey
+	}
+	return c.BindingKey
+}
+
+const (
+	modelKeySeparator = "|"
+	// anyBindingMarker stands for "every binding" in a model identity key, in
+	// the place a path's binding takes in a path-model key.
+	anyBindingMarker = "*"
+)
+
+// modelIdentityAliases folds a model's names on different gateways into one
+// identity where the plain normalization cannot see they are the same model.
+var modelIdentityAliases = map[string]string{
+	"nemotron-3-ultra-550b-a55b": "nemotron-3-ultra",
+}
+
+// ModelIdentity normalizes a model ID to the model a host serves, independent
+// of the gateway path: "opencode-go/space-bunny-free", "opencode/space-bunny"
+// and "openrouter/x/space-bunny:free" are one model. An unknown model has no
+// identity.
+func ModelIdentity(model string) string {
+	model = strings.ToLower(strings.TrimSpace(model))
+	if unknownInterruptionModel(model) {
+		return ""
+	}
+	if index := strings.LastIndex(model, "/"); index >= 0 {
+		model = model[index+1:]
+	}
+	model = strings.TrimSuffix(model, ":free")
+	model = strings.TrimSuffix(model, "-free")
+	if unknownInterruptionModel(model) {
+		return ""
+	}
+	if alias, ok := modelIdentityAliases[model]; ok {
+		return alias
+	}
+	return model
+}
+
+// failureTargets lists the circuits one failure opens.
+func failureTargets(candidate Candidate, failure *routingerr.Error, policy causePolicy) []string {
+	var key string
+	switch policy.scope {
+	case BlockNone:
+		return nil
+	case BlockUsageLimit:
+		key = suspensionTarget(candidate, failure.Code)
+	case BlockPath:
+		key = candidate.BindingKey
+	case BlockAccount:
+		key = candidate.accountKey()
+	case BlockAccountTier:
+		key = candidate.accountTierKey()
+		if key == "" {
+			key = candidate.pathModelKey()
+		}
+	default:
+		key = candidate.pathModelKey()
+	}
+	if key == "" {
+		return nil
+	}
+	return []string{key}
+}
+
+// causeSuspensionUntil sizes one suspension of a cause. A reset instant the
+// provider stated wins, then a stated renewal still ahead, then the cause's own
+// rule.
+func (e *Engine) causeSuspensionUntil(
+	ctx context.Context,
+	candidate Candidate,
+	failure *routingerr.Error,
+	policy causePolicy,
+	strikes int,
+	now time.Time,
+) time.Time {
+	floor := now.Add(circuitBackoff)
+	if failure.ResetHint != nil && failure.ResetHint.After(floor) {
+		return *failure.ResetHint
+	}
+	if policy.holdUntilRenewal && failure.RenewalAt != nil && failure.RenewalAt.After(floor) {
+		return *failure.RenewalAt
+	}
+	if policy.usageLimitDuration {
+		return e.suspensionUntil(ctx, candidate, failure, strikes, now)
+	}
+	if policy.untilNextUTCDay ||
+		(policy.nextUTCDayAfterStrikes > 0 && strikes > policy.nextUTCDayAfterStrikes) {
+		return laterOf(nextUTCDay(now), floor)
+	}
+	if len(policy.ladder) == 0 {
+		return floor
+	}
+	return now.Add(ladderStep(policy.ladder, strikes))
+}
+
+// nextUTCDay is the next 00:00 UTC, when daily allowances reset.
+func nextUTCDay(now time.Time) time.Time {
+	utc := now.UTC()
+	return time.Date(utc.Year(), utc.Month(), utc.Day()+1, 0, 0, 0, 0, time.UTC)
+}
+
+func laterOf(a, b time.Time) time.Time {
+	if a.After(b) {
+		return a
+	}
+	return b
+}
+
+// openCircuit opens one key for a failure without ever shortening a block that
+// is already running.
+func (e *Engine) openCircuit(
+	ctx context.Context,
+	key string,
+	candidate Candidate,
+	failure *routingerr.Error,
+	policy causePolicy,
+	now time.Time,
+) {
+	strikes := e.circuits.NextStrike(key)
+	if policy.dailyStrikes {
+		strikes = e.circuits.NextDailyStrike(key)
+	}
+	until := e.causeSuspensionUntil(ctx, candidate, failure, policy, strikes, now)
+	if running := e.circuits.Inspect(key, now); running.State == ResourceWaiting && running.Until.After(until) {
+		until = running.Until
+	}
+	if policy.dailyStrikes {
+		e.circuits.OpenDaily(key, until, failure.Code)
+	} else {
+		e.circuits.Open(key, until, failure.Code)
+	}
+}
+
+// noteCrossPathFailure records a model-host failure of one path and reports
+// whether another path of the same model failed within the window.
+func (e *Engine) noteCrossPathFailure(candidate Candidate, window time.Duration, now time.Time) bool {
+	identity := ModelIdentity(candidate.ModelID)
+	path := candidate.pathIdentity()
+	if identity == "" || path == "" {
+		return false
+	}
+	e.hostMu.Lock()
+	defer e.hostMu.Unlock()
+	if e.hostFailures == nil {
+		e.hostFailures = make(map[string]map[string]time.Time)
+	}
+	paths := e.hostFailures[identity]
+	if paths == nil {
+		paths = make(map[string]time.Time)
+		e.hostFailures[identity] = paths
+	}
+	shared := false
+	for other, at := range paths {
+		if now.Sub(at) > window {
+			delete(paths, other)
+			continue
+		}
+		if other != path {
+			shared = true
+		}
+	}
+	paths[path] = now
+	return shared
+}
+
+// sameModelCandidateIDs lists the other candidates of the profile that run the
+// failed candidate's model on another path.
+func sameModelCandidateIDs(profile Profile, failedCandidateID string) []string {
+	failed, ok := candidateByID(profile, failedCandidateID)
+	if !ok {
+		return nil
+	}
+	identity := ModelIdentity(failed.ModelID)
+	if identity == "" {
+		return nil
+	}
+	var ids []string
+	for _, candidate := range profile.Candidates {
+		if candidate.ID != failedCandidateID && ModelIdentity(candidate.ModelID) == identity {
+			ids = append(ids, candidate.ID)
+		}
+	}
+	return ids
+}
+
+// failureExclusions is the failed candidate plus, when the cause can reach the
+// model on every path, the same model's other paths.
+func failureExclusions(profile Profile, failedCandidateID string, failure *routingerr.Error) []string {
+	excluded := []string{failedCandidateID}
+	failed, ok := candidateByID(profile, failedCandidateID)
+	if !ok || failure == nil || !policyForFailure(failed, failure).excludeSameModel {
+		return excluded
+	}
+	return append(excluded, sameModelCandidateIDs(profile, failedCandidateID)...)
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/midturn_failure.go b/apps/backend/internal/agent/runtime/dynamic/midturn_failure.go
new file mode 100644
index 0000000000..2c010938a5
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/midturn_failure.go
@@ -0,0 +1,141 @@
+package dynamic
+
+import (
+	"context"
+
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+	"github.com/kandev/kandev/internal/agent/runtime/routingpolicy"
+)
+
+// InterruptedFailureAllowed is the task interruption exception, separate from
+// pre-result retry policy and from account errors requiring user action.
+func InterruptedFailureAllowed(failure *routingerr.Error) bool {
+	if failure == nil || !failure.FallbackAllowed || failure.UserAction {
+		return false
+	}
+	switch failure.Code {
+	case routingerr.CodeQuotaLimited, routingerr.CodeRateLimited, routingerr.CodeProviderUnavailable,
+		routingerr.CodeProviderOverloaded, routingerr.CodeModelCapacity:
+		return true
+	default:
+		return false
+	}
+}
+
+// ApplyInterruptedFailureContext advances an owned route without replaying its
+// model. The status claim fences resource penalties as well as successor claims.
+func (e *Engine) ApplyInterruptedFailureContext(ctx context.Context, sessionID string, profile Profile, generation int64, candidateID string, failure *routingerr.Error) (RouteDecision, error) {
+	if !InterruptedFailureAllowed(failure) {
+		return RouteDecision{}, ErrNoEligibleCandidate
+	}
+	inputs := e.rankInputs(ctx, profile)
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	state, err := e.currentUnclassifiedRouteState(ctx, sessionID, profile, generation, candidateID)
+	if err != nil {
+		return RouteDecision{}, err
+	}
+	if state.Status != routeStatusActive && state.Status != routeStatusStarting {
+		return RouteDecision{}, ErrStaleGeneration
+	}
+	chain, err := decodeSelectionChain(state.PolicyStateJSON)
+	if err != nil {
+		return RouteDecision{}, err
+	}
+	chain = excludeInterruptedModel(chain.forProfile(profile.ID, generation), profile, candidateID, failure)
+	chain.Interrupted = true
+	oldStatus, oldPolicy := state.Status, state.PolicyStateJSON
+	state.Status = routeStatusRetrying
+	state.PolicyStateJSON, err = carrySelectionChain("", chain)
+	if err != nil {
+		return RouteDecision{}, err
+	}
+	if err := e.persistSnapshot(ctx, oldStatus, oldPolicy, state); err != nil {
+		return RouteDecision{}, err
+	}
+	e.states[sessionID] = state
+	e.RecordResourceFailure(ctx, profile, candidateID, failure)
+	e.observeLimit(ctx, candidateID, failure)
+	key := probeKey(sessionID, generation, candidateID)
+	leases := e.probes[key]
+	delete(e.probes, key)
+	for _, lease := range leases {
+		e.circuits.ReleaseProbe(lease, false, circuitBackoff)
+	}
+	return e.selectInterruptedSuccessor(ctx, state, profile, candidateID, failure, chain, inputs)
+}
+
+func (e *Engine) selectInterruptedSuccessor(ctx context.Context, state RouteState, profile Profile, candidateID string, failure *routingerr.Error, chain SelectionChain, inputs RankOptions) (RouteDecision, error) {
+	now := e.now()
+	generation := state.Generation + 1
+	// The search reads circuit health without claiming anything; only the
+	// winner claims its probe below, so expired candidates the search passes
+	// over stay available to other sessions and to this claim.
+	ineligible := make(map[string]string)
+	for _, candidate := range profile.Candidates {
+		if e.candidateBlockedNow(candidate, now) {
+			ineligible[candidate.ID] = IneligibleCircuit
+		}
+	}
+	plan := ResolveFallbackSelection(profile, candidateID, "", chain, ineligible)
+	winner := plan.firstSelectable(inputs.at(now), func(candidate Candidate) bool {
+		return e.claimProbe(candidate, state.SessionID, generation, now)
+	})
+	policy := PolicyState{SelectionChain: &chain, FailureCode: failure.Code,
+		FailureClass: routingerr.ClassForCode(failure.Code), CatalogueVersion: routingerr.CatalogueVersion,
+		PendingOutcome: routingpolicy.OutcomeSkip}
+	if !winner.ok {
+		return e.persistInterruptedExhaustion(ctx, state, policy, failure)
+	}
+	chain = chain.withTried(winner.candidate.ID)
+	chain.LastTierHeadID = winner.tier.HeadID
+	policy.SelectionChain = &chain
+	decision := RouteDecision{SessionID: state.SessionID, LogicalProfileID: profile.ID,
+		ExecutionProfileID: winner.candidate.ID, Generation: generation, ProfileVersion: profile.Version,
+		Status: routeStatusStarting, Reason: selectionReason(winner.candidate, winner.tier, plan, "interrupted_try_next"),
+		ErrorCode: failure.Code, ErrorClass: policy.FailureClass, CatalogueVersion: routingerr.CatalogueVersion,
+		PendingOutcome: routingpolicy.OutcomeSkip}
+	next := RouteState{SessionID: state.SessionID, LogicalProfileID: profile.ID,
+		ExecutionProfileID: winner.candidate.ID, Generation: generation, ProfileVersion: profile.Version,
+		Status: routeStatusStarting, PolicyStateJSON: string(mustJSON(policy)), UpdatedAt: now}
+	if err := e.claimAndPersist(ctx, state.Generation, decision, next); err != nil {
+		delete(e.states, state.SessionID)
+		return RouteDecision{}, err
+	}
+	e.states[state.SessionID] = next
+	e.notePickLocked(profile.ID, winner.candidate.ID, now)
+	return decision, nil
+}
+
+func (e *Engine) persistInterruptedExhaustion(ctx context.Context, state RouteState, policy PolicyState, failure *routingerr.Error) (RouteDecision, error) {
+	oldStatus, oldPolicy := state.Status, state.PolicyStateJSON
+	policy.PendingOutcome = routingpolicy.OutcomeStop
+	state.Status = routeStatusActionRequired
+	state.PolicyStateJSON = string(mustJSON(policy))
+	state.UpdatedAt = e.now()
+	if err := e.persistSnapshot(ctx, oldStatus, oldPolicy, state); err != nil {
+		return RouteDecision{}, err
+	}
+	e.states[state.SessionID] = state
+	return RouteDecision{SessionID: state.SessionID, LogicalProfileID: state.LogicalProfileID,
+		ExecutionProfileID: state.ExecutionProfileID, Generation: state.Generation, ProfileVersion: state.ProfileVersion,
+		Status: state.Status, Reason: "interrupted_candidates_exhausted", ErrorCode: failure.Code,
+		ErrorClass: policy.FailureClass, CatalogueVersion: routingerr.CatalogueVersion,
+		PendingOutcome: routingpolicy.OutcomeStop}, ErrRecoveryPending
+}
+
+// excludeInterruptedModel spends the failed candidate in this chain and, when
+// the failure's cause can reach the model on every path, the same model's
+// other paths too. A cause bound to one path (a daily allowance, an
+// intermittent endpoint, a withdrawn model) leaves the model's other paths in
+// the search: they fail or succeed on their own.
+func excludeInterruptedModel(chain SelectionChain, profile Profile, candidateID string, failure *routingerr.Error) SelectionChain {
+	for _, id := range failureExclusions(profile, candidateID, failure) {
+		chain = chain.withTried(id)
+	}
+	return chain
+}
+
+func unknownInterruptionModel(model string) bool {
+	return model == "" || model == "default" || model == "unknown"
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/provider_limit.go b/apps/backend/internal/agent/runtime/dynamic/provider_limit.go
new file mode 100644
index 0000000000..fe9cc5260d
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/provider_limit.go
@@ -0,0 +1,71 @@
+package dynamic
+
+import (
+	"strings"
+	"time"
+)
+
+// ProviderLimit is the operator-entered limit setting of one provider, keyed by
+// the provider prefix of its model IDs.
+type ProviderLimit struct {
+	Provider string
+	// MonthlyResetAt is any one occurrence of the provider's monthly reset. The
+	// reset repeats on the same day of month and clock time in
+	// MonthlyResetTimezone, clamped to the last day of shorter months.
+	MonthlyResetAt       *time.Time
+	MonthlyResetTimezone string
+	// BlockUntil pauses every paid model of the provider until that instant.
+	BlockUntil *time.Time
+	UpdatedAt  time.Time
+}
+
+// NormalizeProvider returns the stored form of a provider key.
+func NormalizeProvider(provider string) string {
+	return strings.ToLower(strings.TrimSpace(strings.TrimSuffix(strings.TrimSpace(provider), "/")))
+}
+
+// NextMonthlyReset returns the first monthly reset strictly after now.
+func (l ProviderLimit) NextMonthlyReset(now time.Time) (time.Time, bool) {
+	if l.MonthlyResetAt == nil || l.MonthlyResetAt.IsZero() {
+		return time.Time{}, false
+	}
+	location := time.UTC
+	if l.MonthlyResetTimezone != "" {
+		if loaded, err := time.LoadLocation(l.MonthlyResetTimezone); err == nil {
+			location = loaded
+		}
+	}
+	anchor := l.MonthlyResetAt.In(location)
+	local := now.In(location)
+	offset := (local.Year()-anchor.Year())*12 + int(local.Month()-anchor.Month())
+	next := monthlyOccurrence(anchor, offset)
+	if !next.After(now) {
+		next = monthlyOccurrence(anchor, offset+1)
+	}
+	return next, true
+}
+
+// BlockedUntil returns the operator block covering a model of this provider.
+// Free models keep their own limits and are never covered.
+func (l ProviderLimit) BlockedUntil(modelID string, now time.Time) (time.Time, bool) {
+	return l.BlockedUntilCandidate(Candidate{ModelID: modelID}, now)
+}
+
+// BlockedUntilCandidate returns the operator block covering one candidate. A
+// free candidate keeps its own limits and is never covered, so a block an
+// operator entered for a provider's paid models never pauses a free model of the
+// same provider.
+func (l ProviderLimit) BlockedUntilCandidate(candidate Candidate, now time.Time) (time.Time, bool) {
+	if l.BlockUntil == nil || !l.BlockUntil.After(now) || freeCandidate(candidate) {
+		return time.Time{}, false
+	}
+	return *l.BlockUntil, true
+}
+
+func monthlyOccurrence(anchor time.Time, monthOffset int) time.Time {
+	firstOfMonth := time.Date(anchor.Year(), anchor.Month()+time.Month(monthOffset), 1, 0, 0, 0, 0, anchor.Location())
+	lastDay := firstOfMonth.AddDate(0, 1, -1).Day()
+	day := min(anchor.Day(), lastDay)
+	return time.Date(firstOfMonth.Year(), firstOfMonth.Month(), day,
+		anchor.Hour(), anchor.Minute(), anchor.Second(), 0, anchor.Location())
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/suspension.go b/apps/backend/internal/agent/runtime/dynamic/suspension.go
new file mode 100644
index 0000000000..dbb42bfe9f
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/suspension.go
@@ -0,0 +1,156 @@
+package dynamic
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+)
+
+// IneligibleProbing marks a candidate whose expired suspension is being probed
+// by another selection right now.
+const IneligibleProbing = "circuit_probing"
+
+// RecordResourceFailure suspends the failed candidate's resource without
+// changing the route. It covers a failure that is not routed to a successor,
+// such as a usage limit reported after the attempt already produced output, so
+// the next selection still avoids the exhausted resource.
+func (e *Engine) RecordResourceFailure(ctx context.Context, profile Profile, candidateID string, failure *routingerr.Error) {
+	if e == nil {
+		return
+	}
+	e.openCircuitForFailure(ctx, profile, candidateID, failure)
+}
+
+// RecordResourceSuccess clears the suspension history of a candidate whose
+// turn completed without a provider error. Every key that gates the candidate
+// is cleared, so the model's identity, its path and its account all start
+// their ladders again from the first step.
+func (e *Engine) RecordResourceSuccess(candidate Candidate) {
+	if e == nil || e.circuits == nil {
+		return
+	}
+	for _, key := range candidate.resourceKeys() {
+		e.circuits.RecordSuccess(key)
+	}
+}
+
+// CandidateSuspension is the read-only resource health of one candidate.
+type CandidateSuspension struct {
+	State  ResourceState
+	Until  time.Time
+	Scope  SuspensionScope
+	Source SuspensionSource
+	Code   routingerr.Code
+}
+
+// Blocked reports whether the candidate cannot be selected now.
+func (s CandidateSuspension) Blocked() bool {
+	return s.State == ResourceWaiting || s.State == ResourceProbing
+}
+
+// SuspensionFor reports a candidate's resource health without claiming
+// anything. A running block outranks a held probe, which outranks an expired
+// block; among equal states the later end wins.
+func (e *Engine) SuspensionFor(candidate Candidate, now time.Time) CandidateSuspension {
+	result := CandidateSuspension{State: ResourceAvailable}
+	if candidate.SuspendedUntil.After(now) {
+		result = CandidateSuspension{
+			State: ResourceWaiting, Until: candidate.SuspendedUntil,
+			Scope: SuspensionScopeProvider, Source: SuspensionSourceManual,
+		}
+	}
+	if e == nil || e.circuits == nil {
+		return result
+	}
+	for _, key := range candidate.resourceKeys() {
+		status := e.circuits.Inspect(key, now)
+		if status.State == ResourceAvailable {
+			continue
+		}
+		scope := SuspensionScopeCredential
+		switch key {
+		case candidate.ModelKey, candidate.pathModelKey(), candidate.modelIdentityKey():
+			scope = SuspensionScopeModel
+		case candidate.accountBlockKey():
+			scope = SuspensionScopeProfile
+		}
+		next := CandidateSuspension{
+			State: status.State, Until: status.Until, Scope: scope,
+			Source: SuspensionSourceFailure, Code: status.Code,
+		}
+		if suspensionRank(next.State) > suspensionRank(result.State) ||
+			(next.State == result.State && next.Until.After(result.Until)) {
+			result = next
+		}
+	}
+	return result
+}
+
+func suspensionRank(state ResourceState) int {
+	switch state {
+	case ResourceWaiting:
+		return 3
+	case ResourceProbing:
+		return 2
+	case ResourceExpired:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// SetResourceWaitObserver registers the callback told about a selection that
+// waits for suspended resources.
+func (e *Engine) SetResourceWaitObserver(observer func(sessionID string, generation int64, deadline time.Time)) {
+	if e == nil {
+		return
+	}
+	e.mu.Lock()
+	e.resourceWait = observer
+	e.mu.Unlock()
+}
+
+// resourceWaitDeadline returns the earliest instant a suspended candidate can
+// be tried again, only when every enabled candidate is suspended. A candidate
+// excluded for another reason, such as an unclassified failure earlier in the
+// chain, keeps the wait manual because time alone does not make it usable.
+func (e *Engine) resourceWaitDeadline(profile Profile, now time.Time) (time.Time, bool) {
+	var deadline time.Time
+	enabled := 0
+	for _, candidate := range profile.Candidates {
+		if !candidate.Enabled {
+			continue
+		}
+		enabled++
+		suspension := e.SuspensionFor(candidate, now)
+		if !suspension.Blocked() || suspension.Until.IsZero() {
+			return time.Time{}, false
+		}
+		if deadline.IsZero() || suspension.Until.Before(deadline) {
+			deadline = suspension.Until
+		}
+	}
+	return deadline, enabled > 0
+}
+
+// withResourceWait marks an exhausted waiting state with the instant its
+// suspended candidates can be tried again.
+func withResourceWait(policyStateJSON string, deadline time.Time) (string, error) {
+	state := PolicyState{}
+	if policyStateJSON != "" {
+		if err := json.Unmarshal([]byte(policyStateJSON), &state); err != nil {
+			return "", fmt.Errorf("decode dynamic policy state: %w", err)
+		}
+	}
+	deadline = deadline.UTC()
+	state.Deadline = &deadline
+	state.ResourceWait = true
+	encoded, err := json.Marshal(state)
+	if err != nil {
+		return "", fmt.Errorf("encode dynamic policy state: %w", err)
+	}
+	return string(encoded), nil
+}
