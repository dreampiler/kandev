+	done, err := deps.svc.GetOverviewWorkspaceTasks(ctx, "ws-office", dashboard.OverviewFilterCompleted, 0)
+	if err != nil || done.Total != 1 || done.Tasks[0].TaskID != "t-done" {
+		t.Fatalf("completed list = %+v err = %v", done, err)
