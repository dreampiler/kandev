+	if _, err := deps.svc.GetOverviewWorkspaceTasks(ctx, "ws-office", "bogus", 0); !errors.Is(err, dashboard.ErrOverviewBadRequest) {
+		t.Fatalf("bad filter err = %v, want bad request", err)
