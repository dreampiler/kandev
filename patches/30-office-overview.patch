diff --git a/apps/backend/internal/persistence/server_starts.go b/apps/backend/internal/persistence/server_starts.go
new file mode 100644
index 00000000000..55bae5f65eb
--- /dev/null
+++ b/apps/backend/internal/persistence/server_starts.go
@@ -0,0 +1,107 @@
+package persistence
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+)
+
+// serverStartsKey is the kandev_meta key holding the install-wide history of
+// backend boot instants. It is one bounded JSON array rather than a table: the
+// list exists only to make the Office overview's startup count durable across a
+// process replacement, and it stays small enough (one entry per boot) that the
+// overview's fixed 24-hour window needs no indexed query.
+const serverStartsKey = "server_started_events"
+
+// serverStartsRetention and serverStartsMaxEntries bound that list. Boots are
+// rare (a handful a day at most), so both limits are far above realistic use and
+// exist only so the value can never grow without bound.
+const (
+	serverStartsRetention  = 31 * 24 * time.Hour
+	serverStartsMaxEntries = 200
+)
+
+// ServerStart is one recorded backend boot: the instant the server became
+// startable and the binary version that booted. The instant is UTC.
+type ServerStart struct {
+	At      time.Time `json:"at"`
+	Version string    `json:"version"`
+}
+
+// RecordServerStarted appends this boot's instant to the durable startup
+// history. It is called once per boot, after the predecessor process has exited
+// and while ownership is held, so the read-modify-write cannot race another
+// writer. Old entries are pruned by age and count on every write.
+func RecordServerStarted(db *sqlx.DB, at time.Time, version string) error {
+	entries, err := readServerStarts(db)
+	if err != nil {
+		return err
+	}
+	entries = append(entries, ServerStart{At: at.UTC(), Version: version})
+	entries = pruneServerStarts(entries, at.UTC())
+	encoded, err := json.Marshal(entries)
+	if err != nil {
+		return fmt.Errorf("encode server starts: %w", err)
+	}
+	return writeKey(db, serverStartsKey, string(encoded))
+}
+
+// ReadServerStartsSince returns the recorded boots whose instant is at or after
+// since, newest first. An absent or unreadable value yields no entries rather
+// than an error: the list is a display history, and a corrupt value must not
+// take the whole overview down.
+func ReadServerStartsSince(db *sqlx.DB, since time.Time) ([]ServerStart, error) {
+	entries, err := readServerStarts(db)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]ServerStart, 0, len(entries))
+	for _, entry := range entries {
+		if entry.At.Before(since) {
+			continue
+		}
+		out = append(out, entry)
+	}
+	sort.SliceStable(out, func(i, j int) bool { return out[i].At.After(out[j].At) })
+	return out, nil
+}
+
+// readServerStarts decodes the stored array. A malformed value is treated as no
+// history, matching the read's tolerant contract.
+func readServerStarts(db *sqlx.DB) ([]ServerStart, error) {
+	raw, err := readKey(db, serverStartsKey)
+	if err != nil {
+		return nil, err
+	}
+	if raw == "" {
+		return nil, nil
+	}
+	var entries []ServerStart
+	if err := json.Unmarshal([]byte(raw), &entries); err != nil {
+		return nil, nil
+	}
+	return entries, nil
+}
+
+// pruneServerStarts drops entries older than the retention window and keeps
+// only the newest serverStartsMaxEntries. It sorts by instant first so the
+// retention and the cap hold even if a skewed clock wrote an entry out of
+// order.
+func pruneServerStarts(entries []ServerStart, now time.Time) []ServerStart {
+	sort.SliceStable(entries, func(i, j int) bool { return entries[i].At.Before(entries[j].At) })
+	cutoff := now.Add(-serverStartsRetention)
+	out := make([]ServerStart, 0, len(entries))
+	for _, entry := range entries {
+		if entry.At.Before(cutoff) {
+			continue
+		}
+		out = append(out, entry)
+	}
+	if len(out) > serverStartsMaxEntries {
+		out = out[len(out)-serverStartsMaxEntries:]
+	}
+	return out
+}
diff --git a/apps/backend/internal/persistence/server_starts_test.go b/apps/backend/internal/persistence/server_starts_test.go
new file mode 100644
index 00000000000..9006cfd690d
--- /dev/null
+++ b/apps/backend/internal/persistence/server_starts_test.go
@@ -0,0 +1,101 @@
+package persistence
+
+import (
+	"testing"
+	"time"
+)
+
+// TestRecordServerStarted_AccumulatesAcrossBoots proves the startup history is
+// durable: two recorded boots both survive, newest first, so a backend
+// replacement cannot reset the count to the running process alone.
+func TestRecordServerStarted_AccumulatesAcrossBoots(t *testing.T) {
+	db := memSQLiteDB(t)
+	if err := ensureMetaTable(db); err != nil {
+		t.Fatalf("ensureMetaTable: %v", err)
+	}
+	now := time.Date(2026, 10, 12, 12, 0, 0, 0, time.UTC)
+	if err := RecordServerStarted(db, now.Add(-3*time.Hour), "v0.97.0-524-g7fd7cc4bae"); err != nil {
+		t.Fatalf("record first boot: %v", err)
+	}
+	if err := RecordServerStarted(db, now, "v0.97.0-534-g3640339d52"); err != nil {
+		t.Fatalf("record second boot: %v", err)
+	}
+
+	got, err := ReadServerStartsSince(db, now.Add(-24*time.Hour))
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if len(got) != 2 {
+		t.Fatalf("boots in window = %d, want 2", len(got))
+	}
+	if !got[0].At.Equal(now) || got[0].Version != "v0.97.0-534-g3640339d52" {
+		t.Fatalf("first row = %+v, want the newest boot", got[0])
+	}
+	if !got[1].At.Equal(now.Add(-3 * time.Hour)) {
+		t.Fatalf("second row = %+v, want the older boot", got[1])
+	}
+}
+
+// TestReadServerStartsSince_FiltersWindow verifies the window is applied on
+// read: a boot before `since` is excluded and one after is kept.
+func TestReadServerStartsSince_FiltersWindow(t *testing.T) {
+	db := memSQLiteDB(t)
+	if err := ensureMetaTable(db); err != nil {
+		t.Fatalf("ensureMetaTable: %v", err)
+	}
+	now := time.Date(2026, 10, 12, 12, 0, 0, 0, time.UTC)
+	if err := RecordServerStarted(db, now.Add(-48*time.Hour), "old"); err != nil {
+		t.Fatalf("record old: %v", err)
+	}
+	if err := RecordServerStarted(db, now.Add(-time.Hour), "recent"); err != nil {
+		t.Fatalf("record recent: %v", err)
+	}
+
+	got, err := ReadServerStartsSince(db, now.Add(-24*time.Hour))
+	if err != nil {
+		t.Fatalf("read: %v", err)
+	}
+	if len(got) != 1 || got[0].Version != "recent" {
+		t.Fatalf("windowed read = %+v, want only the recent boot", got)
+	}
+}
+
+// TestReadServerStartsSince_ToleratesMalformedValue verifies a corrupt stored
+// value degrades to no history rather than failing the overview.
+func TestReadServerStartsSince_ToleratesMalformedValue(t *testing.T) {
+	db := memSQLiteDB(t)
+	if err := ensureMetaTable(db); err != nil {
+		t.Fatalf("ensureMetaTable: %v", err)
+	}
+	if err := writeKey(db, serverStartsKey, "{not json"); err != nil {
+		t.Fatalf("write malformed: %v", err)
+	}
+
+	got, err := ReadServerStartsSince(db, time.Now().UTC().Add(-24*time.Hour))
+	if err != nil {
+		t.Fatalf("read malformed: %v", err)
+	}
+	if len(got) != 0 {
+		t.Fatalf("malformed value = %+v, want no history", got)
+	}
+}
+
+// TestPruneServerStarts_DropsOldAndCaps verifies the write-time bound: entries
+// older than the retention are dropped and only the newest max entries remain.
+func TestPruneServerStarts_DropsOldAndCaps(t *testing.T) {
+	now := time.Date(2026, 10, 12, 12, 0, 0, 0, time.UTC)
+	entries := []ServerStart{{At: now.Add(-serverStartsRetention - time.Hour), Version: "too-old"}}
+	for i := 0; i < serverStartsMaxEntries+5; i++ {
+		entries = append(entries, ServerStart{At: now.Add(-time.Duration(i) * time.Minute), Version: "recent"})
+	}
+
+	got := pruneServerStarts(entries, now)
+	if len(got) != serverStartsMaxEntries {
+		t.Fatalf("pruned length = %d, want %d", len(got), serverStartsMaxEntries)
+	}
+	for _, entry := range got {
+		if entry.Version == "too-old" {
+			t.Fatal("an entry older than the retention must be pruned")
+		}
+	}
+}
