+package dataretention
+
+// Operation kinds and lifecycle states. These are persisted in the settings
+// record, so the string values are a compatibility surface.
+const (
+	kindAnalysis = "analysis"
+	kindCleanup  = "cleanup"
+	choiceBackup = "backup"
+	choiceSkip   = "skip"
+
+	stateNone      = "none"
+	statePending   = "pending"
+	stateRunning   = "running"
+	stateReady     = "ready"
+	stateFailed    = "failed"
+	stateSucceeded = "succeeded"
+	statePartial   = "partial"
+	stateCancelled = "cancelled"
+)
diff --git a/apps/backend/internal/system/dataretention/store.go b/apps/backend/internal/system/dataretention/store.go
new file mode 100644
index 00000000000..faeeadde80d
--- /dev/null
+++ b/apps/backend/internal/system/dataretention/store.go
@@ -0,0 +1,114 @@
+package dataretention
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+
+	"github.com/jmoiron/sqlx"
+)
+
+const settingsKey = "archived_data_retention"
+
+func readRecord(ctx context.Context, q sqlx.QueryerContext) (record, error) {
+	var raw string
+	err := sqlx.GetContext(ctx, q, &raw, `SELECT value FROM settings WHERE key=?`, settingsKey)
+	if errors.Is(err, sql.ErrNoRows) {
+		return defaultRecord(), nil
+	}
+	if err != nil {
+		return record{}, err
+	}
+	var r record
+	if json.Unmarshal([]byte(raw), &r) != nil || r.Version != 1 || r.Policy.Revision < 0 {
+		return record{}, errors.New("invalid_stored_policy")
+	}
+	if r.Policy.ArchivedAge.Validate() != nil || r.Policy.CleanupAge.Validate() != nil {
+		return record{}, errors.New("invalid_stored_policy")
+	}
+	if err := validateRecord(r); err != nil {
+		return record{}, err
+	}
+	r.Supported = true
+	return r, nil
+}
+
+func validateRecord(r record) error {
+	if err := validatePreparation(r); err != nil {
+		return err
+	}
+	return validateOperation(r.Operation)
+}
+
+func validatePreparation(r record) error {
+	switch r.Preparation.State {
+	case stateNone, statePending, stateRunning, stateFailed, stateReady:
+	default:
+		return errors.New("invalid_preparation")
+	}
+	if r.Preparation.State != stateNone && r.Preparation.Choice != choiceBackup && r.Preparation.Choice != choiceSkip {
+		return errors.New("invalid_preparation")
+	}
+	if r.Policy.Enabled && r.ApprovedRevision != r.Policy.Revision {
+		return errors.New("invalid_preparation")
+	}
+	return nil
+}
+
+func validateOperation(op *Operation) error {
+	if op == nil {
+		return nil
+	}
+	if op.ID == "" {
+		return errors.New("invalid_operation")
+	}
+	switch op.Kind {
+	case kindAnalysis, kindCleanup, choiceBackup:
+	default:
+		return errors.New("invalid_operation")
+	}
+	switch op.State {
+	case stateRunning, stateSucceeded, stateFailed, statePartial, stateCancelled:
+	default:
+		return errors.New("invalid_operation")
+	}
+	return nil
+}
+
+func writeRecord(ctx context.Context, tx *sqlx.Tx, r record) error {
+	b, err := json.Marshal(r)
+	if err != nil {
+		return err
+	}
+	_, err = tx.ExecContext(ctx, tx.Rebind(`INSERT INTO settings(key,value,updated_at) VALUES(?,?,CURRENT_TIMESTAMP)
+	 ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at`), settingsKey, string(b))
+	return err
+}
+
+func (s *Service) change(ctx context.Context, fn func(*record, *sqlx.Tx) error) (record, error) {
+	if !s.supported() {
+		return record{}, errors.New("unsupported")
+	}
+	tx, err := s.pool.Writer().BeginTxx(ctx, nil)
+	if err != nil {
+		return record{}, err
+	}
+	defer tx.Rollback() //nolint:errcheck // A committed transaction is already closed.
+	// Acquire the writer lock before reading either policy or task admission, so
+	// task admission, message writes and cleanup serialize through it.
+	if _, err = tx.ExecContext(ctx, tx.Rebind(`UPDATE settings SET key=key WHERE key=?`), settingsKey); err != nil {
+		return record{}, err
+	}
+	r, err := readRecord(ctx, tx)
+	if err != nil {
+		return r, err
+	}
+	if err = fn(&r, tx); err != nil {
+		return r, err
+	}
+	if err = writeRecord(ctx, tx, r); err != nil {
+		return r, err
+	}
+	return r, tx.Commit()
+}
diff --git a/apps/backend/internal/system/dataretention/types.go b/apps/backend/internal/system/dataretention/types.go
new file mode 100644
index 00000000000..473bbf16f08
--- /dev/null
+++ b/apps/backend/internal/system/dataretention/types.go
@@ -0,0 +1,97 @@
+package dataretention
+
+import "time"
+
+type Preparation struct {
+	State  string `json:"state"`
+	Choice string `json:"choice"`
+	Error  string `json:"error,omitempty"`
+}
+
+// Target separates the two approved reductions in every counter and in the
+// settings surface, so one target's result is never reported as the other's.
+type Target struct {
+	Rows       int64 `json:"rows"`
+	Reduced    int64 `json:"reduced"`
+	Bytes      int64 `json:"bytes"`
+	Eligible   int64 `json:"eligible"`
+	Oversized  int64 `json:"oversized"`
+	TotalBytes int64 `json:"total_bytes"`
+}
+
+type Operation struct {
+	ID              string           `json:"id"`
+	Kind            string           `json:"kind"`
+	State           string           `json:"state"`
+	Messages        Target           `json:"messages"`
+	CleanupJobs     Target           `json:"cleanup_jobs"`
+	Skipped         map[string]int64 `json:"skipped"`
+	ArchivedCutoff  time.Time        `json:"archived_cutoff"`
+	CleanupCutoff   time.Time        `json:"cleanup_cutoff"`
+	PolicyRevision  int64            `json:"policy_revision"`
+	StartedAt       time.Time        `json:"started_at"`
+	FinishedAt      *time.Time       `json:"finished_at,omitempty"`
+	Error           string           `json:"error,omitempty"`
+	AnalysisOnly    bool             `json:"analysis_only,omitempty"`
+	Complete        bool             `json:"complete,omitempty"`
+	CompletedTarget string           `json:"completed_target,omitempty"`
+}
+
+type Status struct {
+	Policy       Policy      `json:"policy"`
+	Supported    bool        `json:"supported"`
+	Preparation  Preparation `json:"preparation"`
+	Operation    *Operation  `json:"operation,omitempty"`
+	LastAnalysis *Operation  `json:"last_analysis,omitempty"`
+	LastRun      *Operation  `json:"last_run,omitempty"`
+	NextDueAt    *time.Time  `json:"next_due_at,omitempty"`
+}
+
+type Update struct {
+	Enabled      bool   `json:"enabled"`
+	ArchivedAge  Age    `json:"archived_age"`
+	CleanupAge   Age    `json:"cleanup_age"`
+	Revision     int64  `json:"revision"`
+	BackupChoice string `json:"backup_choice,omitempty"`
+}
+
+// progress is the resumable cursor of one pass. Each target keeps its own
+// keyset so finishing one never loses the other's position.
+type progress struct {
+	SchemaVersion int    `json:"schema_version"`
+	Task          string `json:"task"`
+	TaskAfter     string `json:"task_after"`
+	Session       string `json:"session"`
+	SessionAfter  string `json:"session_after"`
+	Message       int64  `json:"message"`
+	UpperTask     string `json:"upper_task"`
+	UpperMessage  int64  `json:"upper_message"`
+	Job           string `json:"job"`
+	JobAfter      string `json:"job_after"`
+	UpperJob      string `json:"upper_job"`
+	Phase         string `json:"phase"`
+	Revision      int64  `json:"revision"`
+	Started       bool   `json:"started"`
+}
+
+const (
+	phaseMessages = "messages"
+	phaseJobs     = "jobs"
+)
+
+type record struct {
+	Status
+	Version          int      `json:"version"`
+	ApprovedRevision int64    `json:"approved_revision"`
+	Receipt          string   `json:"receipt,omitempty"`
+	FirstMutation    bool     `json:"first_mutation"`
+	Progress         progress `json:"progress"`
+	// PreparationDetail keeps the last preparation failure cause for
+	// post-mortem diagnosis. It is persisted but kept off Status so raw internal
+	// error strings never reach the read endpoint.
+	PreparationDetail string `json:"preparation_detail,omitempty"`
+}
+
+func defaultRecord() record {
+	return record{Status: Status{Policy: DefaultPolicy(), Supported: true, Preparation: Preparation{State: stateNone}}, Version: 1}
+}
diff --git a/apps/backend/internal/system/hostmemory/memory.go b/apps/backend/internal/system/hostmemory/memory.go
new file mode 100644
index 00000000000..ab64b967c12
--- /dev/null
+++ b/apps/backend/internal/system/hostmemory/memory.go
@@ -0,0 +1,118 @@
+// Package hostmemory reports host-wide memory pressure so launch admission can
+// hold new sessions back before the machine is driven into swap or an
+// out-of-memory reset.
+//
+// The package is a leaf: it observes the operating system only. It never
+// launches, stops, or mutates anything, and the pure threshold decision
+// (Pressured) carries no build tag so it is exercised on every platform.
+package hostmemory
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+)
+
+const (
+	// EnvEnabled is the single kill switch for the memory guard.
+	EnvEnabled = "KANDEV_SESSION_MEMORY_GUARD_ENABLED"
+	// EnvMinAvailableMB is the available-physical-memory floor in MiB.
+	EnvMinAvailableMB = "KANDEV_SESSION_MEMORY_MIN_AVAILABLE_MB"
+	// EnvMaxCommitPercent is the commit-charge ceiling in percent.
+	EnvMaxCommitPercent = "KANDEV_SESSION_MEMORY_MAX_COMMIT_PERCENT"
+
+	// DefaultMinAvailableBytes is the shipped available-physical-memory floor.
+	DefaultMinAvailableBytes uint64 = 8 << 30 // 8 GiB
+	// DefaultMaxCommitPercent is the shipped commit-charge ceiling. It stays
+	// below an external host watchdog's restart threshold (77% commit), because
+	// if the guard deferred at or above that line the watchdog would restart the
+	// whole instance before any launch was ever held. An operator can still
+	// raise it, at the cost of that ordering.
+	DefaultMaxCommitPercent float64 = 75
+)
+
+// Reading is one observation of host memory. The counters are installation
+// totals, never per-process or per-session data.
+type Reading struct {
+	TotalBytes       uint64
+	AvailableBytes   uint64
+	CommitUsedBytes  uint64
+	CommitLimitBytes uint64
+	// CommitKnown reports whether the commit pair is usable. A platform
+	// without a commit reading leaves it false, and the gate judges only the
+	// available-memory dimension there.
+	CommitKnown bool
+	// Complete reports whether the reading is usable at all. False means the
+	// platform could not produce a reading and the caller must fail open.
+	Complete bool
+}
+
+// Gate is the configured memory-pressure threshold pair.
+type Gate struct {
+	Enabled           bool
+	MinAvailableBytes uint64
+	MaxCommitPercent  float64
+}
+
+// Pressured reports whether r is under pressure under g. unknown is true when
+// the reading is incomplete, so the caller can fail open (allow the launch)
+// rather than stall every automatic launch on a host it cannot measure. A
+// dimension a platform cannot report is simply not judged, which is the same
+// fail-open posture one level down.
+func (g Gate) Pressured(r Reading) (pressured bool, unknown bool) {
+	if !g.Enabled {
+		return false, false
+	}
+	if !r.Complete {
+		return false, true
+	}
+	if g.MinAvailableBytes > 0 && r.AvailableBytes < g.MinAvailableBytes {
+		return true, false
+	}
+	if g.MaxCommitPercent > 0 && r.CommitKnown && r.CommitLimitBytes > 0 {
+		percent := float64(r.CommitUsedBytes) / float64(r.CommitLimitBytes) * 100
+		if percent > g.MaxCommitPercent {
+			return true, false
+		}
+	}
+	return false, false
+}
+
+// Reader reads the current host memory state.
+type Reader interface {
+	Read(ctx context.Context) (Reading, error)
+}
+
+// ReadConfig resolves the guard from the process environment. Enablement is
+// supplied per profile (profiles.yaml); a missing or unparsable value falls
+// back to disabled and the shipped thresholds. Only the enabled flag is
+// profile-varying, so the thresholds carry in-code defaults.
+func ReadConfig() Gate {
+	gate := Gate{
+		MinAvailableBytes: DefaultMinAvailableBytes,
+		MaxCommitPercent:  DefaultMaxCommitPercent,
+	}
+	if value, ok := os.LookupEnv(EnvEnabled); ok {
+		gate.Enabled = truthy(value)
+	}
+	if value, ok := os.LookupEnv(EnvMinAvailableMB); ok {
+		if mb, err := strconv.ParseInt(strings.TrimSpace(value), 10, 64); err == nil && mb >= 0 {
+			gate.MinAvailableBytes = uint64(mb) << 20
+		}
+	}
+	if value, ok := os.LookupEnv(EnvMaxCommitPercent); ok {
+		if percent, err := strconv.ParseFloat(strings.TrimSpace(value), 64); err == nil && percent >= 0 {
+			gate.MaxCommitPercent = percent
+		}
+	}
+	return gate
+}
+
+func truthy(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "true", "1", "yes", "on":
+		return true
+	}
+	return false
+}
diff --git a/apps/backend/internal/system/hostmemory/memory_linux.go b/apps/backend/internal/system/hostmemory/memory_linux.go
new file mode 100644
index 00000000000..ac0778c4f37
--- /dev/null
+++ b/apps/backend/internal/system/hostmemory/memory_linux.go
@@ -0,0 +1,67 @@
+//go:build linux
+
+package hostmemory
+
+import (
+	"context"
+	"errors"
+	"os"
+	"strconv"
+	"strings"
+)
+
+type linuxReader struct{}
+
+// NewReader returns the Linux host-memory reader.
+func NewReader() Reader { return linuxReader{} }
+
+func (linuxReader) Read(ctx context.Context) (Reading, error) {
+	if err := ctx.Err(); err != nil {
+		return Reading{}, err
+	}
+	data, err := os.ReadFile("/proc/meminfo")
+	if err != nil {
+		return Reading{Complete: false}, err
+	}
+	values := parseMeminfo(string(data))
+	total, ok := values["MemTotal"]
+	if !ok {
+		return Reading{Complete: false}, errors.New("/proc/meminfo has no MemTotal")
+	}
+	reading := Reading{TotalBytes: kib(total), Complete: true}
+	if available, ok := values["MemAvailable"]; ok {
+		reading.AvailableBytes = kib(available)
+	} else {
+		reading.AvailableBytes = kib(values["MemFree"] + values["Buffers"] + values["Cached"])
+	}
+	if limit, ok := values["CommitLimit"]; ok {
+		if committed, ok := values["Committed_AS"]; ok {
+			reading.CommitLimitBytes = kib(limit)
+			reading.CommitUsedBytes = kib(committed)
+			reading.CommitKnown = true
+		}
+	}
+	return reading, nil
+}
+
+func parseMeminfo(content string) map[string]uint64 {
+	values := make(map[string]uint64)
+	for _, line := range strings.Split(content, "\n") {
+		key, rest, found := strings.Cut(line, ":")
+		if !found {
+			continue
+		}
+		fields := strings.Fields(rest)
+		if len(fields) == 0 {
+			continue
+		}
+		value, err := strconv.ParseUint(fields[0], 10, 64)
+		if err != nil {
+			continue
+		}
+		values[strings.TrimSpace(key)] = value
+	}
+	return values
+}
+
+func kib(v uint64) uint64 { return v << 10 }
diff --git a/apps/backend/internal/system/hostmemory/memory_test.go b/apps/backend/internal/system/hostmemory/memory_test.go
new file mode 100644
index 00000000000..6d8b9da3125
--- /dev/null
+++ b/apps/backend/internal/system/hostmemory/memory_test.go
@@ -0,0 +1,117 @@
+package hostmemory
+
+import "testing"
+
+func TestGatePressured(t *testing.T) {
+	complete := Reading{Complete: true, TotalBytes: 64 << 30, AvailableBytes: 16 << 30, CommitUsedBytes: 50 << 30, CommitLimitBytes: 100 << 30, CommitKnown: true}
+	cases := []struct {
+		name      string
+		gate      Gate
+		reading   Reading
+		pressured bool
+		unknown   bool
+	}{
+		{
+			name:    "disabled gate never pressures",
+			gate:    Gate{Enabled: false, MinAvailableBytes: 32 << 30, MaxCommitPercent: 1},
+			reading: complete,
+		},
+		{
+			name:    "incomplete reading is unknown",
+			gate:    Gate{Enabled: true, MinAvailableBytes: 1 << 30, MaxCommitPercent: 85},
+			reading: Reading{Complete: false},
+			unknown: true,
+		},
+		{
+			name:      "available below floor",
+			gate:      Gate{Enabled: true, MinAvailableBytes: 32 << 30, MaxCommitPercent: 0},
+			reading:   complete,
+			pressured: true,
+		},
+		{
+			name:    "available at floor with low commit",
+			gate:    Gate{Enabled: true, MinAvailableBytes: 16 << 30, MaxCommitPercent: 85},
+			reading: complete,
+		},
+		{
+			name:      "commit above ceiling",
+			gate:      Gate{Enabled: true, MinAvailableBytes: 0, MaxCommitPercent: 40},
+			reading:   complete,
+			pressured: true,
+		},
+		{
+			name:    "commit unknown is judged on available only",
+			gate:    Gate{Enabled: true, MinAvailableBytes: 8 << 30, MaxCommitPercent: 40},
+			reading: Reading{Complete: true, AvailableBytes: 16 << 30, CommitKnown: false},
+		},
+		{
+			name:    "zero thresholds never pressure",
+			gate:    Gate{Enabled: true, MinAvailableBytes: 0, MaxCommitPercent: 0},
+			reading: Reading{Complete: true, AvailableBytes: 0, CommitUsedBytes: 100, CommitLimitBytes: 100, CommitKnown: true},
+		},
+		{
+			name:      "commit limit zero is not judged",
+			gate:      Gate{Enabled: true, MinAvailableBytes: 0, MaxCommitPercent: 1},
+			reading:   Reading{Complete: true, CommitUsedBytes: 100, CommitLimitBytes: 0, CommitKnown: true},
+			pressured: false,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			pressured, unknown := tc.gate.Pressured(tc.reading)
+			if pressured != tc.pressured || unknown != tc.unknown {
+				t.Fatalf("Pressured() = (pressured=%v, unknown=%v), want (%v, %v)", pressured, unknown, tc.pressured, tc.unknown)
+			}
+		})
+	}
+}
+
+func TestReadConfigDefaults(t *testing.T) {
+	t.Setenv(EnvEnabled, "")
+	t.Setenv(EnvMinAvailableMB, "")
+	t.Setenv(EnvMaxCommitPercent, "")
+	// t.Setenv sets the variable to "", which is present; the enabled flag
+	// parses an empty value as false and the thresholds keep their defaults.
+	gate := ReadConfig()
+	if gate.Enabled {
+		t.Fatal("empty enabled value must resolve to disabled")
+	}
+	if gate.MinAvailableBytes != DefaultMinAvailableBytes {
+		t.Fatalf("MinAvailableBytes = %d, want default %d", gate.MinAvailableBytes, DefaultMinAvailableBytes)
+	}
+	if gate.MaxCommitPercent != DefaultMaxCommitPercent {
+		t.Fatalf("MaxCommitPercent = %v, want default %v", gate.MaxCommitPercent, DefaultMaxCommitPercent)
+	}
+}
+
+func TestReadConfigOverrides(t *testing.T) {
+	t.Setenv(EnvEnabled, "true")
+	t.Setenv(EnvMinAvailableMB, "4096")
+	t.Setenv(EnvMaxCommitPercent, "70")
+	gate := ReadConfig()
+	if !gate.Enabled {
+		t.Fatal("Enabled = false, want true")
+	}
+	if gate.MinAvailableBytes != 4<<30 {
+		t.Fatalf("MinAvailableBytes = %d, want %d", gate.MinAvailableBytes, uint64(4<<30))
+	}
+	if gate.MaxCommitPercent != 70 {
+		t.Fatalf("MaxCommitPercent = %v, want 70", gate.MaxCommitPercent)
+	}
+}
+
+func TestReadConfigIgnoresInvalidValues(t *testing.T) {
+	t.Setenv(EnvEnabled, "definitely")
+	t.Setenv(EnvMinAvailableMB, "not-a-number")
+	t.Setenv(EnvMaxCommitPercent, "-3")
+	gate := ReadConfig()
+	if gate.Enabled {
+		t.Fatal("invalid enabled value must resolve to disabled")
+	}
+	if gate.MinAvailableBytes != DefaultMinAvailableBytes {
+		t.Fatalf("MinAvailableBytes = %d, want default", gate.MinAvailableBytes)
+	}
+	if gate.MaxCommitPercent != DefaultMaxCommitPercent {
+		t.Fatalf("MaxCommitPercent = %v, want default", gate.MaxCommitPercent)
+	}
+}
diff --git a/apps/backend/internal/system/hostmemory/memory_unsupported.go b/apps/backend/internal/system/hostmemory/memory_unsupported.go
new file mode 100644
index 00000000000..e814b1ccde2
--- /dev/null
+++ b/apps/backend/internal/system/hostmemory/memory_unsupported.go
@@ -0,0 +1,22 @@
+//go:build !windows && !linux
+
+package hostmemory
+
+import "context"
+
+// unsupportedReader is used on platforms without an implemented memory
+// reading (currently darwin and everything else). It reports an incomplete
+// reading, so the gate fails open there and never stalls launches on a host it
+// cannot measure. The product target for this guard is Windows, where the
+// measured outage occurred.
+type unsupportedReader struct{}
+
+// NewReader returns a reader that reports an incomplete reading.
+func NewReader() Reader { return unsupportedReader{} }
+
+func (unsupportedReader) Read(ctx context.Context) (Reading, error) {
+	if err := ctx.Err(); err != nil {
+		return Reading{}, err
+	}
+	return Reading{Complete: false}, nil
+}
diff --git a/apps/backend/internal/system/hostmemory/memory_windows.go b/apps/backend/internal/system/hostmemory/memory_windows.go
new file mode 100644
index 00000000000..133b7edfba3
--- /dev/null
+++ b/apps/backend/internal/system/hostmemory/memory_windows.go
@@ -0,0 +1,107 @@
+//go:build windows
+
+package hostmemory
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+var (
+	kernel32                 = windows.NewLazySystemDLL("kernel32.dll")
+	procGlobalMemoryStatusEx = kernel32.NewProc("GlobalMemoryStatusEx")
+	// GetPerformanceInfo lives in psapi.dll, not kernel32.dll.
+	procGetPerformanceInfo = windows.NewLazySystemDLL("psapi.dll").NewProc("GetPerformanceInfo")
+)
+
+// memoryStatusEx mirrors MEMORYSTATUSEX from windows.h. The first field is the
+// struct length in bytes and must be set by the caller before invoking
+// GlobalMemoryStatusEx.
+type memoryStatusEx struct {
+	Length               uint32
+	MemoryLoad           uint32
+	TotalPhys            uint64
+	AvailPhys            uint64
+	TotalPageFile        uint64
+	AvailPageFile        uint64
+	TotalVirtual         uint64
+	AvailVirtual         uint64
+	AvailExtendedVirtual uint64
+}
+
+// performanceInformation mirrors PERFORMANCE_INFORMATION from psapi.h. The
+// counter fields are page counts; Cb must be set to the struct size.
+type performanceInformation struct {
+	Cb                uint32
+	CommitTotal       uintptr
+	CommitLimit       uintptr
+	CommitPeak        uintptr
+	PhysicalTotal     uintptr
+	PhysicalAvailable uintptr
+	SystemCache       uintptr
+	KernelTotal       uintptr
+	KernelPaged       uintptr
+	KernelNonpaged    uintptr
+	PageSize          uintptr
+	HandleCount       uint32
+	ProcessCount      uint32
+	ThreadCount       uint32
+}
+
+type windowsReader struct{}
+
+// NewReader returns the Windows host-memory reader.
+func NewReader() Reader { return windowsReader{} }
+
+func (windowsReader) Read(ctx context.Context) (Reading, error) {
+	if err := ctx.Err(); err != nil {
+		return Reading{}, err
+	}
+	reading, err := readPhysicalMemory()
+	if err != nil {
+		return Reading{Complete: false}, err
+	}
+	reading.Complete = true
+	if used, limit, ok := readCommitCharge(); ok {
+		reading.CommitUsedBytes = used
+		reading.CommitLimitBytes = limit
+		reading.CommitKnown = true
+	}
+	return reading, nil
+}
+
+func readPhysicalMemory() (Reading, error) {
+	var status memoryStatusEx
+	status.Length = uint32(unsafe.Sizeof(status))
+	r1, _, callErr := procGlobalMemoryStatusEx.Call(uintptr(unsafe.Pointer(&status)))
+	if r1 == 0 {
+		return Reading{}, fmt.Errorf("GlobalMemoryStatusEx: %w", callErr)
+	}
+	if status.TotalPhys == 0 {
+		return Reading{}, errors.New("GlobalMemoryStatusEx reported zero total physical memory")
+	}
+	return Reading{TotalBytes: status.TotalPhys, AvailableBytes: status.AvailPhys}, nil
+}
+
+// readCommitCharge reads the system-wide commit charge. GetPerformanceInfo is
+// used deliberately: GlobalMemoryStatusEx's page-file fields are scoped to the
+// current process, not the whole system, so they cannot stand in for it.
+func readCommitCharge() (used, limit uint64, ok bool) {
+	if err := procGetPerformanceInfo.Find(); err != nil {
+		// Fail open for this dimension: the available-memory floor still
+		// applies, and the gate's commit condition is simply not judged.
+		return 0, 0, false
+	}
+	var info performanceInformation
+	info.Cb = uint32(unsafe.Sizeof(info))
+	r1, _, _ := procGetPerformanceInfo.Call(uintptr(unsafe.Pointer(&info)))
+	if r1 == 0 || info.PageSize == 0 {
+		return 0, 0, false
+	}
+	return uint64(info.CommitTotal) * uint64(info.PageSize),
+		uint64(info.CommitLimit) * uint64(info.PageSize), true
+}
