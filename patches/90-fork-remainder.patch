+// not a genuine miss surfaces with CreateTask's own meaning instead of being
+// treated as a miss.
+func (h *Handlers) preflightMCPFoundCreateTask(
+	ctx context.Context,
+	msg *ws.Message,
+	req *mcpCreateTaskRequest,
+	admission mcpCreateTaskAdmission,
