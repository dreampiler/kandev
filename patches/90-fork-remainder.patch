+		case err := <-waitResult:
+			if !errors.Is(err, ErrCancelEscalated) {
+				t.Fatalf("waitForPromptDone error = %v, want ErrCancelEscalated", err)
+			}
+		default:
+			t.Fatal("waitForPromptDone did not escalate after the user-input request cleared")
+		}
+	})
+}
