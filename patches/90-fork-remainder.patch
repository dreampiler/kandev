+// edit and a legacy client never silently erase a tier layout.
+func (c *Controller) preserveDynamicSelection(
+	ctx context.Context,
+	dynamicRepo store.DynamicProfileRepository,
+	profileID string,
+	request *dto.DynamicAgentProfileDTO,
