+	default:
+		return "", false
+	}
+	if !fallback {
+		return base, true
+	}
+	if policy.OnFailure == FailureNextTier {
+		return base + ReasonSuffixNextTier, true
+	}
+	return base + ReasonSuffixSameTier, true
