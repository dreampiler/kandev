+	openRouterDailyLabel = "1-day"
+)
+
+// OpenRouterFreeDailyRequests is the free-model allowance of an account that
+// has bought at least $10 of credits. Free-model requests are counted across
+// the whole account; each free model is separately limited per minute.
+const OpenRouterFreeDailyRequests = 1000
+
+// OpenRouterUsageClient reads the account's free-model daily request count.
+// OpenRouter counts free-model requests across the whole account, so the
+// provider's own count is used rather than a local one, measured against the
+// configured daily allowance.
+type OpenRouterUsageClient struct {
+	key        OpenCodeKeySource
+	keyURL     string
+	dailyLimit int
+	httpClient *http.Client
+	now        func() time.Time
+}
+
+// NewOpenRouterUsageClient creates a client that authenticates with the
+// OpenRouter key in the OpenCode auth file at authPath. A non-positive
+// dailyLimit uses the limit the provider reports.
+func NewOpenRouterUsageClient(authPath string, dailyLimit int) *OpenRouterUsageClient {
+	return &OpenRouterUsageClient{
+		key:        OpenCodeKeySource{Path: authPath, Providers: []string{"openrouter"}},
+		keyURL:     openRouterKeyURL,
+		dailyLimit: dailyLimit,
+		httpClient: &http.Client{Timeout: apiKeyUsageHTTPTimeout},
+		now:        time.Now,
+	}
+}
+
+type openRouterKeyResponse struct {
+	Data struct {
+		IsFreeTier             bool `json:"is_free_tier"`
+		FreeModelDailyRequests *struct {
+			Used      float64  `json:"used"`
+			Limit     float64  `json:"limit"`
+			Remaining *float64 `json:"remaining"`
+		} `json:"free_model_daily_requests"`
+	} `json:"data"`
+}
+
+// FetchUsage implements ProviderUsageClient.
+func (c *OpenRouterUsageClient) FetchUsage(ctx context.Context) (*ProviderUsage, error) {
+	apiKey, err := c.key.APIKey(openRouterProvider)
+	if err != nil {
+		return nil, err
+	}
+	var raw openRouterKeyResponse
+	if err := getBearerJSON(ctx, c.httpClient, openRouterProvider, c.keyURL, apiKey, &raw); err != nil {
+		return nil, err
+	}
+	return parseOpenRouterUsage(raw, c.now(), c.dailyLimit), nil
+}
+
+// parseOpenRouterUsage turns the free-request counter into a daily window. The
+// quota resets at midnight UTC, so the window spans the current UTC day. The
+// configured allowance wins over the provider's limit field; a response
+// without the counter yields no window rather than a guessed count.
+func parseOpenRouterUsage(raw openRouterKeyResponse, now time.Time, configuredLimit int) *ProviderUsage {
+	plan := "credits"
+	if raw.Data.IsFreeTier {
+		plan = "free"
+	}
+	usage := &ProviderUsage{Provider: openRouterProvider, Plan: plan, Windows: []UtilizationWindow{}, FetchedAt: now}
+	counter := raw.Data.FreeModelDailyRequests
+	if counter == nil {
+		return usage
+	}
+	usage.FreeModelDailyRequests = freeCounter(raw)
+	limit := counter.Limit
+	if configuredLimit > 0 {
+		limit = float64(configuredLimit)
+	}
+	if limit <= 0 {
+		return usage
+	}
+	start := now.UTC().Truncate(24 * time.Hour)
+	reset := start.Add(24 * time.Hour)
+	usage.Windows = append(usage.Windows, UtilizationWindow{
+		Label:           openRouterDailyLabel,
+		UtilizationPct:  100 * counter.Used / limit,
+		ResetAt:         reset,
+		StartAt:         start,
+		DurationSeconds: int64(24 * time.Hour / time.Second),
+		Scope:           WindowScopeFreeModels,
+		LimitReached:    counter.Used >= limit || (counter.Remaining != nil && *counter.Remaining == 0),
+	})
+	return usage
+}
+
+func freeCounter(raw openRouterKeyResponse) *FreeModelCounter {
+	c := raw.Data.FreeModelDailyRequests
+	if c == nil || c.Limit <= 0 || c.Used < 0 {
+		return nil
+	}
+	remaining := c.Limit - c.Used
+	if c.Remaining != nil {
+		remaining = *c.Remaining
+	}
+	if remaining < 0 {
+		remaining = 0
+	}
+	return &FreeModelCounter{Used: c.Used, Limit: c.Limit, Remaining: remaining}
+}
diff --git a/apps/backend/internal/agent/usage/errors.go b/apps/backend/internal/agent/usage/errors.go
new file mode 100644
index 00000000000..7ff218be95a
--- /dev/null
+++ b/apps/backend/internal/agent/usage/errors.go
@@ -0,0 +1,106 @@
+package usage
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// maxRetryAfter bounds provider-supplied Retry-After hints so an absurd or
+// hostile header cannot park an account indefinitely.
+const maxRetryAfter = maxBackoffTTL
+
+// FetchFailure is a bounded reason a usage read failed. It is safe to log and to
+// return to clients because it never carries a credential or a provider body.
+type FetchFailure string
+
+const (
+	FailureCredentialMissing FetchFailure = "credential_missing"
+	FailureUnauthorized      FetchFailure = "unauthorized"
+	FailureHTTPStatus        FetchFailure = "http_status"
+	FailureNetwork           FetchFailure = "network"
+	FailureDecode            FetchFailure = "decode"
+	// FailureUnknown covers errors from clients that do not classify their
+	// failures.
+	FailureUnknown FetchFailure = "fetch_failed"
+)
+
+// FetchError is a classified usage read failure. The wrapped error may hold
+// detail for debugging, but Error() only exposes the provider, reason,
+// status, and rounded retry hint, so logging it cannot leak a response body.
+type FetchError struct {
+	Provider   string
+	Reason     FetchFailure
+	Status     int
+	RetryAfter time.Duration
+	Err        error
+}
+
+func (e *FetchError) Error() string {
+	if e.RetryAfter > 0 {
+		if e.Status != 0 {
+			return fmt.Sprintf("%s usage: %s (status %d, retry after %s)", e.Provider, e.Reason, e.Status, e.RetryAfter.Round(time.Second))
+		}
+		return fmt.Sprintf("%s usage: %s (retry after %s)", e.Provider, e.Reason, e.RetryAfter.Round(time.Second))
+	}
+	if e.Status != 0 {
+		return fmt.Sprintf("%s usage: %s (status %d)", e.Provider, e.Reason, e.Status)
+	}
+	return fmt.Sprintf("%s usage: %s", e.Provider, e.Reason)
+}
+
+func (e *FetchError) Unwrap() error { return e.Err }
+
+// FailureOf extracts the bounded reason and HTTP status from a usage error.
+func FailureOf(err error) (FetchFailure, int) {
+	var fetchErr *FetchError
+	if errors.As(err, &fetchErr) {
+		return fetchErr.Reason, fetchErr.Status
+	}
+	return FailureUnknown, 0
+}
+
+// ParseRetryAfter parses a Retry-After header in either delta-seconds or
+// HTTP-date format, clamped between zero and maxRetryAfter.
+func ParseRetryAfter(value string, now time.Time) time.Duration {
+	trimmed := strings.TrimSpace(value)
+	if trimmed == "" {
+		return 0
+	}
+	var delay time.Duration
+	if seconds, err := strconv.ParseInt(trimmed, 10, 64); err == nil {
+		if seconds <= 0 {
+			return 0
+		}
+		delay = time.Duration(seconds) * time.Second
+	} else if parsed, parseErr := http.ParseTime(trimmed); parseErr == nil {
+		if !parsed.After(now) {
+			return 0
+		}
+		delay = parsed.Sub(now)
+	} else {
+		return 0
+	}
+	if delay > maxRetryAfter {
+		return maxRetryAfter
+	}
+	return delay
+}
+
+// statusFailure classifies a non-OK provider response. Authentication and
+// permission refusals are separated so an operator can tell a missing scope
+// from a provider outage. When header is provided, Retry-After is parsed.
+func statusFailure(provider string, status int, header http.Header) *FetchError {
+	reason := FailureHTTPStatus
+	if status == http.StatusUnauthorized || status == http.StatusForbidden {
+		reason = FailureUnauthorized
+	}
+	var retryAfter time.Duration
+	if header != nil {
+		retryAfter = ParseRetryAfter(header.Get("Retry-After"), time.Now())
+	}
+	return &FetchError{Provider: provider, Reason: reason, Status: status, RetryAfter: retryAfter}
+}
diff --git a/apps/backend/internal/agent/usage/limit_catalog.go b/apps/backend/internal/agent/usage/limit_catalog.go
new file mode 100644
index 00000000000..3dc7afdbff0
--- /dev/null
+++ b/apps/backend/internal/agent/usage/limit_catalog.go
@@ -0,0 +1,83 @@
+package usage
+
+import (
+	_ "embed"
+	"encoding/json"
+	"strings"
+	"sync"
+)
+
+// limit_catalog.json holds installation default values and their provenance.
+// Routing code reads it through catalogDefaults; owner and learned values
+// still take precedence.
+//
+//go:embed limit_catalog.json
+var limitCatalogJSON []byte
+
+type limitCatalogEntry struct {
+	Providers        []string          `json:"providers"`
+	Tier             BillingTier       `json:"tier"`
+	PurchasedCredits *bool             `json:"purchased_credits,omitempty"`
+	Provenance       map[string]string `json:"provenance,omitempty"`
+	Scopes           []RequestScope    `json:"scopes,omitempty"`
+}
+
+type limitCatalog struct {
+	Entries []limitCatalogEntry `json:"entries"`
+}
+
+var loadLimitCatalog = sync.OnceValues(func() (limitCatalog, error) {
+	return decodeLimitCatalog(limitCatalogJSON)
+})
+
+func decodeLimitCatalog(data []byte) (limitCatalog, error) {
+	var catalog limitCatalog
+	if err := json.Unmarshal(data, &catalog); err != nil {
+		return limitCatalog{}, err
+	}
+	for _, entry := range catalog.Entries {
+		for _, scope := range entry.Scopes {
+			if err := validateRequestScope(scope); err != nil {
+				return limitCatalog{}, err
+			}
+		}
+	}
+	return catalog, nil
+}
+
+func (e limitCatalogEntry) matches(provider string, tier BillingTier, purchased bool) bool {
+	if e.Tier != tier || (e.PurchasedCredits != nil && *e.PurchasedCredits != purchased) {
+		return false
+	}
+	for _, p := range e.Providers {
+		if strings.EqualFold(p, provider) {
+			return true
+		}
+	}
+	return false
+}
+
+// applyCatalogDefaults adds catalog scopes and provenance labels to derived
+// defaults. Later matching entries refine earlier provenance labels.
+func applyCatalogDefaults(limits TierLimits, provider string, tier BillingTier, purchased bool) TierLimits {
+	catalog, err := loadLimitCatalog()
+	if err != nil {
+		return limits
+	}
+	for _, entry := range catalog.Entries {
+		if !entry.matches(provider, tier, purchased) {
+			continue
+		}
+		for field, provenance := range entry.Provenance {
+			if limits.Provenance == nil {
+				limits.Provenance = make(map[string]string)
+			}
+			limits.Provenance[field] = provenance
+		}
+		for _, scope := range entry.Scopes {
+			scope.Models = append([]string(nil), scope.Models...)
+			limits.Scopes = append(limits.Scopes, scope)
+		}
+	}
+	return limits
+}
