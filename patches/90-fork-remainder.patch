+}
+
+func TestSessionCeilingMemoryFailsOpenOnIncompleteReading(t *testing.T) {
+	lister := &fakeAdmittedLister{}
+	c := newMemoryController(t, 10, lister, &fakeMemoryReader{reading: hostmemory.Reading{Complete: false}})
+
