diff --git a/apps/backend/internal/backendapp/provider_limits.go b/apps/backend/internal/backendapp/provider_limits.go
new file mode 100644
index 00000000000..2ff01f886ce
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_limits.go
@@ -0,0 +1,267 @@
+package backendapp
+
+import (
+	"context"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	dynamicruntime "github.com/kandev/kandev/internal/agent/runtime/dynamic"
+	"github.com/kandev/kandev/internal/agent/settings/controller"
+	settingsstore "github.com/kandev/kandev/internal/agent/settings/store"
+)
+
+// providerLimitStore persists operator-entered provider limit settings.
+type providerLimitStore interface {
+	ListProviderLimits(ctx context.Context) ([]dynamicruntime.ProviderLimit, error)
+	SaveProviderLimit(ctx context.Context, limit dynamicruntime.ProviderLimit) error
+}
+
+// providerLimitService implements controller.ProviderLimitService. Providers
+// are the prefixes of the models agent profiles launch, plus any provider that
+// already has saved settings.
+type providerLimitService struct {
+	tiers    *providerTierLimitService
+	store    providerLimitStore
+	profiles settingsstore.Repository
+	calendar *dynamicLimitCalendar
+	now      func() time.Time
+}
+
+var providerKeyPattern = regexp.MustCompile(`^[a-z0-9][a-z0-9._-]{0,63}$`)
+
+func newProviderLimitService(
+	store providerLimitStore,
+	profiles settingsstore.Repository,
+	calendar *dynamicLimitCalendar,
+) *providerLimitService {
+	return &providerLimitService{store: store, profiles: profiles, calendar: calendar, now: time.Now}
+}
+
+// providerProfile is one local profile that launches a model of a provider.
+type providerProfile struct {
+	profileID string
+	modelID   string
+}
+
+// ListProviderLimits implements controller.ProviderLimitService.
+func (s *providerLimitService) ListProviderLimits(ctx context.Context) ([]controller.ProviderLimitDTO, error) {
+	saved, err := s.store.ListProviderLimits(ctx)
+	if err != nil {
+		return nil, err
+	}
+	byProvider := make(map[string]dynamicruntime.ProviderLimit, len(saved))
+	for _, limit := range saved {
+		byProvider[dynamicruntime.NormalizeProvider(limit.Provider)] = limit
+	}
+	profiles, err := s.providerProfiles(ctx)
+	if err != nil {
+		return nil, err
+	}
+	accounts := map[string][]controller.ProviderAccountLimitDTO{}
+	if s.tiers != nil {
+		accounts, err = s.tiers.ListAccounts(ctx)
+		if err != nil {
+			return nil, err
+		}
+	}
+	providers := make(map[string]struct{}, len(profiles)+len(byProvider))
+	for provider := range accounts {
+		providers[provider] = struct{}{}
+	}
+	for provider := range profiles {
+		providers[provider] = struct{}{}
+	}
+	for provider := range byProvider {
+		providers[provider] = struct{}{}
+	}
+	names := make([]string, 0, len(providers))
+	for provider := range providers {
+		names = append(names, provider)
+	}
+	sort.Strings(names)
+	now := s.now()
+	result := make([]controller.ProviderLimitDTO, 0, len(names))
+	for _, provider := range names {
+		limit, hasLimit := byProvider[provider]
+		if !hasLimit {
+			limit = dynamicruntime.ProviderLimit{Provider: provider}
+		}
+		entry := s.describe(ctx, limit, hasLimit, profiles[provider], now)
+		entry.Accounts = accounts[provider]
+		result = append(result, entry)
+	}
+	return result, nil
+}
+
+// UpdateProviderLimit implements controller.ProviderLimitService.
+func (s *providerLimitService) UpdateProviderLimit(
+	ctx context.Context,
+	provider string,
+	request controller.UpdateProviderLimitRequest,
+) (*controller.ProviderLimitDTO, error) {
+	provider = dynamicruntime.NormalizeProvider(provider)
+	if request.AccountID != "" || request.AccountLimits != nil {
+		return s.updateAccountLimits(ctx, provider, request)
+	}
+	limit, err := providerLimitFromRequest(provider, request)
+	if err != nil {
+		return nil, err
+	}
+	if err := s.store.SaveProviderLimit(ctx, limit); err != nil {
+		return nil, err
+	}
+	profiles, err := s.providerProfiles(ctx)
+	if err != nil {
+		return nil, err
+	}
+	now := s.now()
+	limit.UpdatedAt = now
+	described := s.describe(ctx, limit, true, profiles[provider], now)
+	return &described, nil
+}
+
+func providerLimitFromRequest(provider string, request controller.UpdateProviderLimitRequest) (dynamicruntime.ProviderLimit, error) {
+	if !providerKeyPattern.MatchString(provider) {
+		return dynamicruntime.ProviderLimit{}, fmt.Errorf("%w: provider %q", controller.ErrInvalidProviderLimit, provider)
+	}
+	timezone := strings.TrimSpace(request.MonthlyResetTimezone)
+	if timezone != "" {
+		if _, err := time.LoadLocation(timezone); err != nil {
+			return dynamicruntime.ProviderLimit{}, fmt.Errorf("%w: unknown timezone %q", controller.ErrInvalidProviderLimit, timezone)
+		}
+	}
+	limit := dynamicruntime.ProviderLimit{
+		Provider: provider, MonthlyResetAt: nonZeroTime(request.MonthlyResetAt),
+		MonthlyResetTimezone: timezone, BlockUntil: nonZeroTime(request.BlockUntil),
+	}
+	if limit.MonthlyResetAt == nil {
+		limit.MonthlyResetTimezone = ""
+	}
+	return limit, nil
+}
+
+func (s *providerLimitService) describe(
+	ctx context.Context,
+	limit dynamicruntime.ProviderLimit,
+	saved bool,
+	profiles []providerProfile,
+	now time.Time,
+) controller.ProviderLimitDTO {
+	provider := dynamicruntime.NormalizeProvider(limit.Provider)
+	result := controller.ProviderLimitDTO{
+		Provider:             provider,
+		ProfileCount:         len(profiles),
+		MonthlyResetAt:       utcTime(limit.MonthlyResetAt),
+		MonthlyResetTimezone: limit.MonthlyResetTimezone,
+		BlockUntil:           utcTime(limit.BlockUntil),
+	}
+	if saved && !limit.UpdatedAt.IsZero() {
+		result.UpdatedAt = utcTime(&limit.UpdatedAt)
+	}
+	for _, profile := range profiles {
+		if dynamicruntime.ModelScoped(profile.modelID) && !dynamicruntime.IsFreeModel(profile.modelID) {
+			result.ModelScoped = true
+			break
+		}
+	}
+	if sample, ok := paidProfile(profiles); ok && s.calendar != nil {
+		candidate := dynamicruntime.Candidate{ID: sample.profileID, Enabled: true, ModelID: sample.modelID}
+		windows := s.calendar.observedWindows(ctx, candidate)
+		if reset, ok := observedMonthlyReset(windows, now); ok {
+			result.NextMonthlyReset, result.NextMonthlyResetSource = utcTime(&reset), "usage"
+		}
+		if until, ok := s.calendar.ExhaustedUntil(ctx, candidate, now); ok {
+			result.ObservedExhaustedUntil = utcTime(&until)
+		}
+	}
+	if result.NextMonthlyReset == nil {
+		if reset, ok := limit.NextMonthlyReset(now); ok {
+			result.NextMonthlyReset, result.NextMonthlyResetSource = utcTime(&reset), "manual"
+		}
+	}
+	return result
+}
+
+// providerProfiles groups the enabled local profiles by the provider prefix of
+// their model.
+func (s *providerLimitService) providerProfiles(ctx context.Context) (map[string][]providerProfile, error) {
+	grouped := make(map[string][]providerProfile)
+	if s.profiles == nil {
+		return grouped, nil
+	}
+	agents, err := s.profiles.ListAgents(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for _, agent := range agents {
+		if agent == nil {
+			continue
+		}
+		profiles, err := s.profiles.ListAgentProfiles(ctx, agent.ID)
+		if err != nil {
+			return nil, err
+		}
+		for _, profile := range profiles {
+			if profile == nil || profile.DeletedAt != nil || !profile.Enabled {
+				continue
+			}
+			model := strings.TrimSpace(profile.Model)
+			provider := dynamicruntime.ProviderOf(model)
+			if provider == "" {
+				continue
+			}
+			grouped[provider] = append(grouped[provider], providerProfile{profileID: profile.ID, modelID: model})
+		}
+	}
+	return grouped, nil
+}
+
+// paidProfile picks a paid-model profile whose usage reading describes the
+// provider account.
+func paidProfile(profiles []providerProfile) (providerProfile, bool) {
+	for _, profile := range profiles {
+		if !dynamicruntime.IsFreeModel(profile.modelID) {
+			return profile, true
+		}
+	}
+	return providerProfile{}, false
+}
+
+func nonZeroTime(value *time.Time) *time.Time {
+	if value == nil || value.IsZero() {
+		return nil
+	}
+	utc := value.UTC()
+	return &utc
+}
+
+func utcTime(value *time.Time) *time.Time {
+	if value == nil || value.IsZero() {
+		return nil
+	}
+	utc := value.UTC()
+	return &utc
+}
+
+func (s *providerLimitService) updateAccountLimits(ctx context.Context, provider string, request controller.UpdateProviderLimitRequest) (*controller.ProviderLimitDTO, error) {
+	if request.AccountID == "" || request.AccountLimits == nil || s.tiers == nil {
+		return nil, controller.ErrInvalidProviderLimit
+	}
+	if err := s.tiers.UpdateAccount(ctx, provider, request.AccountID, *request.AccountLimits); err != nil {
+		return nil, err
+	}
+	all, err := s.ListProviderLimits(ctx)
+	if err != nil {
+		return nil, err
+	}
+	for _, entry := range all {
+		if entry.Provider == provider {
+			return &entry, nil
+		}
+	}
+	return nil, controller.ErrInvalidProviderLimit
+
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_failures.go b/apps/backend/internal/backendapp/provider_tier_limit_failures.go
new file mode 100644
index 00000000000..b7ac6246205
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_failures.go
@@ -0,0 +1,171 @@
+package backendapp
+
+import (
+	"context"
+	dynamicruntime "github.com/kandev/kandev/internal/agent/runtime/dynamic"
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+	agentusage "github.com/kandev/kandev/internal/agent/usage"
+	sqliterepo "github.com/kandev/kandev/internal/task/repository/sqlite"
+	"strings"
+	"time"
+)
+
+const limitDimensionUnknown = "unknown"
+
+func (s *providerTierLimitService) resolveFailure(ctx context.Context, candidate dynamicruntime.Candidate, failure *routingerr.Error) *routingerr.Error {
+	if candidate.RemoteExecution || dynamicruntime.ProviderOf(candidate.ModelID) != "openrouter" || failure.Code != routingerr.CodeRateLimited {
+		return failure
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	counter, err := s.refreshOpenRouterCounter(ctx, candidate)
+	if err != nil || counter == nil {
+		return failure
+	}
+	copy := *failure
+	now := time.Now()
+	until := minuteResetFromFailure(failure, now)
+	copy.ClassifierRule = "account_limit.minute"
+	if counter.Remaining == 0 {
+		copy.ClassifierRule = "account_limit.daily"
+		until = now.UTC().Truncate(24 * time.Hour).Add(24 * time.Hour)
+	}
+	copy.ResetHint = &until
+	return &copy
+}
+
+func (s *providerTierLimitService) refreshOpenRouterCounter(ctx context.Context, candidate dynamicruntime.Candidate) (*agentusage.FreeModelCounter, error) {
+	profile, a, ok := s.usage.loadProfile(ctx, candidate.ID)
+	if !ok {
+		return nil, nil
+	}
+	binding, ok := s.usage.bindingFor(profile, a)
+	if !ok {
+		return nil, nil
+	}
+	free := candidate.CatalogFree || dynamicruntime.IsFreeModel(candidate.ModelID)
+	if !free && binding.class != nil {
+		free = binding.class(ctx) == agentusage.ModelClassFree
+	}
+	if !free {
+		return nil, nil
+	}
+	if binding.client == nil {
+		return nil, nil
+	}
+	s.usage.svc.Register(candidate.ID, binding.client, binding.cacheKey)
+	observed, err := s.usage.svc.RefreshUsage(ctx, candidate.ID)
+	if err != nil || observed == nil {
+		return nil, err
+	}
+	return observed.FreeModelDailyRequests, nil
+}
+
+// classifyDimension never guesses a long window from an ambiguous plan notice.
+func classifyLimitDimension(c dynamicruntime.Candidate, failure *routingerr.Error, observed *agentusage.ProviderUsage) string {
+	switch dynamicruntime.FailureCauseFor(c, failure) {
+	case dynamicruntime.CauseAccountMinuteLimit:
+		return "minute"
+	case dynamicruntime.CauseFreeDailyLimit:
+		return limitDimensionModelDaily
+	case dynamicruntime.CauseFreeAccountDailyLimit:
+		return "daily"
+	}
+	if failure.ClassifierRule == routingerr.RuleClaudeWeeklyLimit {
+		return "week"
+	}
+	if failure.ClassifierRule == routingerr.RuleClaudeSessionLimit {
+		return "5h"
+	}
+	if observed != nil {
+		for _, w := range observed.Windows {
+			if w.Exhausted() {
+				if period := providerWindowPeriod(w); period != "" {
+					return period
+				}
+			}
+		}
+	}
+	if strings.Contains(strings.ToLower(failure.RawExcerpt), "concurrent requests") {
+		return "concurrency"
+	}
+	return limitDimensionUnknown
+}
+
+// recordObservation enriches and stores one observation under the learning
+// lock, so a near-simultaneous block of another model sees this one when it
+// looks for a same-minute partner.
+func (s *providerTierLimitService) recordObservation(ctx context.Context, candidate dynamicruntime.Candidate, failure *routingerr.Error, observation *sqliterepo.UsageLimitObservation) error {
+	s.learningMu.Lock()
+	defer s.learningMu.Unlock()
+	if err := s.enrichObservation(ctx, candidate, failure, observation); err != nil {
+		return err
+	}
+	return s.store.InsertUsageLimitObservation(ctx, *observation)
+}
+
+// enrichObservation runs under learningMu (see recordObservation).
+func (s *providerTierLimitService) enrichObservation(ctx context.Context, candidate dynamicruntime.Candidate, failure *routingerr.Error, observation *sqliterepo.UsageLimitObservation) error {
+	if candidate.RemoteExecution {
+		return nil
+	}
+	c, err := s.contextFor(ctx, candidate.ID)
+	if err != nil {
+		return err
+	}
+	used, err := s.readUsage(ctx, c, "", observation.ObservedAt)
+	if err != nil {
+		return err
+	}
+	dimension := classifyLimitDimension(candidate, failure, c.observed)
+	observation.Tier = string(c.tier)
+	observation.Dimension = dimension
+	observation.RequestsMinute = used.RequestsMinute
+	observation.RequestsDay = used.RequestsDay
+	observation.ActiveTurns = used.ActiveTurns
+	if c.learned.Tiers == nil {
+		c.learned.Tiers = make(map[agentusage.BillingTier]agentusage.TierLimits)
+	}
+
+	windows, err := s.snapshotLimitWindows(ctx, c, observation.ObservedAt, observation)
+	if err != nil {
+		return err
+	}
+	if dimension == limitDimensionModelDaily {
+		return s.learnModelScope(ctx, c, used, observation.ObservedAt)
+	}
+	used.Windows = learningTokenWindows(windows)
+	base := agentusage.MergeTierLimits(c.defaults, c.learned.Tiers[c.tier])
+	learned := agentusage.LearnTierLimits(base, learningDimensionFor(c.tier, dimension), used)
+
+	if !learned.Learned {
+		return nil
+	}
+	c.learned.Tiers[c.tier] = learnedOnly(c.defaults, c.learned.Tiers[c.tier], learned)
+
+	return s.store.SaveAccountTierLearned(ctx, c.key, c.learned)
+}
+
+func learnedOnly(defaults, prior, learned agentusage.TierLimits) agentusage.TierLimits {
+	if defaults.RequestsPerMinute == nil {
+		prior.RequestsPerMinute = learned.RequestsPerMinute
+	}
+	if defaults.RequestsPerDay == nil {
+		prior.RequestsPerDay = learned.RequestsPerDay
+		prior.DailyReset = learned.DailyReset
+	}
+	if defaults.MaxConcurrentTurns == nil {
+		prior.MaxConcurrentTurns = learned.MaxConcurrentTurns
+	}
+	known := make(map[string]bool)
+	for _, budget := range defaults.Windows {
+		known[budget.Key()] = true
+	}
+	for _, budget := range learned.Windows {
+		if !known[budget.Key()] {
+			prior = agentusage.MergeTierLimits(prior, agentusage.TierLimits{Windows: []agentusage.LimitBudget{budget}})
+		}
+	}
+	prior.Learned = true
+	return prior
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_observations.go b/apps/backend/internal/backendapp/provider_tier_limit_observations.go
new file mode 100644
index 00000000000..7828bbb5e11
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_observations.go
@@ -0,0 +1,61 @@
+package backendapp
+
+import (
+	"context"
+	"encoding/json"
+	agentusage "github.com/kandev/kandev/internal/agent/usage"
+	sqliterepo "github.com/kandev/kandev/internal/task/repository/sqlite"
+	"math"
+	"time"
+)
+
+type observedTierWindow struct {
+	Requests     float64 `json:"requests"`
+	Turns        int64   `json:"turns"`
+	Tokens       int64   `json:"tokens"`
+	CostSubcents int64   `json:"cost_subcents"`
+}
+
+func (s *providerTierLimitService) snapshotLimitWindows(ctx context.Context, c tierLimitContext, at time.Time, observation *sqliterepo.UsageLimitObservation) (map[string]observedTierWindow, error) {
+	windows := make(map[string]observedTierWindow)
+	for _, period := range []string{"5h", "day", "week", "month"} {
+		start, _, _ := agentusage.LimitWindowBounds(at, agentusage.LimitBudget{Window: period, Reset: "rolling"})
+		if period == "day" {
+			start, _, _ = agentusage.DailyLimitWindow(at, c.effective.DailyReset)
+		}
+		if c.observed != nil {
+			for _, window := range c.observed.Windows {
+				if providerWindowPeriod(window) == period && !window.StartAt.IsZero() && window.ResetAt.After(at) {
+					start = window.StartAt
+					break
+				}
+			}
+		}
+		total, err := s.store.GetManualWindowUsageForProfiles(ctx, c.ids, start, at)
+		if err != nil {
+			return nil, err
+		}
+		windows[period] = observedTierWindow{Requests: math.Max(float64(total.EventCount), s.requests.count(c.ids, start, at)), Turns: total.TurnCount, Tokens: total.TokensTotal, CostSubcents: total.CostSubcents}
+	}
+	observation.Turns5h, observation.Tokens5h = windows["5h"].Turns, windows["5h"].Tokens
+	observation.TurnsDay, observation.TokensDay, observation.CostSubcentsDay = windows["day"].Turns, windows["day"].Tokens, windows["day"].CostSubcents
+	observation.TurnsWeek, observation.TokensWeek = windows["week"].Turns, windows["week"].Tokens
+	encoded, err := json.Marshal(windows)
+	observation.WindowUsageJSON = string(encoded)
+	return windows, err
+}
+
+func learningDimensionFor(tier agentusage.BillingTier, dimension string) string {
+	if tier == agentusage.TierSubscription && dimension == limitDimensionUnknown {
+		return "unknown_subscription"
+	}
+	return dimension
+}
+
+func learningTokenWindows(windows map[string]observedTierWindow) map[string]float64 {
+	values := make(map[string]float64)
+	for period, w := range windows {
+		values[period] = float64(w.Tokens)
+	}
+	return values
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_requests.go b/apps/backend/internal/backendapp/provider_tier_limit_requests.go
new file mode 100644
index 00000000000..bb13cc69a4b
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_requests.go
@@ -0,0 +1,105 @@
+package backendapp
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	runtimeapi "github.com/kandev/kandev/internal/agent/runtime"
+	"github.com/kandev/kandev/internal/events"
+	"github.com/kandev/kandev/internal/events/bus"
+	"sync"
+	"time"
+)
+
+type requestLimitObservation struct {
+	profile, key string
+	at           time.Time
+}
+type requestLimitObservations struct {
+	mu     sync.Mutex
+	events []requestLimitObservation
+	seen   map[string]time.Time
+}
+
+func (r *requestLimitObservations) count(ids []string, start, end time.Time) float64 {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	profiles := make(map[string]bool, len(ids))
+	for _, id := range ids {
+		profiles[id] = true
+	}
+	var count float64
+	for _, e := range r.events {
+		if profiles[e.profile] && !e.at.Before(start) && e.at.Before(end) {
+			count++
+		}
+	}
+	return count
+}
+
+func (r *requestLimitObservations) record(profile, key string, at time.Time) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.seen == nil {
+		r.seen = make(map[string]time.Time)
+	}
+	cutoff := at.Add(-24 * time.Hour)
+	for len(r.events) > 0 && r.events[0].at.Before(cutoff) {
+		delete(r.seen, r.events[0].key)
+		r.events = r.events[1:]
+	}
+	if _, exists := r.seen[key]; exists {
+		return
+	}
+	r.seen[key] = at
+	r.events = append(r.events, requestLimitObservation{profile: profile, key: key, at: at})
+}
+
+// Subscribe estimates response boundaries on the existing agent usage stream.
+// Assistant message identities are estimates, not HTTP request receipts.
+func (s *providerTierLimitService) Subscribe(eventBus bus.EventBus) (bus.Subscription, error) {
+	return eventBus.Subscribe(events.BuildAgentStreamWildcardSubject(), s.observeStreamRequests)
+}
+
+func (s *providerTierLimitService) observeStreamRequests(_ context.Context, event *bus.Event) error {
+	var payload runtimeapi.AgentStreamEventPayload
+	encoded, err := json.Marshal(event.Data)
+	if err != nil {
+		return nil
+	}
+	if json.Unmarshal(encoded, &payload) != nil || payload.Data == nil {
+		return nil
+	}
+	profile := payload.ExecutionProfileID
+	if profile == "" {
+		profile = payload.AgentProfileID
+	}
+	if profile == "" {
+		return nil
+	}
+	identity := streamRequestIdentity(payload)
+	if identity == "" {
+		return nil
+	}
+	at := event.Timestamp
+	if at.IsZero() {
+		at = time.Now()
+	}
+	key := fmt.Sprintf("%s:%s:%s:%d:%s", profile, payload.ExecutionID, payload.AttemptID, payload.Data.PromptGeneration, identity)
+	s.requests.record(profile, key, at)
+	return nil
+}
+
+func streamRequestIdentity(payload runtimeapi.AgentStreamEventPayload) string {
+	data := payload.Data
+	if data.UsageObservation != nil && data.UsageObservation.ProviderResponseID != "" {
+		return data.UsageObservation.ProviderResponseID
+	}
+	if payload.AgentType == codexAppServerAgentID || data.Type != "message" {
+		return ""
+	}
+	if data.ProtocolMessageID != "" {
+		return data.ProtocolMessageID
+	}
+	return data.MessageID
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_reset.go b/apps/backend/internal/backendapp/provider_tier_limit_reset.go
new file mode 100644
index 00000000000..f880e676128
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_reset.go
@@ -0,0 +1,33 @@
+package backendapp
+
+import (
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+	"regexp"
+	"strconv"
+	"time"
+)
+
+var rateResetHeader = regexp.MustCompile(`(?i)x-ratelimit-reset["'\\]*\s*[:=]\s*["'\\]*([0-9T:.+Z-]+)`)
+
+func minuteResetFromFailure(failure *routingerr.Error, now time.Time) time.Time {
+	if match := rateResetHeader.FindStringSubmatch(failure.RawExcerpt); len(match) == 2 {
+		if reset, ok := parseRateReset(match[1]); ok && reset.After(now) {
+			return reset
+		}
+	}
+	if failure.ResetHint != nil && failure.ResetHint.After(now) {
+		return *failure.ResetHint
+	}
+	return now.Add(time.Minute)
+}
+
+func parseRateReset(value string) (time.Time, bool) {
+	if n, err := strconv.ParseInt(value, 10, 64); err == nil {
+		if n > 100_000_000_000 {
+			return time.UnixMilli(n), true
+		}
+		return time.Unix(n, 0), true
+	}
+	reset, err := time.Parse(time.RFC3339, value)
+	return reset, err == nil
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_scopes.go b/apps/backend/internal/backendapp/provider_tier_limit_scopes.go
new file mode 100644
index 00000000000..6325b324a7a
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_scopes.go
@@ -0,0 +1,162 @@
+package backendapp
+
+import (
+	"context"
+	"sort"
+	"time"
+
+	agentusage "github.com/kandev/kandev/internal/agent/usage"
+)
+
+// limitDimensionModelDaily is a per-model daily allowance error. It learns the
+// model's request scope, never the account-wide daily allowance.
+const limitDimensionModelDaily = "model_daily"
+
+// readScopeUsage counts each scope's requests since its daily reset over the
+// tier's account profiles whose model the scope covers.
+func (s *providerTierLimitService) readScopeUsage(ctx context.Context, c tierLimitContext, now time.Time, used *agentusage.LimitUsage) error {
+	if len(c.effective.Scopes) == 0 {
+		return nil
+	}
+	used.Scopes = make(map[string]float64, len(c.effective.Scopes))
+	models := s.profileModels(ctx, c.ids)
+	for _, scope := range c.effective.Scopes {
+		start, reset, err := agentusage.DailyLimitWindow(now, scope.DailyReset)
+		if err != nil {
+			return err
+		}
+		used.Resets[agentusage.ScopeUsageKey(scope.ID)] = reset
+		ids := scopeProfileIDs(models, scope)
+		if len(ids) == 0 {
+			used.Scopes[scope.ID] = 0
+			continue
+		}
+		count, err := s.readRequestCount(ctx, ids, start, now)
+		if err != nil {
+			return err
+		}
+		used.Scopes[scope.ID] = count
+	}
+	return nil
+}
+
+func (s *providerTierLimitService) profileModels(ctx context.Context, ids []string) map[string]string {
+	models := make(map[string]string, len(ids))
+	for _, id := range ids {
+		if p, _, ok := s.usage.loadProfile(ctx, id); ok {
+			models[id] = p.Model
+		}
+	}
+	return models
+}
+
+func scopeProfileIDs(models map[string]string, scope agentusage.RequestScope) []string {
+	var ids []string
+	for id, model := range models {
+		if scope.Covers(model) {
+			ids = append(ids, id)
+		}
+	}
+	sort.Strings(ids)
+	return ids
+}
+
+// sameMinuteWindow bounds how far apart two per-model daily blocks may be to
+// count as one shared group allowance running out.
+const sameMinuteWindow = time.Minute
+
+// learnModelScope records the requests counted in the scope covering the
+// profile's model as that scope's learned value. A model without a scope gets
+// a learned model scope of its own; same-minute blocks of unconfigured models
+// form a provisional group instead.
+func (s *providerTierLimitService) learnModelScope(ctx context.Context, c tierLimitContext, used agentusage.LimitUsage, at time.Time) error {
+	models := s.profileModels(ctx, c.ids)
+	scope, counted, err := s.scopeToLearn(ctx, c, models, used, at)
+	if err != nil || counted <= 0 {
+		return err
+	}
+	tier := c.learned.Tiers[c.tier]
+	if scope.Provisional {
+		tier.Scopes = agentusage.WithoutLearnedModelScopes(tier.Scopes, scope.Models, ownerScopeIDs(c))
+	}
+	tier.Scopes = agentusage.LearnScope(tier.Scopes, scope, counted, at)
+	c.learned.Tiers[c.tier] = tier
+	return s.store.SaveAccountTierLearned(ctx, c.key, c.learned)
+}
+
+func (s *providerTierLimitService) scopeToLearn(ctx context.Context, c tierLimitContext, models map[string]string, used agentusage.LimitUsage, at time.Time) (agentusage.RequestScope, float64, error) {
+	if group, ok := s.sameMinuteGroup(ctx, c, models, at); ok {
+		counted, err := s.countScope(ctx, models, group, at)
+		return group, counted, err
+	}
+	if scope, ok := agentusage.CoveringScope(c.effective.Scopes, c.profile.Model); ok {
+		return scope, used.Scopes[scope.ID], nil
+	}
+	model := agentusage.ScopeModelID(c.profile.Model)
+	scope := agentusage.RequestScope{ID: agentusage.ModelScopeID(model), Kind: agentusage.ScopeKindModel, Models: []string{model}}
+	counted, err := s.countScope(ctx, models, scope, at)
+	return scope, counted, err
+}
+
+func (s *providerTierLimitService) countScope(ctx context.Context, models map[string]string, scope agentusage.RequestScope, at time.Time) (float64, error) {
+	start, _, err := agentusage.DailyLimitWindow(at, scope.DailyReset)
+	if err != nil {
+		return 0, err
+	}
+	return s.readRequestCount(ctx, scopeProfileIDs(models, scope), start, at)
+}
+
+// sameMinuteGroup finds other unconfigured models of the account whose
+// per-model daily block was observed within a minute of this one. Observation
+// read errors fall back to model learning.
+func (s *providerTierLimitService) sameMinuteGroup(ctx context.Context, c tierLimitContext, models map[string]string, at time.Time) (agentusage.RequestScope, bool) {
+	configured := configuredScopes(c)
+	if agentusage.ConfiguredScopeCovers(configured, c.profile.Model) {
+		return agentusage.RequestScope{}, false
+	}
+	observations, err := s.store.ListUsageLimitObservationsSince(ctx, at.Add(-sameMinuteWindow))
+	if err != nil {
+		return agentusage.RequestScope{}, false
+	}
+	var partners []string
+	for _, o := range observations {
+		if o.AccountKey != c.key || o.Dimension != limitDimensionModelDaily || o.ExecutionProfileID == c.profile.ID || o.ObservedAt.After(at.Add(sameMinuteWindow)) {
+			continue
+		}
+		if model, ok := models[o.ExecutionProfileID]; ok && !agentusage.ConfiguredScopeCovers(configured, model) {
+			partners = append(partners, model)
+		}
+	}
+	return agentusage.ProvisionalGroupFor(c.learned.Tiers[c.tier].Scopes, c.profile.Model, partners)
+}
+
+// configuredScopes are catalog defaults and every scope the owner set. An
+// owner entry that carries only an ID (the card's value or reset edit of a
+// learned scope) resolves to the current scope definition, so its models stay
+// configured and keep their owner value instead of being grouped.
+func configuredScopes(c tierLimitContext) []agentusage.RequestScope {
+	configured := append([]agentusage.RequestScope(nil), c.defaults.Scopes...)
+	for _, scope := range c.owner.Tiers[c.tier].Scopes {
+		if scope.Kind != "" && len(scope.Models) > 0 {
+			configured = append(configured, scope)
+			continue
+		}
+		for _, effective := range c.effective.Scopes {
+			if effective.ID == scope.ID && len(effective.Models) > 0 {
+				configured = append(configured, effective)
+				break
+			}
+		}
+	}
+	return configured
+}
+
+// ownerScopeIDs are the scope IDs the owner set; their learned definitions
+// must survive so the owner entry keeps covering its models.
+func ownerScopeIDs(c tierLimitContext) map[string]bool {
+	ids := make(map[string]bool)
+	for _, scope := range c.owner.Tiers[c.tier].Scopes {
+		ids[scope.ID] = true
+	}
+	return ids
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limit_usage.go b/apps/backend/internal/backendapp/provider_tier_limit_usage.go
new file mode 100644
index 00000000000..aa556267be4
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limit_usage.go
@@ -0,0 +1,188 @@
+package backendapp
+
+import (
+	"context"
+	agentusage "github.com/kandev/kandev/internal/agent/usage"
+	sqliterepo "github.com/kandev/kandev/internal/task/repository/sqlite"
+	"math"
+	"time"
+)
+
+func (s *providerTierLimitService) readUsage(ctx context.Context, c tierLimitContext, exclude string, now time.Time) (agentusage.LimitUsage, error) {
+	used := agentusage.LimitUsage{Windows: make(map[string]float64), Resets: make(map[string]time.Time), Estimated: true}
+	active, err := s.store.CountLimitActiveTurns(ctx, c.ids, exclude)
+	if err != nil {
+		return used, err
+	}
+	used.ActiveTurns = active
+	if err := s.readRequestUsage(ctx, c, now, &used); err != nil {
+		return used, err
+	}
+	for _, budget := range c.effective.Windows {
+		amount, reset, known, err := s.readBudgetUsage(ctx, c, budget, now)
+		if err != nil {
+			return used, err
+		}
+		if known {
+			used.Windows[budget.Key()] = amount
+			used.Resets[budget.Key()] = reset
+		}
+	}
+	if err := s.readScopeUsage(ctx, c, now, &used); err != nil {
+		return used, err
+	}
+	return used, nil
+}
+
+func (s *providerTierLimitService) readRequestUsage(ctx context.Context, c tierLimitContext, now time.Time, used *agentusage.LimitUsage) error {
+	ids := s.minuteProfiles(ctx, c)
+	var err error
+	used.RequestsMinute, err = s.readRequestCount(ctx, ids, now.Add(-time.Minute), now)
+	if err != nil {
+		return err
+	}
+	start, reset, err := agentusage.DailyLimitWindow(now, c.effective.DailyReset)
+	if err != nil {
+		return err
+	}
+	day, err := s.store.GetManualWindowUsageForProfiles(ctx, c.ids, start, now)
+	if err != nil {
+		return err
+	}
+	used.RequestsDay = math.Max(float64(day.EventCount), s.requests.count(c.ids, start, now))
+	used.TurnsDay = day.TurnCount
+	used.TokensDay = day.TokensTotal
+	used.Resets["day"] = reset
+	if c.effective.RequestWindowSeconds > 0 {
+		used.RequestsWindow, err = s.readRequestCount(ctx, ids, now.Add(-time.Duration(c.effective.RequestWindowSeconds)*time.Second), now)
+		if err != nil {
+			return err
+		}
+	}
+	if c.tier == agentusage.TierFree && c.observed != nil && c.observed.FreeModelDailyRequests != nil && !c.observed.FetchedAt.Before(start) {
+		counter := c.observed.FreeModelDailyRequests
+		used.RequestsDay = counter.Used
+		if counter.Remaining == 0 && c.effective.RequestsPerDay != nil {
+			used.RequestsDay = math.Max(used.RequestsDay, *c.effective.RequestsPerDay)
+		}
+	}
+	return nil
+}
+
+func (s *providerTierLimitService) minuteProfiles(ctx context.Context, c tierLimitContext) []string {
+	if !c.effective.RequestsPerModel {
+		return c.ids
+	}
+	var ids []string
+	for _, id := range c.ids {
+		p, _, ok := s.usage.loadProfile(ctx, id)
+		if ok && p.Model == c.profile.Model {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+func (s *providerTierLimitService) readRequestCount(ctx context.Context, ids []string, start, end time.Time) (float64, error) {
+	totals, err := s.store.GetManualWindowUsageForProfiles(ctx, ids, start, end)
+	return math.Max(float64(totals.EventCount), s.requests.count(ids, start, end)), err
+}
+
+func (s *providerTierLimitService) readBudgetUsage(ctx context.Context, c tierLimitContext, budget agentusage.LimitBudget, now time.Time) (float64, time.Time, bool, error) {
+	if budget.Unit == "percent" {
+		window, ok := findProviderBudget(c.observed, budget)
+		if !ok {
+			return 0, time.Time{}, false, nil
+		}
+		if !window.ResetAt.IsZero() && !window.ResetAt.After(now) {
+			return 0, time.Time{}, false, nil
+		}
+		amount := window.UtilizationPct
+		if window.LimitReached {
+			amount = math.Max(100, amount)
+		}
+		return amount, window.ResetAt, true, nil
+	}
+	start, reset, ok := agentusage.LimitWindowBounds(now, budget)
+	if budget.Reset == "provider" {
+		if window, found := findProviderBudget(c.observed, budget); found && !window.StartAt.IsZero() && window.ResetAt.After(now) {
+			start, reset, ok = window.StartAt, window.ResetAt, true
+		}
+	}
+	if !ok {
+		return 0, time.Time{}, false, nil
+	}
+	ids := s.budgetProfileIDs(ctx, c, budget)
+	if len(ids) == 0 {
+		return 0, time.Time{}, false, nil
+	}
+	total, err := s.store.GetManualWindowUsageForProfiles(ctx, ids, start, now)
+	return budgetAmount(total, budget.Unit), reset, true, err
+}
+
+func findProviderBudget(observed *agentusage.ProviderUsage, b agentusage.LimitBudget) (agentusage.UtilizationWindow, bool) {
+	if observed != nil {
+		for _, w := range observed.Windows {
+			if providerWindowPeriod(w) == b.Window && string(w.Scope) == b.Scope {
+				return w, true
+			}
+		}
+	}
+	return agentusage.UtilizationWindow{}, false
+}
+
+func budgetAmount(total sqliterepo.ManualWindowUsage, unit string) float64 {
+	switch unit {
+	case "usd":
+		return float64(total.CostSubcents) / subcentsPerDollar
+	case "tokens":
+		return float64(total.TokensTotal)
+	case "turns":
+		return float64(total.TurnCount)
+	default:
+		return float64(total.EventCount)
+	}
+}
+
+func (s *providerTierLimitService) budgetProfileIDs(ctx context.Context, c tierLimitContext, b agentusage.LimitBudget) []string {
+	if b.Scope != string(agentusage.WindowScopePremiumModels) {
+		return c.ids
+	}
+	var ids []string
+	for _, id := range c.ids {
+		if s.usage.ProfileUsage(ctx, id).ModelClass == agentusage.ModelClassPremium {
+			ids = append(ids, id)
+		}
+	}
+	return ids
+}
+
+func (s *providerTierLimitService) windowReset(ctx context.Context, id, period string, now time.Time, exhaustedOnly bool) (time.Time, bool) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	c, err := s.contextFor(ctx, id)
+	if err != nil {
+		return time.Time{}, false
+	}
+	used, err := s.readUsage(ctx, c, "", now)
+	if err != nil {
+		return time.Time{}, false
+	}
+	var latest time.Time
+	for _, budget := range c.effective.Windows {
+		if period != "" && budget.Window != period {
+			continue
+		}
+		if exhaustedOnly && (budget.Value == nil || used.Windows[budget.Key()] < *budget.Value) {
+			continue
+		}
+		reset := used.Resets[budget.Key()]
+		if !reset.After(now) {
+			_, reset, _ = agentusage.LimitWindowBounds(now, budget)
+		}
+		if reset.After(latest) {
+			latest = reset
+		}
+	}
+	return latest, latest.After(now)
+}
diff --git a/apps/backend/internal/backendapp/provider_tier_limits.go b/apps/backend/internal/backendapp/provider_tier_limits.go
new file mode 100644
index 00000000000..76cabc23e71
--- /dev/null
+++ b/apps/backend/internal/backendapp/provider_tier_limits.go
@@ -0,0 +1,349 @@
+package backendapp
+
+import (
+	"context"
+	"fmt"
+	dynamicruntime "github.com/kandev/kandev/internal/agent/runtime/dynamic"
+	"github.com/kandev/kandev/internal/agent/settings/controller"
+	settingsmodels "github.com/kandev/kandev/internal/agent/settings/models"
+	agentusage "github.com/kandev/kandev/internal/agent/usage"
+	sqliterepo "github.com/kandev/kandev/internal/task/repository/sqlite"
+	"strings"
+	"sync"
+	"time"
+)
+
+type tierLimitStore interface {
+	LoadAccountTierConfig(context.Context, string) (agentusage.AccountTierConfig, agentusage.AccountTierConfig, error)
+	SaveAccountTierOverrides(context.Context, string, agentusage.AccountTierConfig) error
+	SaveAccountTierLearned(context.Context, string, agentusage.AccountTierConfig) error
+	CountLimitActiveTurns(context.Context, []string, string) (int64, error)
+	GetManualWindowUsageForProfiles(context.Context, []string, time.Time, time.Time) (sqliterepo.ManualWindowUsage, error)
+	InsertUsageLimitObservation(context.Context, sqliterepo.UsageLimitObservation) error
+	ListUsageLimitObservationsSince(context.Context, time.Time) ([]sqliterepo.UsageLimitObservation, error)
+}
+
+type providerTierLimitService struct {
+	freeModels interface {
+		IsFreeModel(context.Context, string) (bool, bool)
+	}
+	store      tierLimitStore
+	usage      *usageProviderAdapter
+	learningMu sync.Mutex
+	requests   requestLimitObservations
+}
+
+type tierLimitContext struct {
+	profile             *settingsmodels.AgentProfile
+	provider            string
+	key                 string
+	identity            accountIdentity
+	tier                agentusage.BillingTier
+	owner, learned      agentusage.AccountTierConfig
+	observed            *agentusage.ProviderUsage
+	defaults, effective agentusage.TierLimits
+	ids                 []string
+}
+
+var billingTiers = []agentusage.BillingTier{agentusage.TierFree, agentusage.TierSubscription, agentusage.TierPaid}
+
+func newProviderTierLimitService(usage *usageProviderAdapter, store tierLimitStore) *providerTierLimitService {
+	return &providerTierLimitService{store: store, usage: usage}
+}
+
+func (s *providerTierLimitService) contextFor(ctx context.Context, id string) (tierLimitContext, error) {
+	var c tierLimitContext
+	profile, agentType, ok := s.usage.loadProfile(ctx, id)
+	if !ok {
+		return c, fmt.Errorf("profile unavailable")
+	}
+	bound, ok := s.usage.bindingFor(profile, agentType)
+	if !ok {
+		return c, fmt.Errorf("account unavailable")
+	}
+	c.profile = profile
+	c.key = bound.accountKey
+	c.identity = accountIdentityFor(c.key)
+	c.provider = dynamicruntime.ProviderOf(profile.Model)
+	if c.provider == "" {
+		c.provider = strings.SplitN(c.key, ":", 2)[0]
+	}
+	var err error
+	c.owner, c.learned, err = s.store.LoadAccountTierConfig(ctx, c.key)
+	if err != nil {
+		return c, err
+	}
+	observed := s.usage.ProfileUsage(ctx, id)
+	c.observed = observed.Usage
+	c.tier = s.effectiveBillingTier(ctx, profile, agentType, observed, c.owner)
+	c.defaults = s.defaultLimits(c)
+	c.effective = agentusage.MergeTierLimits(agentusage.MergeTierLimits(c.defaults, c.learned.Tiers[c.tier]), c.owner.Tiers[c.tier])
+	c.ids = s.accountTierProfiles(ctx, c)
+	return c, nil
+}
+
+func (s *providerTierLimitService) effectiveBillingTier(ctx context.Context, p *settingsmodels.AgentProfile, a string, observed profileUsage, owner agentusage.AccountTierConfig) agentusage.BillingTier {
+	if override := owner.ProfileTiers[p.ID]; validBillingTier(override) {
+		return override
+	}
+	return s.billingTier(ctx, p, a, observed)
+}
+
+func (s *providerTierLimitService) defaultLimits(c tierLimitContext) agentusage.TierLimits {
+	purchased := c.owner.PurchasedCredits != nil && *c.owner.PurchasedCredits
+	plan := ""
+	if c.observed != nil {
+		plan = c.observed.Plan
+		if counter := c.observed.FreeModelDailyRequests; counter != nil && counter.Limit >= 1000 {
+			purchased = true
+		}
+	}
+	if c.provider == accountPrefixOpenCodeGo {
+		plan = c.owner.SubscriptionPlan
+	}
+	defaults := agentusage.DefaultTierLimits(c.provider, c.tier, plan, purchased)
+	if c.tier == agentusage.TierFree && c.observed != nil && c.observed.FreeModelDailyRequests != nil {
+		v := c.observed.FreeModelDailyRequests.Limit
+		defaults.RequestsPerDay = &v
+		defaults.Provenance = withProvenance(defaults.Provenance, "requests_per_day", agentusage.ProvenanceProvider)
+	}
+	if c.tier == agentusage.TierSubscription {
+		defaults.Windows = appendProviderBudgets(defaults.Windows, c.observed)
+	}
+	return defaults
+}
+
+func withProvenance(labels map[string]string, field, provenance string) map[string]string {
+	result := make(map[string]string, len(labels)+1)
+	for key, value := range labels {
+		result[key] = value
+	}
+	result[field] = provenance
+	return result
+}
+
+func (s *providerTierLimitService) accountTierProfiles(ctx context.Context, c tierLimitContext) []string {
+	ids, err := s.usage.AccountProfileIDs(ctx, c.profile.ID)
+	if err != nil {
+		return []string{c.profile.ID}
+	}
+	var result []string
+	for _, id := range ids {
+		p, a, ok := s.usage.loadProfile(ctx, id)
+		if !ok {
+			continue
+		}
+		observed := s.usage.ProfileUsage(ctx, id)
+		if s.effectiveBillingTier(ctx, p, a, observed, c.owner) == c.tier {
+			result = append(result, id)
+		}
+	}
+	if len(result) == 0 {
+		return []string{c.profile.ID}
+	}
+	return result
+}
+
+func inferBillingTier(profile *settingsmodels.AgentProfile, agentType string, observed profileUsage) agentusage.BillingTier {
+	if dynamicruntime.IsFreeModel(profile.Model) || observed.ModelClass == agentusage.ModelClassFree {
+		return agentusage.TierFree
+	}
+	if subscriptionProvider(profile.Model, observed) {
+		return agentusage.TierSubscription
+	}
+	if profile.BillingType == "subscription" {
+		return agentusage.TierSubscription
+	}
+	if profile.ProviderKind != "" || profile.BillingType == "api_key" {
+		return agentusage.TierPaid
+	}
+	switch agentType {
+	case claudeACPAgentID, codexACPAgentID, codexAppServerAgentID, antigravityAgentID:
+		return agentusage.TierSubscription
+	}
+	if strings.Contains(agentType, "gemini") {
+		return agentusage.TierSubscription
+	}
+	return agentusage.TierPaid
+}
+
+func subscriptionProvider(model string, observed profileUsage) bool {
+	provider := dynamicruntime.ProviderOf(model)
+	if provider == accountPrefixOpenCodeGo {
+		return true
+	}
+	return provider == accountPrefixLLMGateway && observed.Usage != nil && observed.Usage.Plan != "" && observed.Usage.Plan != "none"
+}
+
+func validBillingTier(tier agentusage.BillingTier) bool {
+	return tier == agentusage.TierFree || tier == agentusage.TierSubscription || tier == agentusage.TierPaid
+}
+
+func (s *providerTierLimitService) billingTier(ctx context.Context, p *settingsmodels.AgentProfile, a string, observed profileUsage) agentusage.BillingTier {
+	if s.freeModels != nil {
+		if free, known := s.freeModels.IsFreeModel(ctx, p.Model); known && free {
+			observed.ModelClass = agentusage.ModelClassFree
+		}
+	}
+	if bound, ok := s.usage.bindingFor(p, a); ok {
+		if credentials, ok := bound.client.(interface{ HasSubscriptionCredentials() bool }); ok && !credentials.HasSubscriptionCredentials() && observed.Usage == nil && p.BillingType == "" && p.ProviderKind == "" {
+			if a == claudeACPAgentID || a == codexACPAgentID || a == codexAppServerAgentID {
+				return agentusage.TierPaid
+			}
+		}
+	}
+	return inferBillingTier(p, a, observed)
+}
+
+func appendProviderBudgets(budgets []agentusage.LimitBudget, observed *agentusage.ProviderUsage) []agentusage.LimitBudget {
+	if observed == nil {
+		return budgets
+	}
+	for _, w := range observed.Windows {
+		period := providerWindowPeriod(w)
+		if period == "" {
+			continue
+		}
+		found := false
+		for _, b := range budgets {
+			if b.Window == period && b.Scope == string(w.Scope) {
+				found = true
+			}
+		}
+		if found {
+			continue
+		}
+		v := 100.0
+		b := agentusage.LimitBudget{Window: period, Unit: "percent", Value: &v, Reset: "provider", Scope: string(w.Scope)}
+		if !w.ResetAt.IsZero() {
+			at := w.ResetAt
+			b.ResetAt = &at
+		}
+		budgets = append(budgets, b)
+	}
+	return budgets
+}
+
+func providerWindowPeriod(w agentusage.UtilizationWindow) string {
+	label := strings.ToLower(w.Label)
+	switch {
+	case strings.Contains(label, "month") || w.DurationSeconds >= 27*24*3600:
+		return "month"
+	case strings.Contains(label, "week") || strings.Contains(label, "7-day") || w.DurationSeconds >= 7*24*3600:
+		return "week"
+	case strings.Contains(label, "5-hour") || strings.Contains(label, "five_hour") || w.DurationSeconds == 5*3600:
+		return "5h"
+	case strings.Contains(label, "day") || w.DurationSeconds == 24*3600:
+		return "day"
+	}
+	return ""
+}
+
+func (s *providerTierLimitService) Check(ctx context.Context, id, exclude string, now time.Time) (agentusage.LimitAdmission, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	c, err := s.contextFor(ctx, id)
+	if err != nil {
+		return agentusage.LimitAdmission{}, err
+	}
+	used, err := s.readUsage(ctx, c, exclude, now)
+	if err != nil {
+		return agentusage.LimitAdmission{}, err
+	}
+	if admission := agentusage.EvaluateTierLimits(c.effective, used, now); admission.Reason != "" {
+		return admission, nil
+	}
+	return agentusage.EvaluateScopeLimits(c.effective.Scopes, c.profile.Model, used, now), nil
+}
+
+func (s *providerTierLimitService) ListAccounts(ctx context.Context) (map[string][]controller.ProviderAccountLimitDTO, error) {
+	profiles, err := s.usage.boundProfiles(ctx)
+	if err != nil {
+		return nil, err
+	}
+	result := make(map[string][]controller.ProviderAccountLimitDTO)
+	byKey := make(map[string]*controller.ProviderAccountLimitDTO)
+	providers := make(map[string]string)
+	for _, bound := range profiles {
+		c, err := s.contextFor(ctx, bound.profile.ID)
+		if err != nil {
+			continue
+		}
+		account := byKey[c.key]
+		if account == nil {
+			account = &controller.ProviderAccountLimitDTO{AccountID: c.identity.ID, AccountKind: c.identity.Kind, Overrides: c.owner, Tiers: make(map[agentusage.BillingTier]controller.ProviderTierLimitDTO)}
+			byKey[c.key] = account
+			providers[c.key] = c.provider
+		}
+		account.Profiles = append(account.Profiles, controller.ProviderTierProfileDTO{ID: c.profile.ID, Name: c.profile.Name, Tier: c.tier, Model: agentusage.ScopeModelID(c.profile.Model)})
+		used, _ := s.readUsage(ctx, c, "", time.Now())
+		account.Tiers[c.tier] = controller.ProviderTierLimitDTO{Defaults: c.defaults, Learned: c.learned.Tiers[c.tier], Override: c.owner.Tiers[c.tier], Effective: c.effective, Usage: used}
+		for _, tier := range billingTiers {
+			if _, ok := account.Tiers[tier]; !ok {
+				defaults := agentusage.DefaultTierLimits(c.provider, tier, "", c.owner.PurchasedCredits != nil && *c.owner.PurchasedCredits)
+				effective := agentusage.MergeTierLimits(agentusage.MergeTierLimits(defaults, c.learned.Tiers[tier]), c.owner.Tiers[tier])
+				account.Tiers[tier] = controller.ProviderTierLimitDTO{Defaults: defaults, Learned: c.learned.Tiers[tier], Override: c.owner.Tiers[tier], Effective: effective}
+			}
+		}
+	}
+	for key, account := range byKey {
+		result[providers[key]] = append(result[providers[key]], *account)
+	}
+	return result, nil
+}
+
+func (s *providerTierLimitService) UpdateAccount(ctx context.Context, provider, id string, config agentusage.AccountTierConfig) error {
+	profiles, err := s.usage.boundProfiles(ctx)
+	if err != nil {
+		return err
+	}
+	for tier, limits := range config.Tiers {
+		limits = ownerTierLimits(limits)
+		config.Tiers[tier] = limits
+		if !validBillingTier(tier) {
+			return fmt.Errorf("%w: invalid billing tier", controller.ErrInvalidProviderLimit)
+		}
+		if err := agentusage.ValidateTierLimits(limits); err != nil {
+			return fmt.Errorf("%w: %v", controller.ErrInvalidProviderLimit, err)
+		}
+	}
+	for _, tier := range config.ProfileTiers {
+		if !validBillingTier(tier) {
+			return fmt.Errorf("%w: invalid profile tier", controller.ErrInvalidProviderLimit)
+		}
+	}
+	for _, bound := range profiles {
+		identity := accountIdentityFor(bound.binding.accountKey)
+		p := dynamicruntime.ProviderOf(bound.profile.Model)
+		if p == "" {
+			p = strings.SplitN(bound.binding.accountKey, ":", 2)[0]
+		}
+		if identity.ID != id || p != provider {
+			continue
+		}
+		allowed := make(map[string]bool)
+		for _, b := range profiles {
+			if b.binding.accountKey == bound.binding.accountKey {
+				allowed[b.profile.ID] = true
+			}
+		}
+		for profileID := range config.ProfileTiers {
+			if !allowed[profileID] {
+				return fmt.Errorf("%w: profile is not on this account", controller.ErrInvalidProviderLimit)
+			}
+		}
+		return s.store.SaveAccountTierOverrides(ctx, bound.binding.accountKey, config)
+	}
+	return fmt.Errorf("%w: account unavailable", controller.ErrInvalidProviderLimit)
+}
+
+func ownerTierLimits(limits agentusage.TierLimits) agentusage.TierLimits {
+	limits.Learned = false
+	for i := range limits.Windows {
+		limits.Windows[i].Learned = false
+		limits.Windows[i].WindowEstimated = false
+	}
+	limits.Scopes = agentusage.OwnerScopes(limits.Scopes)
+	limits.Provenance = nil
+	return limits
+}
diff --git a/apps/backend/internal/backendapp/review_launch_test.go b/apps/backend/internal/backendapp/review_launch_test.go
new file mode 100644
index 00000000000..0c4a494d74a
--- /dev/null
+++ b/apps/backend/internal/backendapp/review_launch_test.go
@@ -0,0 +1,29 @@
+package backendapp
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	utility "github.com/kandev/kandev/internal/agentctl/server/utility"
+	"github.com/kandev/kandev/internal/review"
+)
+
+type reviewLaunchResponse struct{ response *utility.PromptResponse }
+
+func (f reviewLaunchResponse) ExecuteInferencePrompt(context.Context, string, string, string, string) (*utility.PromptResponse, error) {
+	return f.response, nil
+}
+func (f reviewLaunchResponse) ExecuteInferenceProfilePrompt(context.Context, string, string, string) (*utility.PromptResponse, error) {
