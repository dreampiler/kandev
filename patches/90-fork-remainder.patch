index 00000000000..a53a0ae56b5
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/turn_admission_test.go
@@ -0,0 +1,241 @@
+package dynamic
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type mutableAdmissionUsage struct {
+	fixedUsage
+	full bool
+}
+
+type selectionAdmissionUsage struct {
+	fixedUsage
+	capacity     atomic.Int32
+	block        bool
+	entered      chan struct{}
+	release      chan struct{}
+	selected     chan struct{}
+	selectedOnce sync.Once
+}
+
+func (u *selectionAdmissionUsage) CheckAdmission(_ context.Context, _ Candidate, sessionID string, now time.Time) (PaceScore, error) {
+	used := u.capacity.Load()
+	if u.block && sessionID == "retained" {
+		close(u.entered)
+		<-u.release
+	}
