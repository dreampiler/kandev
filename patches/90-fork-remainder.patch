+package client
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/kandev/kandev/internal/agentctl/types/streams"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+func TestUpdateStreamStageBlockedHandlerKeepsReadProgress(t *testing.T) {
+	stage := newUpdateStreamStage()
+	stage.recordRead()
+	before := stage.snapshot()
+	if before.ReadCount != 1 || before.Pending != 1 || before.HandledCount != 0 {
+		t.Fatalf("blocked worker snapshot = %#v, want one unread handler item", before)
+	}
+	stage.recordRead()
+	stage.recordHandled()
+	after := stage.snapshot()
+	if after.ReadCount != 2 || after.HandledCount != 1 || after.Pending != 1 {
+		t.Fatalf("continuing reader snapshot = %#v, want one pending item", after)
+	}
+}
+
+func TestUpdateStreamStageHeartbeatIsNotTurnProgress(t *testing.T) {
+	stage := newUpdateStreamStage()
+	payload, err := json.Marshal(streams.UpdateStreamStageHeartbeat{AdapterSeen: 3, WriterSent: 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg := ws.Message{Type: ws.MessageTypeNotification, Action: streams.UpdateStreamStageAction, Payload: payload}
+	client := &Client{}
+	if !client.consumeUpdateStreamMetadata(stage, msg) {
+		t.Fatal("stage heartbeat was not recognized")
+	}
+	snapshot := stage.snapshot()
+	if snapshot.ReadCount != 0 || snapshot.HandledCount != 0 || snapshot.HeartbeatAgeMillis < 0 {
+		t.Fatalf("heartbeat changed turn-event progress or was not recorded: %#v", snapshot)
+	}
+	if snapshot.AgentctlStage.WriterSent != 2 {
+		t.Fatalf("agentctl stage = %#v", snapshot.AgentctlStage)
+	}
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/account_block_test.go b/apps/backend/internal/agent/runtime/dynamic/account_block_test.go
new file mode 100644
index 00000000000..e0a81a88bae
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/account_block_test.go
@@ -0,0 +1,251 @@
+package dynamic
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+	"github.com/kandev/kandev/internal/agent/runtime/routingpolicy"
+)
+
+func accountBlockedFailure() *routingerr.Error {
+	return routingerr.Classify(routingerr.Input{
+		Phase: routingerr.PhasePromptSend,
+		Stderr: `Error from provider meta-contributor: 403 Forbidden {"error":{"code":"user_blocked",` +
+			`"message":"Your access has been restricted due to repeated policy violations."}}`,
+	})
+}
+
+// accountBlockProfile has a blocked candidate, a sibling on the same
+// credential binding, and an unrelated candidate, in that order.
+func accountBlockProfile(hard routingpolicy.Policy) Profile {
+	policies := routingpolicy.DefaultDocument()
+	policies.Hard = hard
+	return Profile{
+		ID: "dynamic-account-block", Version: 1,
+		Candidates: []Candidate{
+			{ID: "blocked", Enabled: true, BindingKey: "credential:shared", Policies: policies},
+			{ID: "sibling", Enabled: true, BindingKey: "credential:shared", Policies: policies},
+			{ID: "other", Enabled: true, BindingKey: "credential:other", Policies: policies},
+		},
+	}
+}
+
+func holdAccount(t *testing.T, engine *Engine, profile Profile, sessionID string) RouteDecision {
+	t.Helper()
+	initial, err := engine.Select(sessionID, profile, 0, "")
+	if err != nil || initial.ExecutionProfileID != "blocked" {
+		t.Fatalf("initial selection = %#v, %v; want blocked", initial, err)
+	}
+	decision, err := engine.ApplyFailure(sessionID, profile, initial.Generation, initial.ExecutionProfileID, accountBlockedFailure())
+	if err != nil {
+		t.Fatalf("ApplyFailure: %v", err)
+	}
+	return decision
+}
+
+func TestAccountBlockedHoldsOnlyFailingProfile(t *testing.T) {
+	now := time.Unix(1000, 0)
+	engine := NewEngine(WithClock(func() time.Time { return now }))
+	hard := routingpolicy.DefaultPolicy()
+	hard.Retry = routingpolicy.RetryPolicy{Enabled: true, MaxRetries: 3, InitialIntervalSeconds: 5}
+	profile := accountBlockProfile(hard)
+
+	decision := holdAccount(t, engine, profile, "session-a")
+
+	if decision.ExecutionProfileID != "sibling" || decision.Reason != "policy_skip" ||
+		decision.ErrorCode != routingerr.CodeAccountBlocked {
+		t.Fatalf("decision = %#v, want the credential-sharing sibling by policy_skip", decision)
+	}
+	if engine.Circuits().IsOpen("credential:shared", now) {
+		t.Fatal("account block opened the shared credential circuit")
+	}
+	if !engine.Circuits().IsOpen(accountBlockKey("blocked"), now) {
+		t.Fatal("account block did not hold the failing profile")
+	}
+	for _, id := range []string{"sibling", "other"} {
+		if engine.Circuits().IsOpen(accountBlockKey(id), now) {
+			t.Fatalf("account block held %s", id)
+		}
+	}
+	fresh, err := engine.Select("session-b", profile, 0, "")
+	if err != nil || fresh.ExecutionProfileID != "sibling" {
+		t.Fatalf("fresh selection = %#v, %v; want sibling, the next candidate in order", fresh, err)
+	}
+	if suspension := engine.SuspensionFor(profile.Candidates[0], now); !suspension.Blocked() ||
+		suspension.Scope != SuspensionScopeProfile || suspension.Code != routingerr.CodeAccountBlocked ||
+		!suspension.Until.IsZero() {
+		t.Fatalf("held suspension = %#v, want blocked profile scope without end time", suspension)
+	}
+	if suspension := engine.SuspensionFor(profile.Candidates[1], now); suspension.Blocked() {
+		t.Fatalf("sibling suspension = %#v, want available", suspension)
+	}
+}
+
+func TestAccountBlockedStopOutcomeStillHolds(t *testing.T) {
+	now := time.Unix(1000, 0)
+	engine := NewEngine(WithClock(func() time.Time { return now }))
+	stop := routingpolicy.DefaultPolicy()
+	stop.OnExhausted = routingpolicy.OutcomeStop
+	profile := accountBlockProfile(stop)
+	initial, err := engine.Select("session-stop", profile, 0, "")
+	if err != nil {
+		t.Fatalf("Select: %v", err)
+	}
+
+	decision, err := engine.ApplyFailure("session-stop", profile, initial.Generation, "blocked", accountBlockedFailure())
+
+	if !errors.Is(err, ErrNoEligibleCandidate) || decision.Status != routeStatusActionRequired ||
+		decision.ExecutionProfileID != "blocked" {
+		t.Fatalf("decision = %#v, %v; want manual recovery on the failed candidate", decision, err)
+	}
+	if !engine.Circuits().IsOpen(accountBlockKey("blocked"), now) {
+		t.Fatal("stop outcome did not hold the failing profile")
+	}
+	fresh, err := engine.Select("session-next", profile, 0, "")
+	if err != nil || fresh.ExecutionProfileID != "sibling" {
+		t.Fatalf("fresh selection = %#v, %v; want sibling", fresh, err)
+	}
+}
+
+func TestAccountBlockedHoldHasNoExpiryOrProbe(t *testing.T) {
+	now := time.Unix(1000, 0)
+	engine := NewEngine(WithClock(func() time.Time { return now }))
+	profile := accountBlockProfile(routingpolicy.DefaultPolicy())
+	holdAccount(t, engine, profile, "session-a")
+	key := accountBlockKey("blocked")
+
+	now = now.Add(400 * 24 * time.Hour)
+	if _, ok := engine.Circuits().AcquireProbe(key, time.Minute); ok {
+		t.Fatal("held circuit granted a probe")
+	}
+	engine.RecordResourceSuccess(profile.Candidates[0])
+	engine.Circuits().Open(key, now.Add(time.Minute), routingerr.CodeRateLimited)
+	if status := engine.Circuits().Inspect(key, now); status.State != ResourceWaiting ||
+		status.Code != routingerr.CodeAccountBlocked || !status.Until.IsZero() {
+		t.Fatalf("hold after a year, output, and a timed failure = %#v, want held", status)
+	}
+	later, err := engine.Select("session-later", profile, 0, "")
+	if err != nil || later.ExecutionProfileID != "sibling" {
+		t.Fatalf("selection after a year = %#v, %v; want sibling", later, err)
+	}
+}
+
+func TestAccountBlockedHoldSurvivesRestore(t *testing.T) {
+	now := time.Unix(1000, 0)
+	store := newStubCircuitPersistence()
+	clock := WithCircuitClock(func() time.Time { return now })
+	engine := NewEngine(WithClock(func() time.Time { return now }),
+		WithCircuitRegistry(NewCircuitRegistry(WithCircuitPersistence(store), clock)))
+	profile := accountBlockProfile(routingpolicy.DefaultPolicy())
+	holdAccount(t, engine, profile, "session-a")
+
+	restored := NewCircuitRegistry(WithCircuitPersistence(store), clock)
+	if err := restored.Restore(context.Background()); err != nil {
+		t.Fatalf("Restore: %v", err)
+	}
+	now = now.Add(30 * 24 * time.Hour)
+	if !restored.IsOpen(accountBlockKey("blocked"), now) {
+		t.Fatal("hold did not survive restart")
+	}
+	if _, ok := restored.AcquireProbe(accountBlockKey("blocked"), time.Minute); ok {
+		t.Fatal("restored hold granted a probe")
+	}
+}
+
+func TestAccountBlockedHoldKeepsRouteManual(t *testing.T) {
+	now := time.Unix(1000, 0)
+	engine := NewEngine(WithClock(func() time.Time { return now }))
+	profile := Profile{
+		ID: "dynamic-single", Version: 1,
+		Candidates: []Candidate{{ID: "blocked", Enabled: true, BindingKey: "credential:shared", Policies: routingpolicy.DefaultDocument()}},
+	}
+	initial, err := engine.Select("session-a", profile, 0, "")
+	if err != nil {
+		t.Fatalf("Select: %v", err)
+	}
+	if _, err := engine.ApplyFailure("session-a", profile, initial.Generation, "blocked", accountBlockedFailure()); err == nil {
+		t.Fatal("a fully held route selected a candidate")
+	}
+	if deadline, ok := engine.resourceWaitDeadline(profile, now, nil); ok {
+		t.Fatalf("fully held route scheduled a resource wait until %s", deadline)
+	}
+}
+
+func TestAccountBlockedLegacyRetryTriesNext(t *testing.T) {
+	engine := NewEngine()
+	profile := Profile{
+		ID: "dynamic-legacy", Version: 1,
+		Candidates: []Candidate{
+			{ID: "blocked", Enabled: true, Rules: map[string]Action{"on_provider_error": ActionRetrySame}},
+			{ID: "next", Enabled: true},
+		},
+	}
+	initial, err := engine.Select("session-a", profile, 0, "")
+	if err != nil {
+		t.Fatalf("Select: %v", err)
+	}
+	decision, err := engine.ApplyFailure("session-a", profile, initial.Generation, "blocked", accountBlockedFailure())
+	if err != nil || decision.ExecutionProfileID != "next" {
+		t.Fatalf("legacy retry decision = %#v, %v; want next", decision, err)
+	}
+}
+
+func TestReleaseAccountBlockClosesOnlyHeldProfile(t *testing.T) {
+	now := time.Unix(1000, 0)
+	store := newStubCircuitPersistence()
+	engine := NewEngine(WithClock(func() time.Time { return now }),
+		WithCircuitRegistry(NewCircuitRegistry(WithCircuitPersistence(store),
+			WithCircuitClock(func() time.Time { return now }))))
+	profile := accountBlockProfile(routingpolicy.DefaultPolicy())
+	holdAccount(t, engine, profile, "session-a")
+	engine.Circuits().Open("credential:shared", now.Add(time.Hour), routingerr.CodeRateLimited)
+	engine.Circuits().Open("credential:other", now.Add(time.Hour), routingerr.CodeQuotaLimited)
+
+	for _, id := range []string{"sibling", "unknown", ""} {
+		if released, err := engine.ReleaseAccountBlock(id); released || err != nil {
+			t.Fatalf("release %q = %v, %v; want no hold", id, released, err)
+		}
+	}
+	released, err := engine.ReleaseAccountBlock("blocked")
+	if err != nil || !released {
+		t.Fatalf("release blocked = %v, %v; want released", released, err)
+	}
+	if again, err := engine.ReleaseAccountBlock("blocked"); again || err != nil {
+		t.Fatalf("repeated release = %v, %v; want no-op", again, err)
+	}
+	if engine.Circuits().IsOpen(accountBlockKey("blocked"), now) {
+		t.Fatal("hold still open after release")
+	}
+	if row, ok := store.row(accountBlockKey("blocked")); !ok || row.State != CircuitClosed {
+		t.Fatalf("persisted hold = %#v, %v; want closed", row, ok)
+	}
+	for _, key := range []string{"credential:shared", "credential:other"} {
+		if !engine.Circuits().IsOpen(key, now) {
+			t.Fatalf("release closed %s", key)
+		}
+	}
+}
+
+func TestReleaseAccountBlockKeepsHoldWhenSaveFails(t *testing.T) {
+	now := time.Unix(1000, 0)
+	store := newStubCircuitPersistence()
+	registry := NewCircuitRegistry(WithCircuitPersistence(store), WithCircuitClock(func() time.Time { return now }))
+	key := accountBlockKey("blocked")
+	registry.Hold(key, routingerr.CodeAccountBlocked)
+	store.setFailing(true)
+
+	released, err := registry.ReleaseHold(key)
+	if released || err == nil {
+		t.Fatalf("release during outage = %v, %v; want error", released, err)
+	}
+	if !registry.IsOpen(key, now) {
+		t.Fatal("failed release dropped the hold in memory")
+	}
+	store.setFailing(false)
+	if released, err := registry.ReleaseHold(key); !released || err != nil {
+		t.Fatalf("release after outage = %v, %v; want released", released, err)
+	}
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/admission.go b/apps/backend/internal/agent/runtime/dynamic/admission.go
new file mode 100644
index 00000000000..80925d806ca
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/admission.go
@@ -0,0 +1,59 @@
+package dynamic
+
+import (
+	"context"
+	"github.com/kandev/kandev/internal/agent/runtime/routingerr"
+	"time"
+)
+
+// AdmissionChecker rechecks mutable account capacity at the serialized claim.
+type AdmissionChecker interface {
+	CheckAdmission(context.Context, Candidate, string, time.Time) (PaceScore, error)
+}
+
+type LimitFailureResolver interface {
+	ResolveLimitFailure(context.Context, Candidate, *routingerr.Error) *routingerr.Error
+}
+
+type ClassifiedLimitObserver interface {
+	ObserveClassifiedLimit(context.Context, Candidate, *routingerr.Error, time.Time)
+}
+
+func (e *Engine) observeClassifiedLimit(ctx context.Context, c Candidate, failure *routingerr.Error) {
+	if failure.Code != routingerr.CodeRateLimited && failure.Code != routingerr.CodeQuotaLimited {
+		return
+	}
+	if observer, ok := e.limits.(ClassifiedLimitObserver); ok {
+		observer.ObserveClassifiedLimit(ctx, c, failure, e.now())
+		return
+	}
+	e.observeLimit(ctx, c.ID, failure)
+}
+
+// claimInputs reads capacity while the admission lock is held and the state
+// lock is free. The same immutable scores gate selection and resource waiting.
+func (e *Engine) claimInputs(ctx context.Context, profile Profile, now time.Time) RankOptions {
+	inputs := e.rankInputs(ctx, profile)
+	checker, ok := e.usage.(AdmissionChecker)
+	if !ok {
+		return inputs
+	}
+	scores := make(map[string]PaceScore, len(profile.Candidates))
+	for id, score := range inputs.Scores {
+		scores[id] = score
+	}
+	for _, candidate := range profile.Candidates {
+		if !candidate.Enabled {
+			continue
+		}
+		admission, err := checker.CheckAdmission(ctx, candidate, profile.AdmissionSessionID, now)
+		if err != nil {
+			continue
+		}
+		score := scores[candidate.ID]
+		score.AdmissionReason, score.AdmissionRetryAt = admission.AdmissionReason, admission.AdmissionRetryAt
+		scores[candidate.ID] = score
+	}
+	inputs.Scores = scores
+	return inputs
+}
diff --git a/apps/backend/internal/agent/runtime/dynamic/chain.go b/apps/backend/internal/agent/runtime/dynamic/chain.go
new file mode 100644
index 00000000000..bdfa6cbe4d8
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/dynamic/chain.go
@@ -0,0 +1,369 @@
+package dynamic
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+)
+
+// SelectionChain is the durable record of one transition chain: the admitted
+// attempt plus its automatic retries and candidate changes. It is bounded by
+// the candidate list, identifies candidates by concrete profile ID rather than
+// by a derived badge number, and survives retry, skip and restart so no
+// automatic transition returns to an earlier tier or a candidate already tried
+// in the same chain.
+type SelectionChain struct {
+	Interrupted       bool     `json:"interrupted,omitempty"`
+	Version           int      `json:"version"`
+	LogicalProfileID  string   `json:"logical_profile_id"`
+	StartGeneration   int64    `json:"start_generation"`
+	TriedCandidateIDs []string `json:"tried_candidate_ids"`
+	LastTierHeadID    string   `json:"last_tier_head_id"`
+}
+
+const selectionChainVersion = 1
+
+func (c SelectionChain) valid() bool {
+	return c.Version == selectionChainVersion && c.LogicalProfileID != "" && c.StartGeneration > 0
+}
+
+func (c SelectionChain) tried() map[string]bool {
+	tried := make(map[string]bool, len(c.TriedCandidateIDs))
+	for _, id := range c.TriedCandidateIDs {
+		tried[id] = true
+	}
+	return tried
+}
+
+// withTried appends one candidate, keeping the list duplicate-free so a
+// same-candidate retry cannot grow it.
+func (c SelectionChain) withTried(candidateID string) SelectionChain {
+	if candidateID == "" || c.tried()[candidateID] {
+		return c
+	}
+	c.TriedCandidateIDs = append(append([]string{}, c.TriedCandidateIDs...), candidateID)
+	return c
+}
+
+func decodeSelectionChain(policyStateJSON string) (SelectionChain, error) {
+	chain := SelectionChain{}
+	if policyStateJSON == "" {
+		return chain, nil
+	}
+	var state PolicyState
+	if err := json.Unmarshal([]byte(policyStateJSON), &state); err != nil {
+		return chain, fmt.Errorf("decode dynamic policy state: %w", err)
+	}
+	if state.SelectionChain == nil {
+		return chain, nil
+	}
+	return *state.SelectionChain, nil
+}
+
+// carrySelectionChain writes a chain into a policy-state document without
+// disturbing the failure-policy fields already in it.
+func carrySelectionChain(policyStateJSON string, chain SelectionChain) (string, error) {
+	state := PolicyState{}
+	if policyStateJSON != "" {
+		if err := json.Unmarshal([]byte(policyStateJSON), &state); err != nil {
+			return "", fmt.Errorf("decode dynamic policy state: %w", err)
+		}
+	}
+	if !chain.valid() {
+		state.SelectionChain = nil
+	} else {
+		state.SelectionChain = &chain
+	}
+	encoded, err := json.Marshal(state)
+	if err != nil {
+		return "", fmt.Errorf("encode dynamic policy state: %w", err)
+	}
+	return string(encoded), nil
+}
+
+// UsageSnapshotProvider supplies a bounded per-candidate usage observation for
+// one decision. It is called outside the engine lock and returns a failure as
+// unknown usage rather than as zero usage or unlimited capacity.
+type UsageSnapshotProvider interface {
+	UsageSnapshot(ctx context.Context, profile Profile) (map[string]PaceScore, error)
+}
+
+// WithUsageSnapshotProvider injects the usage observation used by pace and cost
+// ranking and by the settings preview.
+func WithUsageSnapshotProvider(provider UsageSnapshotProvider) EngineOption {
+	return func(engine *Engine) { engine.usage = provider }
+}
+
+// usageSnapshot fetches outside the engine lock. A failed refresh degrades to
+// unknown usage, which ranks after known pace instead of winning it.
+func (e *Engine) usageSnapshot(ctx context.Context, profile Profile) map[string]PaceScore {
+	if e.usage == nil {
+		return nil
+	}
+	scores, err := e.usage.UsageSnapshot(ctx, profile)
+	if err != nil {
+		return nil
+	}
+	return scores
+}
+
+// TierSearchOrder returns the tiers to try, in order, for a decision. A fresh
+// selection walks every tier in list order. A fallback starts at the tier that
+// owns the current candidate and never returns to an earlier tier.
+//
+// next_tier_on_failure skips the remaining peers of the current tier entirely;
+// same_tier_next keeps the tier and moves on only once it is exhausted.
+func TierSearchOrder(tiers []Tier, currentCandidateID string, direction FailureDirection) []Tier {
+	if currentCandidateID == "" {
+		return tiers
+	}
+	index := tierIndexOf(tiers, currentCandidateID)
+	if index < 0 {
+		return tiers
+	}
+	if direction == FailureNextTier {
+		return tiers[index+1:]
+	}
+	return tiers[index:]
+}
+
+func tierIndexOf(tiers []Tier, candidateID string) int {
+	for index, tier := range tiers {
+		for _, candidate := range tier.Candidates {
+			if candidate.ID == candidateID {
+				return index
+			}
+		}
+	}
+	return -1
+}
+
+// Route reason codes are a bounded set. They name the selection rule and, for a
+// fallback, the direction that was taken. They never embed a credential, a
+// provider response body or a prompt.
+const (
+	ReasonTierOrder      = "tier_order"
+	ReasonTierPace       = "tier_pace"
+	ReasonTierCost       = "tier_cost"
+	ReasonTierRandom     = "tier_random"
+	ReasonTierRoundRobin = "tier_round_robin"
+
+	ReasonSuffixSameTier = "_same_tier"
+	ReasonSuffixNextTier = "_next_tier"
+)
+
+// RouteReason returns the persisted reason code for one selection.
+//
+// Only a configured tier produces a tier code. A row with no stored tier
+// metadata is a legacy or default row, and its established reason code is left
+// untouched so existing consumers keep working.
+func RouteReason(policy TierPolicy, fallback bool) (string, bool) {
