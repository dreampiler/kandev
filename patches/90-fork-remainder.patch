+	queuedEntryID, err := fixture.repo.GetLatestTaskStepTransitionID(ctx, "t1")
+	require.NoError(t, err)
+	require.Positive(t, queuedEntryID)
+
+	task, err = fixture.repo.GetTask(ctx, "t1")
+	require.NoError(t, err)
+	task.WIPAdmitted = true
+	task.QueuedForStepID = ""
