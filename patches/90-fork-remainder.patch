+				&state.SessionID, &state.LogicalProfileID, &state.ExecutionProfileID,
+				&state.Generation, &state.ProfileVersion, &state.Status,
+				&state.ContinuationJSON, &state.PolicyStateJSON, &state.UpdatedAt,
+			); err != nil {
