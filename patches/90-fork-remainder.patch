+			route_generation, profile_version, state, continuation_json, policy_state_json, updated_at
+			FROM dynamic_route_states WHERE session_id IN (`+placeholders+`)
+		`), args...)
+		if err != nil {
+			return nil, err
+		}
+		for rows.Next() {
+			var state dynamicruntime.RouteState
