diff --git a/apps/backend/internal/review/launch_fallback.go b/apps/backend/internal/review/launch_fallback.go
new file mode 100644
index 00000000000..d1e4cdbfade
--- /dev/null
+++ b/apps/backend/internal/review/launch_fallback.go
@@ -0,0 +1,54 @@
+package review
+
+import (
+	"context"
+	"errors"
+	"fmt"
+)
+
+type unavailableRoute struct {
+	DynamicRouteSelector
+	profiles map[string]bool
+}
+
+func (r unavailableRoute) SelectCandidate(ctx context.Context, profileID string, skip func(string) bool) (string, error) {
+	return r.DynamicRouteSelector.SelectCandidate(ctx, profileID, func(id string) bool {
+		return r.profiles[id] || (skip != nil && skip(id))
+	})
+}
+
+func (r *Resolver) nextDynamicReviewer(ctx context.Context, current ReviewerIdentity, origin *OriginIdentity, unavailable map[string]bool) (ReviewerIdentity, error) {
+	if current.DynamicProfileID == "" || r.Routes == nil {
+		return ReviewerIdentity{}, ErrAgentUnavailable
+	}
+	profile, err := r.loadProfile(ctx, current.DynamicProfileID)
+	if err != nil {
+		return ReviewerIdentity{}, err
+	}
+	filtered := *r
+	filtered.Routes = unavailableRoute{DynamicRouteSelector: r.Routes, profiles: unavailable}
+	next, ok, err := filtered.resolveDynamic(ctx, current.DynamicProfileID, profile, current.Source, r.originExclusion(ctx, origin))
+	if err != nil {
+		return ReviewerIdentity{}, err
+	}
+	if !ok {
+		return ReviewerIdentity{}, fmt.Errorf("%w: no remaining executable reviewer", ErrAgentUnavailable)
+	}
+	return next, nil
+}
+
+func (r *Runner) reviewWithLaunchFallback(ctx context.Context, plan BatchPlan, identity ReviewerIdentity, req RunRequest, promptCtx PromptContext) (accumulator, ReviewerIdentity, error) {
+	unavailable := map[string]bool{}
+	for {
+		acc, err := r.reviewBatches(ctx, plan, identity, req.SessionID, promptCtx)
+		if err == nil || !errors.Is(err, ErrAgentUnavailable) || identity.DynamicProfileID == "" || ctx.Err() != nil {
+			return acc, identity, err
+		}
+		unavailable[identity.ProfileID] = true
+		next, resolveErr := r.resolver.nextDynamicReviewer(ctx, identity, req.Origin, unavailable)
+		if resolveErr != nil {
+			return acc, identity, fmt.Errorf("%w: %v", err, resolveErr)
+		}
+		identity = next
+	}
+}
diff --git a/apps/backend/internal/review/local_git.go b/apps/backend/internal/review/local_git.go
new file mode 100644
index 00000000000..e4e95a2ebc0
--- /dev/null
+++ b/apps/backend/internal/review/local_git.go
@@ -0,0 +1,151 @@
+package review
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/kandev/kandev/internal/common/subproc"
+	"github.com/kandev/kandev/internal/utility/hash"
+)
+
+// These match agentctl's workspace_git_diff.go collection limits.
+const (
+	localMaxDiffFileSize   = 10 * 1024 * 1024
+	localMaxDiffOutputSize = 256 * 1024
+	localMaxTotalDiffBytes = 2 * 1024 * 1024
+)
+
+type localGitBuffer struct {
+	data     []byte
+	limit    int
+	exceeded bool
+}
+
+var errLocalGitOutputLimit = errors.New("git output exceeds collection limit")
+
+func (b *localGitBuffer) Write(p []byte) (int, error) {
+	n := len(p)
+	remaining := b.limit - len(b.data)
+	if n > remaining {
+		b.exceeded = true
+		p = p[:remaining]
+	}
+	b.data = append(b.data, p...)
+	return n, nil
+}
+
+func localGit(ctx context.Context, path string, limit int, args ...string) (string, error) {
+	var output localGitBuffer
+	output.limit = limit
+	cmdErr, ctxErr := subproc.RunGitAfterAcquire(ctx, subproc.GitInteractive, 30*time.Second,
+		func(execCtx context.Context) *exec.Cmd {
+			cmd := subproc.NewGitCommand(execCtx, append([]string{"--literal-pathspecs", "-C", path}, args...)...)
+			cmd.Stdout = &output
+			return cmd
+		})
+	if ctxErr != nil {
+		return "", ctxErr
+	}
+	if output.exceeded {
+		return string(output.data), fmt.Errorf("%w: %d bytes", errLocalGitOutputLimit, limit)
+	}
+	// --no-index reports a textual diff with exit status 1.
+	var exit *exec.ExitError
+	if len(args) > 1 && args[0] == "diff" && args[1] == "--no-index" && errors.As(cmdErr, &exit) && exit.ExitCode() == 1 {
+		cmdErr = nil
+	}
+	return string(output.data), cmdErr
+}
+
+func localChangedFile(ctx context.Context, path, base, head, file, status string, used *int) (ChangedFile, error) {
+	if *used >= localMaxTotalDiffBytes {
+		return ChangedFile{}, nil
+	}
+	if localFileTooLarge(ctx, path, base, head, file) {
+		return ChangedFile{}, nil
+	}
+	args := append(localDiffArgs(base, head), "--", file)
+	diff, err := localGit(ctx, path, localMaxDiffOutputSize, args...)
+	if err != nil && !errors.Is(err, errLocalGitOutputLimit) {
+		return ChangedFile{}, fmt.Errorf("%w: read local diff for %q: %v", ErrWorkspaceUnavailable, file, err)
+	}
+	return localFile(file, status, diff, head != "", used), nil
+}
+
+func localFileTooLarge(ctx context.Context, path, base, head, file string) bool {
+	if head == "" {
+		if info, err := os.Stat(filepath.Join(path, filepath.FromSlash(file))); err == nil && info.Size() > localMaxDiffFileSize {
+			return true
+		}
+	}
+	for _, ref := range []string{base, head} {
+		if ref == "" {
+			continue
+		}
+		size, err := localGit(ctx, path, 128, "cat-file", "-s", ref+":"+file)
+		if err == nil {
+			n, _ := strconv.ParseInt(strings.TrimSpace(size), 10, 64)
+			if n > localMaxDiffFileSize {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func localFile(path, status, diff string, committed bool, used *int) ChangedFile {
+	diff = NormalizeDiff(diff)
+	if diff == "" || !strings.Contains(diff, "\n@@ ") || len(diff)+*used > localMaxTotalDiffBytes {
+		return ChangedFile{}
+	}
+	*used += len(diff)
+	file := ChangedFile{Path: path, Status: status, Diff: diff, DiffHash: hash.DJB2(diff), Source: sourceUncommitted}
+	if committed {
+		file.Source = sourceCommitted
+	}
+	for _, line := range strings.Split(diff, "\n") {
+		if strings.HasPrefix(line, "+") && !strings.HasPrefix(line, "+++") {
+			file.Additions++
+		}
+		if strings.HasPrefix(line, "-") && !strings.HasPrefix(line, "---") {
+			file.Deletions++
+		}
+	}
+	return file
+}
+
+func localUntrackedFiles(ctx context.Context, path string, used *int) ([]ChangedFile, error) {
+	output, err := localGit(ctx, path, localMaxTotalDiffBytes, "ls-files", "--others", "--exclude-standard", "-z")
+	if err != nil {
+		return nil, fmt.Errorf("%w: read untracked files: %v", ErrWorkspaceUnavailable, err)
+	}
+	var files []ChangedFile
+	for _, name := range strings.Split(output, "\x00") {
+		if name == "" || *used >= localMaxTotalDiffBytes {
+			continue
+		}
+		info, err := os.Lstat(filepath.Join(path, filepath.FromSlash(name)))
+		if err != nil {
+			return nil, fmt.Errorf("%w: read untracked file %q", ErrWorkspaceUnavailable, name)
+		}
+		if !info.Mode().IsRegular() || info.Size() > localMaxDiffFileSize {
+			continue
+		}
+		diff, err := localGit(ctx, path, localMaxDiffOutputSize, "diff", "--no-index", "--no-ext-diff", "--no-textconv", "--no-color", "--", os.DevNull, name)
+		if err != nil && !errors.Is(err, errLocalGitOutputLimit) {
+			return nil, fmt.Errorf("%w: read untracked diff %q: %v", ErrWorkspaceUnavailable, name, err)
+		}
+		file := localFile(name, "untracked", diff, false, used)
+		if file.Diff != "" {
+			files = append(files, file)
+		}
+	}
+	return files, nil
+}
diff --git a/apps/backend/internal/review/local_source.go b/apps/backend/internal/review/local_source.go
new file mode 100644
index 00000000000..4627eca837d
--- /dev/null
+++ b/apps/backend/internal/review/local_source.go
@@ -0,0 +1,136 @@
+package review
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Source names a backend-local Git worktree and the comparison it supplies.
+type Source struct {
+	WorktreePath string `json:"worktree_path"`
+	BaseRef      string `json:"base_ref"`
+	HeadRef      string `json:"head_ref,omitempty"`
+}
+
+const SourceMetadataKey = "review_source"
+
+// SourceFromMetadata accepts both typed writes and JSON-decoded task/session metadata.
+func SourceFromMetadata(metadata map[string]any) (*Source, error) {
+	value := metadata[SourceMetadataKey]
+	if value == nil {
+		return nil, nil
+	}
+	b, err := json.Marshal(value)
+	if err != nil {
+		return nil, fmt.Errorf("%w: invalid review source", ErrWorkspaceUnavailable)
+	}
+	var source Source
+	if err := json.Unmarshal(b, &source); err != nil {
+		return nil, fmt.Errorf("%w: invalid review source", ErrWorkspaceUnavailable)
+	}
+	return &source, nil
+}
+
+// ValidateSource verifies an existing local worktree and resolvable commit refs.
+func ValidateSource(ctx context.Context, source Source) error {
+	_, _, _, err := prepareLocalSource(ctx, source)
+	return err
+}
+
+func localPath(path string) bool {
+	return filepath.IsAbs(path) && !strings.HasPrefix(path, `\\`) && !strings.HasPrefix(path, "//")
+}
+
+func prepareLocalSource(ctx context.Context, source Source) (string, string, string, error) {
+	if !localPath(source.WorktreePath) {
+		return "", "", "", fmt.Errorf("%w: worktree_path must be an absolute local path", ErrWorkspaceUnavailable)
+	}
+	path, err := filepath.EvalSymlinks(source.WorktreePath)
+	if err != nil || !localPath(path) {
+		return "", "", "", fmt.Errorf("%w: worktree_path must exist on local disk", ErrWorkspaceUnavailable)
+	}
+	info, err := os.Stat(path)
+	if err != nil || !info.IsDir() {
+		return "", "", "", fmt.Errorf("%w: worktree_path must be a directory", ErrWorkspaceUnavailable)
+	}
+	inside, err := localGit(ctx, path, localMaxTotalDiffBytes, "rev-parse", "--is-inside-work-tree")
+	if err != nil || strings.TrimSpace(inside) != "true" {
+		return "", "", "", fmt.Errorf("%w: worktree_path is not a git worktree", ErrWorkspaceUnavailable)
+	}
+	base, err := localCommit(ctx, path, source.BaseRef)
+	if err != nil {
+		return "", "", "", err
+	}
+	head := ""
+	if source.HeadRef != "" {
+		head, err = localCommit(ctx, path, source.HeadRef)
+		if err != nil {
+			return "", "", "", err
+		}
+		base, err = localGit(ctx, path, localMaxTotalDiffBytes, "merge-base", base, head)
+		if err != nil {
+			return "", "", "", fmt.Errorf("%w: refs have no merge base", ErrWorkspaceUnavailable)
+		}
+		base = strings.TrimSpace(base)
+	}
+	return path, base, head, nil
+}
+
+func localCommit(ctx context.Context, path, ref string) (string, error) {
+	if strings.TrimSpace(ref) == "" {
+		return "", fmt.Errorf("%w: base_ref is required", ErrWorkspaceUnavailable)
+	}
+	commit, err := localGit(ctx, path, localMaxTotalDiffBytes, "rev-parse", "--verify", "--end-of-options", ref+"^{commit}")
+	if err != nil {
+		return "", fmt.Errorf("%w: invalid git ref %q", ErrWorkspaceUnavailable, ref)
+	}
+	return strings.TrimSpace(commit), nil
+}
+
+// CollectLocalChanges reads a committed three-dot range when HeadRef is set;
+// otherwise it reads the working tree (including untracked files) against BaseRef.
+func CollectLocalChanges(ctx context.Context, source Source) ([]ChangedFile, error) {
+	path, base, head, err := prepareLocalSource(ctx, source)
+	if err != nil {
+		return nil, err
+	}
+	args := localDiffArgs(base, head)
+	statusArgs := append(append([]string{}, args...), "--name-status", "-z", "--")
+	status, err := localGit(ctx, path, localMaxTotalDiffBytes, statusArgs...)
+	if err != nil {
+		return nil, fmt.Errorf("%w: read local git changes: %v", ErrWorkspaceUnavailable, err)
+	}
+	entries := strings.Split(strings.TrimSuffix(status, "\x00"), "\x00")
+	files := make([]ChangedFile, 0)
+	used := 0
+	for i := 0; i+1 < len(entries); i += 2 {
+		file, err := localChangedFile(ctx, path, base, head, entries[i+1], entries[i], &used)
+		if err != nil {
+			return nil, err
+		}
+		if file.Diff != "" {
+			files = append(files, file)
+		}
+	}
+	if head == "" {
+		untracked, err := localUntrackedFiles(ctx, path, &used)
+		if err != nil {
+			return nil, err
+		}
+		files = append(files, untracked...)
+	}
+	sortChangedFiles(files)
+	return files, nil
+}
+
+func localDiffArgs(base, head string) []string {
+	args := []string{"diff", "--no-ext-diff", "--no-textconv", "--no-color", "--no-renames", "--ignore-submodules=all", base}
+	if head != "" {
+		args = append(args, head)
+	}
+	return args
+}
