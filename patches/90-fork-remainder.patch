+func newTerminalStallExecution() *AgentExecution {
+	execution := &AgentExecution{
+		ID:           "test-exec",
+		TaskID:       "test-task",
+		SessionID:    "test-session",
+		promptDoneCh: make(chan PromptCompletionSignal, 1),
+		Status:       v1.AgentStatusRunning,
