+		if respErr != nil {
+			return nil, false
+		}
+		return resp, true
+	}
+	resp, respErr := ws.NewResponse(msg.ID, msg.Action, mcpCreateTaskResult{
+		TaskDTO:          dto.FromTask(found),
+		Deduplicated:     true,
+		CreationComplete: found.ExternalIDSettledAt != nil,
