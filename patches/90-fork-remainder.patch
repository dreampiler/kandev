+func newCrossWorkspaceHarness(t *testing.T, taskID string, caps Capabilities, gateway CrossWorkspaceGateway) *crossWorkspaceHarness {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	db, err := sqlx.Open("sqlite3", ":memory:")
