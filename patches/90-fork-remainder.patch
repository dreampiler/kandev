+func (f fakeCoordinatorProfileStore) GetAgentProfile(_ context.Context, id string) (*settingsmodels.AgentProfile, error) {
+	if f.err != nil {
+		return nil, f.err
+	}
+	if profile, ok := f.profiles[id]; ok {
+		return profile, nil
+	}
+	return nil, sql.ErrNoRows
+}
