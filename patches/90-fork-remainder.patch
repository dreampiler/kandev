+	switch policy.Mode {
+	case TierModePace:
+		base = ReasonTierPace
+	case TierModeCost:
+		base = ReasonTierCost
+	case TierModeRandom:
+		base = ReasonTierRandom
+	case TierModeRoundRobin:
+		base = ReasonTierRoundRobin
