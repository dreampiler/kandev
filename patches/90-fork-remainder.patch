+	if _, err := mgr.Create(context.Background(), retainedCreateRequest(repoPath)); !errors.Is(err, ErrWorktreeCorrupted) {
+		t.Fatalf("Create() err = %v, want ErrWorktreeCorrupted (preserve foreign repo)", err)
+	}
