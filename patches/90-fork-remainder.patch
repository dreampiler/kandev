+func TestRowWithoutManualWindowsRanksOnTheProfileUsage(t *testing.T) {
+	now := time.Now()
+	adapter := &usageProviderAdapter{
+		svc: agentusage.NewUsageService(), settingsStore: codexRowStore(),
+		proxyResolver: &recordingProxyResolver{
