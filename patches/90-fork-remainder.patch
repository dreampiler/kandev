@@ -0,0 +1,122 @@
+"use client";
+
+import type { Dispatch, SetStateAction } from "react";
+import { useTranslation } from "react-i18next";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@kandev/ui/select";
+import type {
+  AccountTierConfig,
+  BillingTier,
+  ProviderAccountLimit,
+} from "@/lib/api/domains/provider-limits-api";
+import { BILLING_TIERS, TIER_LABELS } from "@/lib/settings/provider-tier-limits";
+import { settingsControlClassName } from "./settings-control";
+
+type Props = {
+  account: ProviderAccountLimit;
+  provider: string;
+  draft: AccountTierConfig;
+  setDraft: Dispatch<SetStateAction<AccountTierConfig>>;
+  disabled: boolean;
+};
+
+export function ProviderAccountOptions({ account, provider, draft, setDraft, disabled }: Props) {
+  const { t } = useTranslation();
+  if (provider === "opencode-go")
+    return (
+      <div className="grid gap-1">
+        <Label htmlFor={`account-plan-${account.account_id}`}>{t("agents:providerTierPlan")}</Label>
+        <Input
+          disabled={disabled}
+          id={`account-plan-${account.account_id}`}
+          className={settingsControlClassName()}
+          value={draft.subscription_plan ?? ""}
+          placeholder={t("agents:providerTierPlanHint")}
+          onChange={(event) =>
+            setDraft((current) => ({
+              ...current,
+              subscription_plan: event.target.value || undefined,
+            }))
+          }
+        />
+      </div>
+    );
+  if (provider !== "llmgateway") return null;
+  let creditStatus = "automatic";
+  if (draft.purchased_credits !== undefined)
+    creditStatus = draft.purchased_credits ? "purchased" : "zero";
+  return (
+    <div className="grid gap-1">
+      <Label htmlFor={`account-credits-${account.account_id}`}>
+        {t("agents:providerTierCreditStatus")}
+      </Label>
+      <Select
+        disabled={disabled}
+        value={creditStatus}
+        onValueChange={(value) =>
+          setDraft((current) => ({
+            ...current,
+            purchased_credits: value === "automatic" ? undefined : value === "purchased",
+          }))
+        }
+      >
+        <SelectTrigger
+          id={`account-credits-${account.account_id}`}
+          className={settingsControlClassName()}
+        >
+          <SelectValue />
+        </SelectTrigger>
+        <SelectContent>
+          <SelectItem value="automatic">{t("agents:providerTierCreditUnknown")}</SelectItem>
+          <SelectItem value="purchased">{t("agents:providerTierCreditPurchased")}</SelectItem>
+          <SelectItem value="zero">{t("agents:providerTierCreditZero")}</SelectItem>
+        </SelectContent>
+      </Select>
+    </div>
+  );
+}
+
+export function ProviderProfileTiers({
+  account,
+  draft,
+  setDraft,
+  disabled,
+}: Omit<Props, "provider">) {
+  const { t } = useTranslation();
+  return (
+    <div className="grid gap-2">
+      {account.profiles.map((profile) => (
+        <div key={profile.id} className="grid gap-1">
+          <Label htmlFor={`profile-tier-${profile.id}`}>{profile.name || profile.id}</Label>
+          <Select
+            value={draft.profile_tiers?.[profile.id] ?? "automatic"}
+            disabled={disabled}
+            onValueChange={(value) =>
+              setDraft((current) => {
+                const profiles = { ...current.profile_tiers };
+                if (value === "automatic") delete profiles[profile.id];
+                else profiles[profile.id] = value as BillingTier;
+                return { ...current, profile_tiers: profiles };
+              })
+            }
+          >
+            <SelectTrigger id={`profile-tier-${profile.id}`} className={settingsControlClassName()}>
+              <SelectValue />
+            </SelectTrigger>
+            <SelectContent>
+              <SelectItem value="automatic">
+                {t("agents:providerTierAutomatic", { tier: t(TIER_LABELS[profile.tier]) })}
+              </SelectItem>
+              {BILLING_TIERS.map((tier) => (
+                <SelectItem key={tier} value={tier}>
+                  {t(TIER_LABELS[tier])}
+                </SelectItem>
+              ))}
+            </SelectContent>
+          </Select>
+        </div>
+      ))}
+    </div>
+  );
+}
diff --git a/apps/web/components/settings/provider-limits-card.tsx b/apps/web/components/settings/provider-limits-card.tsx
new file mode 100644
index 00000000000..5f2932c8517
--- /dev/null
+++ b/apps/web/components/settings/provider-limits-card.tsx
@@ -0,0 +1,209 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { IconGauge } from "@tabler/icons-react";
+import { Badge } from "@kandev/ui/badge";
+import { Button } from "@kandev/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@kandev/ui/card";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import { useFeature } from "@/hooks/domains/features/use-feature";
+import { useProviderLimits } from "@/hooks/domains/settings/use-provider-limits";
+import type { ProviderLimit } from "@/lib/api/domains/provider-limits-api";
+import { formatDateTime } from "@/lib/i18n/formats";
+import {
+  browserTimeZone,
+  fromLocalInputValue,
+  toLocalInputValue,
+} from "@/lib/settings/provider-limits";
+import { settingsActionClassName } from "./settings-control";
+import { ProviderAccountLimits } from "./provider-account-limits";
+
+type ProviderLimitsCardProps = {
+  /** Show only this provider, for a profile whose model belongs to it. */
+  provider?: string;
+};
+
+/**
+ * Operator-entered provider limits for dynamic routing: the monthly reset used
+ * when the provider does not report one, and a manual block of every paid
+ * model until a time seen on the provider's console.
+ */
+export function ProviderLimitsCard({ provider }: ProviderLimitsCardProps) {
+  const routingEnabled = useFeature("dynamicAgentRouting");
+  if (!routingEnabled) return null;
+  return <ProviderLimitsCardBody provider={provider} />;
+}
+
+function ProviderLimitsCardBody({ provider }: ProviderLimitsCardProps) {
+  const { t } = useTranslation();
+  const { state, save } = useProviderLimits();
+  const providers =
+    state.status === "ready"
+      ? state.providers.filter((entry) => !provider || entry.provider === provider)
+      : [];
+  if (provider && state.status === "ready" && providers.length === 0) return null;
+
+  return (
+    <Card className="min-w-0 gap-0 py-0" data-testid="provider-limits-card">
+      <CardHeader className="px-3 py-3">
+        <CardTitle className="flex items-center gap-2 text-lg">
+          <IconGauge className="h-5 w-5 shrink-0" aria-hidden />
+          {t("agents:providerLimitsTitle")}
+        </CardTitle>
+        <p className="text-sm text-muted-foreground">{t("agents:providerLimitsDescription")}</p>
+      </CardHeader>
+      <CardContent className="grid gap-3 px-3 pb-3">
+        {state.status === "loading" ? (
+          <p className="text-xs text-muted-foreground" role="status">
+            {t("agents:providerLimitsLoading")}
+          </p>
+        ) : null}
+        {state.status === "failed" ? (
+          <p className="text-xs text-destructive">{t("agents:providerLimitsLoadFailed")}</p>
+        ) : null}
+        {state.status === "ready" && providers.length === 0 ? (
+          <p className="text-xs text-muted-foreground">{t("agents:providerLimitsEmpty")}</p>
+        ) : null}
+        {providers.map((entry) => (
+          <ProviderLimitRow key={entry.provider} limit={entry} onSave={save} />
+        ))}
+      </CardContent>
+    </Card>
+  );
+}
+
+type SaveProviderLimit = ReturnType<typeof useProviderLimits>["save"];
+
+function ProviderLimitRow({ limit, onSave }: { limit: ProviderLimit; onSave: SaveProviderLimit }) {
+  const { t } = useTranslation();
+  const [monthly, setMonthly] = useState(toLocalInputValue(limit.monthly_reset_at));
+  const [blockUntil, setBlockUntil] = useState(toLocalInputValue(limit.block_until));
+  const [status, setStatus] = useState<"idle" | "saving" | "saved" | "failed">("idle");
+
+  const submit = async (nextMonthly: string, nextBlock: string) => {
+    setStatus("saving");
+    try {
+      await onSave(limit.provider, {
+        monthly_reset_at: fromLocalInputValue(nextMonthly),
+        monthly_reset_timezone: nextMonthly ? browserTimeZone() : "",
+        block_until: fromLocalInputValue(nextBlock),
+      });
+      setStatus("saved");
+    } catch {
+      setStatus("failed");
+    }
+  };
+
+  const monthlyId = `provider-limit-monthly-${limit.provider}`;
+  const blockId = `provider-limit-block-${limit.provider}`;
+  return (
+    <div
+      className="grid gap-2 rounded-md border p-3"
+      data-testid={`provider-limit-${limit.provider}`}
+    >
+      <ProviderLimitSummary limit={limit} />
+      {limit.accounts?.map((account) => (
+        <ProviderAccountLimits
+          key={account.account_id}
+          account={account}
+          provider={limit.provider}
+          save={onSave}
+        />
+      ))}
+      <div className="grid gap-2 sm:grid-cols-2">
+        <div className="grid gap-1">
+          <Label htmlFor={monthlyId}>{t("agents:providerLimitsMonthlyReset")}</Label>
+          <Input
+            id={monthlyId}
+            type="datetime-local"
+            value={monthly}
+            onChange={(event) => setMonthly(event.target.value)}
+          />
+          <span className="text-xs text-muted-foreground">
+            {t("agents:providerLimitsMonthlyResetHint")}
+          </span>
+        </div>
+        <div className="grid gap-1">
+          <Label htmlFor={blockId}>{t("agents:providerLimitsBlockUntil")}</Label>
+          <Input
+            id={blockId}
+            type="datetime-local"
+            value={blockUntil}
+            onChange={(event) => setBlockUntil(event.target.value)}
+          />
+          <span className="text-xs text-muted-foreground">
+            {t("agents:providerLimitsBlockHint")}
+          </span>
+        </div>
+      </div>
+      <div className="flex flex-wrap items-center gap-2">
+        <Button
+          variant="outline"
+          className={settingsActionClassName("cursor-pointer")}
+          disabled={status === "saving"}
+          onClick={() => void submit(monthly, blockUntil)}
+        >
+          {t("agents:providerLimitsSave")}
+        </Button>
+        <Button
+          variant="ghost"
+          className={settingsActionClassName("cursor-pointer")}
+          disabled={status === "saving" || (!monthly && !blockUntil)}
+          onClick={() => {
+            setMonthly("");
+            setBlockUntil("");
+            void submit("", "");
+          }}
+        >
+          {t("agents:providerLimitsClear")}
+        </Button>
+        {status === "saved" ? (
+          <span className="text-xs text-muted-foreground" role="status">
+            {t("agents:providerLimitsSaved")}
+          </span>
+        ) : null}
+        {status === "failed" ? (
+          <span className="text-xs text-destructive" role="alert">
+            {t("agents:providerLimitsSaveFailed")}
+          </span>
+        ) : null}
+      </div>
+    </div>
+  );
+}
+
+function ProviderLimitSummary({ limit }: { limit: ProviderLimit }) {
+  const { t } = useTranslation();
+  return (
+    <div className="grid gap-1">
+      <div className="flex flex-wrap items-center gap-2">
+        <span className="font-medium">{limit.provider}</span>
+        <Badge variant="outline">
+          {t("agents:providerLimitsProfileCount", { count: limit.profile_count })}
+        </Badge>
+        {limit.model_scoped ? (
+          <Badge variant="secondary">{t("agents:providerLimitsModelScoped")}</Badge>
+        ) : null}
+      </div>
+      {limit.next_monthly_reset ? (
+        <span className="text-xs text-muted-foreground">
+          {t(
+            limit.next_monthly_reset_source === "usage"
+              ? "agents:providerLimitsNextResetUsage"
+              : "agents:providerLimitsNextResetManual",
+            { time: formatDateTime(limit.next_monthly_reset) },
+          )}
+        </span>
+      ) : null}
+      {limit.observed_exhausted_until ? (
+        <span className="text-xs text-muted-foreground">
+          {t("agents:providerLimitsExhaustedUntil", {
+            time: formatDateTime(limit.observed_exhausted_until),
+          })}
+        </span>
+      ) : null}
+    </div>
+  );
+}
diff --git a/apps/web/components/settings/provider-tier-budgets.tsx b/apps/web/components/settings/provider-tier-budgets.tsx
new file mode 100644
index 00000000000..1c1a1bdef80
--- /dev/null
+++ b/apps/web/components/settings/provider-tier-budgets.tsx
@@ -0,0 +1,187 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@kandev/ui/select";
+import type {
+  BillingTier,
+  LimitBudget,
+  ProviderAccountLimit,
+  TierLimits,
+} from "@/lib/api/domains/provider-limits-api";
+import { settingsControlClassName } from "./settings-control";
+import { budgetKey, updateBudgetOverride } from "@/lib/settings/provider-tier-limits";
+
+const WINDOW_LABELS = {
+  "5h": "agents:providerTierFiveHours",
+  day: "agents:providerTierDay",
+  week: "agents:providerTierWeek",
+  month: "agents:providerTierMonth",
+};
+const UNIT_LABELS = {
+  usd: "agents:providerTierUSD",
+  tokens: "agents:providerTierTokens",
+  percent: "agents:providerTierPercent",
+  requests: "agents:providerTierRequests",
+  turns: "agents:providerTierTurns",
+};
+const RESET_LABELS = {
+  rolling: "agents:providerTierRolling",
+  utc: "agents:providerTierUTC",
+  provider: "agents:providerTierProviderReset",
+  anchor: "agents:providerTierAnchor",
+};
+type Props = {
+  prefix: string;
+  tier: BillingTier;
+  state: ProviderAccountLimit["tiers"][BillingTier];
+  override: TierLimits;
+  onChange: (patch: Partial<TierLimits>) => void;
+};
+
+export function ProviderTierBudgets({ prefix, tier, state, override, onChange }: Props) {
+  const periods: LimitBudget["window"][] =
+    tier === "paid" ? ["day", "month"] : ["5h", "week", "month"];
+  const budgets = [...(state.effective.windows ?? [])];
+  for (const window of periods)
+    if (!budgets.some((budget) => budget.window === window))
+      budgets.push({
+        window,
+        unit: tier === "paid" ? "usd" : "percent",
+        reset: tier === "paid" ? "utc" : "provider",
+      });
+  const update = (budget: LimitBudget, patch: Partial<LimitBudget>, clear = false) => {
+    onChange({ windows: updateBudgetOverride(override.windows ?? [], budget, patch, clear) });
+  };
+  return (
+    <>
+      {budgets.map((budget) => (
+        <ProviderBudgetEditor
+          key={budgetKey(budget)}
+          prefix={prefix}
+          budget={budget}
+          state={state}
+          override={override.windows?.find((entry) => budgetKey(entry) === budgetKey(budget))}
+          onChange={(patch, clear) => update(budget, patch, clear)}
+        />
+      ))}
+    </>
+  );
+}
+
+function ProviderBudgetEditor({
+  prefix,
+  budget,
+  state,
+  override,
+  onChange,
+}: {
+  prefix: string;
+  budget: LimitBudget;
+  state: Props["state"];
+  override?: LimitBudget;
+  onChange: (patch: Partial<LimitBudget>, clear?: boolean) => void;
+}) {
+  const { t } = useTranslation();
+  const id = `${prefix}-${budgetKey(budget)}`;
+  const effective = { ...budget, ...override };
+  const defaults = state.defaults.windows?.find((entry) => budgetKey(entry) === budgetKey(budget));
+  const learned = state.learned.windows?.find((entry) => budgetKey(entry) === budgetKey(budget));
+  return (
+    <div className="grid min-w-0 gap-1 border-t pt-2">
+      <Label htmlFor={`${id}-value`}>
+        {t(WINDOW_LABELS[budget.window])}
+        {budget.scope ? ` (${budget.scope})` : ""}
+      </Label>
+      <Input
+        id={`${id}-value`}
+        type="number"
+        min={0}
+        step="any"
+        className={settingsControlClassName()}
+        value={override?.value ?? ""}
+        placeholder={budget.value?.toString() ?? t("agents:providerTierUnknown")}
+        onChange={(event) =>
+          onChange(
+            { value: event.target.value === "" ? undefined : Number(event.target.value) },
+            event.target.value === "",
+          )
+        }
+      />
+      <span className="break-words text-xs text-muted-foreground">
+        {t("agents:providerTierSources", {
+          defaults: defaults?.value ?? t("agents:providerTierUnknown"),
+          learned: learned?.value ?? t("agents:providerTierUnknown"),
+          override: override?.value ?? t("agents:providerTierInherited"),
+        })}
+      </span>
+      {budget.window_estimated ? (
+        <p className="text-xs text-muted-foreground">
+          {t("agents:providerTierUnknownWindowLearned")}
+        </p>
+      ) : null}
+      <BudgetRules id={id} effective={effective} onChange={onChange} />
+    </div>
+  );
+}
+
+function BudgetRules({
+  id,
+  effective,
+  onChange,
+}: {
+  id: string;
+  effective: LimitBudget;
+  onChange: (patch: Partial<LimitBudget>) => void;
+}) {
+  const { t } = useTranslation();
+  return (
+    <>
+      <Label htmlFor={`${id}-unit`}>{t("agents:providerTierBudgetUnit")}</Label>
+      <Select
+        value={effective.unit}
+        onValueChange={(unit) => onChange({ unit: unit as LimitBudget["unit"] })}
+      >
+        <SelectTrigger id={`${id}-unit`} className={settingsControlClassName()}>
+          <SelectValue />
+        </SelectTrigger>
+        <SelectContent>
+          {Object.entries(UNIT_LABELS).map(([unit, label]) => (
+            <SelectItem key={unit} value={unit}>
+              {t(label)}
+            </SelectItem>
+          ))}
+        </SelectContent>
+      </Select>
+      <Label htmlFor={`${id}-reset`}>{t("agents:providerTierBudgetReset")}</Label>
+      <Select
+        value={effective.reset}
+        onValueChange={(reset) => onChange({ reset: reset as LimitBudget["reset"] })}
+      >
+        <SelectTrigger id={`${id}-reset`} className={settingsControlClassName()}>
+          <SelectValue />
+        </SelectTrigger>
+        <SelectContent>
+          {Object.entries(RESET_LABELS).map(([reset, label]) => (
+            <SelectItem key={reset} value={reset}>
+              {t(label)}
+            </SelectItem>
+          ))}
+        </SelectContent>
+      </Select>
+      {effective.reset === "anchor" || effective.reset === "provider" ? (
+        <div className="grid gap-1">
+          <Label htmlFor={`${id}-anchor`}>{t("agents:providerTierResetInstant")}</Label>
+          <Input
+            id={`${id}-anchor`}
+            className={settingsControlClassName()}
+            value={effective.reset_at ?? ""}
+            placeholder={t("agents:providerTierResetInstantHint")}
+            onChange={(event) => onChange({ reset_at: event.target.value || undefined })}
+          />
+        </div>
+      ) : null}
+    </>
+  );
+}
diff --git a/apps/web/components/settings/provider-tier-editor.tsx b/apps/web/components/settings/provider-tier-editor.tsx
new file mode 100644
index 00000000000..4ea4802c53f
--- /dev/null
+++ b/apps/web/components/settings/provider-tier-editor.tsx
@@ -0,0 +1,132 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import type {
+  BillingTier,
+  ProviderAccountLimit,
+  TierLimits,
+} from "@/lib/api/domains/provider-limits-api";
+import { settingsControlClassName } from "./settings-control";
+import { TIER_LABELS } from "@/lib/settings/provider-tier-limits";
+import { ProviderTierBudgets } from "./provider-tier-budgets";
+import { ProviderTierScopes } from "./provider-tier-scopes";
+import { PROVENANCE_LABELS } from "@/lib/settings/provider-tier-limits";
+
+type NumericField =
+  | "max_concurrent_turns"
+  | "requests_per_minute"
+  | "requests_per_day"
+  | "requests_per_window"
+  | "request_window_seconds";
+const BASE_FIELDS: { field: NumericField; label: string }[] = [
+  { field: "max_concurrent_turns", label: "agents:providerTierConcurrency" },
+  { field: "requests_per_minute", label: "agents:providerTierMinute" },
+];
+const FREE_FIELDS: { field: NumericField; label: string }[] = [
+  { field: "requests_per_day", label: "agents:providerTierDaily" },
+  { field: "requests_per_window", label: "agents:providerTierRequestWindow" },
+  { field: "request_window_seconds", label: "agents:providerTierRequestWindowSeconds" },
+];
+type Props = {
+  accountId: string;
+  tier: BillingTier;
+  /** Provider model IDs of the account's free-tier profiles. */
+  models: string[];
+  state: ProviderAccountLimit["tiers"][BillingTier];
+  override: TierLimits;
+  onChange: (patch: Partial<TierLimits>) => void;
+  disabled: boolean;
+};
+
+export function ProviderTierEditor({
+  accountId,
+  tier,
+  models,
+  state,
+  override,
+  onChange,
+  disabled,
+}: Props) {
+  const { t } = useTranslation();
+  const fields = tier === "free" ? [...BASE_FIELDS, ...FREE_FIELDS] : BASE_FIELDS;
+  const prefix = `account-${accountId}-${tier}`;
+  return (
+    <fieldset
+      className="grid min-w-0 content-start gap-3 rounded-md border p-2"
+      data-testid={`account-tier-${accountId}-${tier}`}
+      disabled={disabled}
+    >
+      <legend className="px-1 font-medium">{t(TIER_LABELS[tier])}</legend>
+      {fields.map(({ field, label }) => (
+        <div key={field} className="grid min-w-0 gap-1">
+          <Label htmlFor={`${prefix}-${field}`}>{t(label)}</Label>
+          <Input
+            id={`${prefix}-${field}`}
+            className={settingsControlClassName("w-full")}
+            type="number"
+            min={0}
+            step="any"
+            value={override[field] ?? ""}
+            placeholder={state.effective[field]?.toString() ?? t("agents:providerTierUnknown")}
+            onChange={(event) =>
+              onChange({
+                [field]: event.target.value === "" ? undefined : Number(event.target.value),
+              })
+            }
+          />
+          <span className="break-words text-xs text-muted-foreground">
+            {t("agents:providerTierSources", {
+              defaults: state.defaults[field] ?? t("agents:providerTierUnknown"),
+              learned: state.learned[field] ?? t("agents:providerTierUnknown"),
+              override: override[field] ?? t("agents:providerTierInherited"),
+            })}
+            {state.defaults.provenance?.[field]
+              ? ` ${t("agents:providerLimitProvenance", { provenance: t(PROVENANCE_LABELS[state.defaults.provenance[field]]) })}`
+              : ""}
+          </span>
+        </div>
+      ))}
+      {tier === "free" ? (
+        <>
+          <div className="grid gap-1">
+            <Label htmlFor={`${prefix}-daily-reset`}>{t("agents:providerTierDailyReset")}</Label>
+            <Input
+              id={`${prefix}-daily-reset`}
+              className={settingsControlClassName()}
+              value={override.daily_reset ?? ""}
+              placeholder={state.effective.daily_reset || t("agents:providerTierDailyResetExample")}
+              onChange={(event) => onChange({ daily_reset: event.target.value || undefined })}
+            />
+          </div>
+          <ProviderTierScopes
+            prefix={prefix}
+            models={models}
+            state={state}
+            override={override}
+            onChange={onChange}
+          />
+        </>
+      ) : (
+        <ProviderTierBudgets
+          prefix={prefix}
+          tier={tier}
+          state={state}
+          override={override}
+          onChange={onChange}
+        />
+      )}
+      {state.effective.requests_per_model ? (
+        <p className="text-xs text-muted-foreground">{t("agents:providerTierPerModel")}</p>
+      ) : null}
+      <p className="text-xs text-muted-foreground">
+        {t("agents:providerTierCurrent", {
+          turns: state.usage.active_turns ?? 0,
+          minute: state.usage.requests_minute ?? 0,
+          day: state.usage.requests_day ?? 0,
+        })}
+      </p>
+    </fieldset>
+  );
+}
diff --git a/apps/web/components/settings/provider-tier-scope-adder.tsx b/apps/web/components/settings/provider-tier-scope-adder.tsx
new file mode 100644
index 00000000000..18f5c1b096c
--- /dev/null
+++ b/apps/web/components/settings/provider-tier-scope-adder.tsx
@@ -0,0 +1,81 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Button } from "@kandev/ui/button";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import type { RequestScope } from "@/lib/api/domains/provider-limits-api";
+import { newOwnerScope } from "@/lib/settings/provider-tier-limits";
+import { settingsActionClassName, settingsControlClassName } from "./settings-control";
+
+type Props = {
+  prefix: string;
+  models: string[];
+  existing: RequestScope[];
+  onAdd: (scope: RequestScope) => void;
+};
+
+/** Adds an owner scope: one selected model, or a shared group of several. */
+export function ProviderTierScopeAdder({ prefix, models, existing, onAdd }: Props) {
+  const { t } = useTranslation();
+  const [selected, setSelected] = useState<string[]>([]);
+  const [value, setValue] = useState("");
+  if (models.length === 0) return null;
+  const candidate = selected.length > 0 ? newOwnerScope(selected, undefined) : undefined;
+  const duplicate = candidate ? existing.some((scope) => scope.id === candidate.id) : false;
+  const toggle = (model: string) =>
+    setSelected((current) =>
+      current.includes(model) ? current.filter((m) => m !== model) : [...current, model],
+    );
+  const add = () => {
+    if (!candidate || duplicate) return;
+    onAdd(newOwnerScope(selected, value === "" ? undefined : Number(value)));
+    setSelected([]);
+    setValue("");
+  };
+  return (
+    <div className="grid min-w-0 gap-1 border-t pt-2">
+      <p className="text-xs text-muted-foreground">{t("agents:providerScopeAddHint")}</p>
+      <div
+        className="flex flex-wrap gap-1"
+        role="group"
+        aria-label={t("agents:providerScopeModels")}
+      >
+        {models.map((model) => (
+          <Button
+            key={model}
+            type="button"
+            aria-pressed={selected.includes(model)}
+            variant={selected.includes(model) ? "secondary" : "outline"}
+            className={settingsActionClassName("max-w-full break-all")}
+            onClick={() => toggle(model)}
+          >
+            {model}
+          </Button>
+        ))}
+      </div>
+      <Label htmlFor={`${prefix}-scope-new-value`}>{t("agents:providerScopeNewValue")}</Label>
+      <Input
+        id={`${prefix}-scope-new-value`}
+        className={settingsControlClassName("w-full")}
+        type="number"
+        min={0}
+        step="any"
+        value={value}
+        onChange={(event) => setValue(event.target.value)}
+      />
+      <Button
+        type="button"
+        variant="outline"
+        className={settingsActionClassName("justify-self-start")}
+        disabled={!candidate || duplicate}
+        onClick={add}
+      >
+        {t(
+          candidate?.kind === "group" ? "agents:providerScopeAddGroup" : "agents:providerScopeAdd",
+        )}
+      </Button>
+    </div>
+  );
+}
diff --git a/apps/web/components/settings/provider-tier-scopes.tsx b/apps/web/components/settings/provider-tier-scopes.tsx
new file mode 100644
index 00000000000..03c78e00208
--- /dev/null
+++ b/apps/web/components/settings/provider-tier-scopes.tsx
@@ -0,0 +1,180 @@
+"use client";
+
+import { useTranslation } from "react-i18next";
+import { Button } from "@kandev/ui/button";
+import { Input } from "@kandev/ui/input";
+import { Label } from "@kandev/ui/label";
+import type {
+  ProviderAccountLimit,
+  RequestScope,
+  TierLimits,
+} from "@/lib/api/domains/provider-limits-api";
+import {
+  PROVENANCE_LABELS,
+  scopeRows,
+  updateScopeOverride,
+} from "@/lib/settings/provider-tier-limits";
+import { settingsActionClassName, settingsControlClassName } from "./settings-control";
+import { ProviderTierScopeAdder } from "./provider-tier-scope-adder";
+
+const UNKNOWN = "agents:providerTierUnknown";
+
+type TierState = ProviderAccountLimit["tiers"]["free"];
+type Props = {
+  prefix: string;
+  models: string[];
+  state: TierState;
+  override: TierLimits;
+  onChange: (patch: Partial<TierLimits>) => void;
+};
+
+/** Model and shared-group daily scopes of a free tier, under its account-wide value. */
+export function ProviderTierScopes({ prefix, models, state, override, onChange }: Props) {
+  const { t } = useTranslation();
+  const overrides = override.scopes ?? [];
+  const rows = scopeRows(state.effective, override);
+  return (
+    <div className="grid min-w-0 gap-2 border-t pt-2" data-testid={`${prefix}-scopes`}>
+      <p className="font-medium text-sm">{t("agents:providerScopesTitle")}</p>
+      {rows.length === 0 ? (
+        <p className="text-xs text-muted-foreground">{t("agents:providerScopesEmpty")}</p>
+      ) : null}
+      {rows.map((scope) => (
+        <ProviderScopeRow
+          key={scope.id}
+          id={`${prefix}-scope-${scope.id}`}
+          scope={scope}
+          state={state}
+          override={overrides.find((entry) => entry.id === scope.id)}
+          onValue={(value) => onChange({ scopes: updateScopeOverride(overrides, scope, value) })}
+          onRemove={() => onChange({ scopes: overrides.filter((entry) => entry.id !== scope.id) })}
+        />
+      ))}
+      <ProviderTierScopeAdder
+        prefix={prefix}
+        models={models}
+        existing={rows}
+        onAdd={(scope) => onChange({ scopes: [...overrides, scope] })}
+      />
+    </div>
+  );
+}
+
+type RowProps = {
+  id: string;
+  scope: RequestScope;
+  state: TierState;
+  override?: RequestScope;
+  onValue: (value: number | undefined) => void;
+  onRemove: () => void;
+};
+
+function ProviderScopeRow({ id, scope, state, override, onValue, onRemove }: RowProps) {
+  const { t } = useTranslation();
+  const defaults = state.defaults.scopes?.find((entry) => entry.id === scope.id);
+  const learned = state.learned.scopes?.find((entry) => entry.id === scope.id);
+  const kindLabel =
+    scope.kind === "group" ? "agents:providerScopeGroup" : "agents:providerScopeModel";
+  const ownerDefined = Boolean(override?.kind) && !defaults && !learned;
+  return (
+    <div className="grid min-w-0 gap-1" data-testid={id}>
+      <Label htmlFor={`${id}-value`} className="break-all">
+        {t(kindLabel, { models: (scope.models ?? []).join(", ") })}
+      </Label>
+      <ScopeValueInput id={`${id}-value`} scope={scope} override={override} onValue={onValue} />
+      <ScopeSources defaults={defaults} learned={learned} override={override} />
+      <ScopeStatus
+        scope={scope}
+        used={state.usage.scopes?.[scope.id] ?? 0}
+        provenance={defaults?.provenance}
+        provisional={learned?.provisional}
+      />
+      {ownerDefined ? (
+        <Button
+          type="button"
+          variant="ghost"
+          className={settingsActionClassName("justify-self-start")}
+          onClick={onRemove}
+        >
+          {t("agents:providerScopeRemove")}
+        </Button>
+      ) : null}
+    </div>
+  );
+}
+
+function ScopeValueInput({
+  id,
+  scope,
+  override,
+  onValue,
+}: {
+  id: string;
+  scope: RequestScope;
+  override?: RequestScope;
+  onValue: (value: number | undefined) => void;
+}) {
+  const { t } = useTranslation();
+  return (
+    <Input
+      id={id}
+      className={settingsControlClassName("w-full")}
+      type="number"
+      min={0}
+      step="any"
+      value={override?.requests_per_day ?? ""}
+      placeholder={scope.requests_per_day?.toString() ?? t(UNKNOWN)}
+      onChange={(event) =>
+        onValue(event.target.value === "" ? undefined : Number(event.target.value))
+      }
+    />
+  );
+}
+
+function ScopeSources({
+  defaults,
+  learned,
+  override,
+}: {
+  defaults?: RequestScope;
+  learned?: RequestScope;
+  override?: RequestScope;
+}) {
+  const { t } = useTranslation();
+  return (
+    <span className="break-words text-xs text-muted-foreground">
+      {t("agents:providerTierSources", {
+        defaults: defaults?.requests_per_day ?? t(UNKNOWN),
+        learned: learned?.requests_per_day ?? t(UNKNOWN),
+        override: override?.requests_per_day ?? t("agents:providerTierInherited"),
+      })}
+    </span>
+  );
+}
+
+function ScopeStatus({
+  scope,
+  used,
+  provenance,
+  provisional,
+}: {
+  scope: RequestScope;
+  used: number;
+  provenance?: RequestScope["provenance"];
+  provisional?: boolean;
+}) {
+  const { t } = useTranslation();
+  return (
+    <>
+      <span className="text-xs text-muted-foreground">
+        {t("agents:providerScopeToday", { used, reset: scope.daily_reset || t(UNKNOWN) })}
+        {provenance
+          ? ` ${t("agents:providerLimitProvenance", { provenance: t(PROVENANCE_LABELS[provenance]) })}`
+          : ""}
+      </span>
+      {provisional ? (
+        <p className="text-xs text-muted-foreground">{t("agents:providerScopeProvisional")}</p>
+      ) : null}
+    </>
+  );
+}
