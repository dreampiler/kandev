+package review
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	"github.com/kandev/kandev/internal/task/models"
+)
+
+type launchFailInference struct{ seen []string }
+
+func (f *launchFailInference) Run(_ context.Context, id ReviewerIdentity, _, _ string) (*PromptResult, error) {
+	f.seen = append(f.seen, id.ProfileID)
+	if id.ProfileID == "big-pickle" {
+		return nil, fmt.Errorf("%w: ACP initialize failed", ErrAgentUnavailable)
+	}
+	return &PromptResult{Response: `{"summary":"clean","findings":[]}`}, nil
+}
+
+func TestRunnerDynamicRouteContinuesAfterStructuralLaunchFailure(t *testing.T) {
+	h := newRunnerHarness(t, map[string]any{"a.go": fileEntry("a.go", "@@ -1 +1 @@\n-old\n+new\n", "", "")}, nil)
+	r := NewResolver(reviewProfiles(), nil, nil)
+	r.Routes = &fakeRoute{candidates: map[string][]string{"review-dynamic": {"big-pickle", "sol", "opus"}}}
+	h.runner.resolver = r
+	f := &launchFailInference{}
+	h.runner.inference = f
+	run, err := h.runner.Run(t.Context(), RunRequest{TaskID: "task", SessionID: "sess-1", AgentProfileID: "review-dynamic", Origin: writerOrigin(), OriginRequired: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if h.store.statusOf(run.ID) != models.ReviewRunCompleted {
+		t.Fatal("structural launch failure ended the whole review")
+	}
+	if len(f.seen) != 2 || f.seen[0] != "big-pickle" || f.seen[1] != "opus" {
+		t.Fatalf("route attempts = %v", f.seen)
+	}
+	if h.store.runs[run.ID].Model != "opus" {
+		t.Fatal("run did not record the reviewer that completed it")
+	}
+}
diff --git a/apps/backend/internal/review/runner_source.go b/apps/backend/internal/review/runner_source.go
new file mode 100644
index 00000000000..1f7f2be1bb2
--- /dev/null
+++ b/apps/backend/internal/review/runner_source.go
@@ -0,0 +1,59 @@
+package review
+
+import (
+	"context"
+	"fmt"
+)
+
+// ReviewSourceMetadataLookup supplies the task source, or the writer session's
+// source when no task source is configured.
+type ReviewSourceMetadataLookup interface {
+	ReviewSourceMetadata(ctx context.Context, taskID, sessionID string) (map[string]any, error)
+}
+
+// collectRequestChanges resolves the changed-file set a pass reviews and
+// describes the scope it read. Precedence is:
+//
+//  1. an explicit request range (worktree_path/base_ref/head_ref), then
+//  2. the task's saved review_source, then
+//  3. the session workspace.
+//
+// The saved source outranks the workspace on purpose: it is the operator's
+// deliberate scope for the task (for example a PR's base..head), while the
+// workspace set also carries unrelated untracked files, which would otherwise
+// replace the intended range and review the wrong thing.
+func (r *Runner) collectRequestChanges(ctx context.Context, req RunRequest) ([]ChangedFile, string, error) {
+	if req.WorktreePath != "" || req.BaseRef != "" || req.HeadRef != "" {
+		files, err := CollectLocalChanges(ctx, Source{WorktreePath: req.WorktreePath, BaseRef: req.BaseRef, HeadRef: req.HeadRef})
+		return files, explicitSourceLabel(req), err
+	}
+	if lookup, ok := r.taskContext.(ReviewSourceMetadataLookup); ok {
+		metadata, err := lookup.ReviewSourceMetadata(ctx, req.TaskID, req.SessionID)
+		if err != nil {
+			return nil, "", err
+		}
+		source, err := SourceFromMetadata(metadata)
+		if err != nil {
+			return nil, "", err
+		}
+		if source != nil {
+			// Use only the saved source. Falling back to the workspace set when
+			// the saved range is empty would review unrelated files, so an empty
+			// saved range surfaces as no-changes instead.
+			files, err := CollectLocalChanges(ctx, *source)
+			return files, fmt.Sprintf("saved review_source %s..%s", source.BaseRef, source.HeadRef), err
+		}
+	}
+	files, err := CollectChanges(ctx, r.changes, req.SessionID, req.RepositoryID)
+	return files, "session workspace", err
+}
+
+// explicitSourceLabel names an explicit request scope from the fields actually
+// set: a base/head pair reads as a range, while a worktree-only request reads as
+// the worktree path instead of an empty "base..head".
+func explicitSourceLabel(req RunRequest) string {
+	if req.BaseRef != "" || req.HeadRef != "" {
+		return fmt.Sprintf("explicit range %s..%s", req.BaseRef, req.HeadRef)
+	}
+	return fmt.Sprintf("explicit worktree %s", req.WorktreePath)
+}
diff --git a/apps/backend/internal/review/runner_source_test.go b/apps/backend/internal/review/runner_source_test.go
new file mode 100644
index 00000000000..0d1422d5791
--- /dev/null
+++ b/apps/backend/internal/review/runner_source_test.go
@@ -0,0 +1,158 @@
+package review
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/kandev/kandev/internal/task/models"
+)
+
+// localChangedRepo is a git repo with one modified tracked file, so a review
+// against HEAD finds exactly that file.
+func localChangedRepo(t *testing.T, name string) string {
+	t.Helper()
+	dir := t.TempDir()
+	localReviewGit(t, dir, "init")
+	localReviewGit(t, dir, "config", "user.email", "review@example.test")
+	localReviewGit(t, dir, "config", "user.name", "Review Test")
+	if err := os.WriteFile(filepath.Join(dir, name), []byte("old\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	localReviewGit(t, dir, "add", ".")
+	localReviewGit(t, dir, "commit", "-m", "base")
+	if err := os.WriteFile(filepath.Join(dir, name), []byte("new\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+// localCleanRepo is a git repo with a single commit and no working-tree changes,
+// so a review against HEAD finds nothing.
+func localCleanRepo(t *testing.T) string {
+	t.Helper()
+	dir := t.TempDir()
+	localReviewGit(t, dir, "init")
+	localReviewGit(t, dir, "config", "user.email", "review@example.test")
+	localReviewGit(t, dir, "config", "user.name", "Review Test")
+	if err := os.WriteFile(filepath.Join(dir, "clean.go"), []byte("old\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	localReviewGit(t, dir, "add", ".")
+	localReviewGit(t, dir, "commit", "-m", "base")
+	return dir
+}
+
+// A saved review_source is the operator's deliberate scope, so it must be read
+// instead of the session workspace, whose untracked files would otherwise
+// replace the intended range and review the wrong change set.
+func TestRunnerSavedReviewSourceWinsOverWorkspaceChanges(t *testing.T) {
+	saved := localChangedRepo(t, "saved.go")
+	h := newRunnerHarness(t,
+		map[string]any{"workspace.go": fileEntry("workspace.go", "@@ -1 +1,2 @@\n x\n+y\n", "", "")},
+		[]string{okResponse("saved.go", 1)},
+	)
+	h.runner.taskContext = localSourceTaskContext{map[string]any{
+		"review_source": map[string]any{"worktree_path": saved, "base_ref": "HEAD"},
+	}}
+
+	run, err := h.runner.Run(context.Background(), RunRequest{TaskID: "task-1", Trigger: models.ReviewTriggerWorkflowStep})
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if run.Status != models.ReviewRunCompleted {
+		t.Fatalf("run = %+v", run)
+	}
+	if h.inference.promptCount() == 0 {
+		t.Fatal("expected the saved source to be reviewed")
+	}
+	prompt := h.inference.prompts[0]
+	if !strings.Contains(prompt, "saved.go") || strings.Contains(prompt, "workspace.go") {
+		t.Fatalf("saved review_source must win over the workspace, prompt=%q", prompt)
+	}
+}
+
+// An explicit request range is the caller's own scope and outranks the saved
+// review_source.
+func TestRunnerExplicitRangeWinsOverSavedReviewSource(t *testing.T) {
+	explicit := localChangedRepo(t, "explicit.go")
+	saved := localChangedRepo(t, "saved.go")
+	h := newRunnerHarness(t, nil, []string{okResponse("explicit.go", 1)})
+	h.runner.taskContext = localSourceTaskContext{map[string]any{
+		"review_source": map[string]any{"worktree_path": saved, "base_ref": "HEAD"},
+	}}
+
+	run, err := h.runner.Run(context.Background(), localRunRequest(t, explicit, "HEAD", ""))
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if run.Status != models.ReviewRunCompleted {
+		t.Fatalf("run = %+v", run)
+	}
+	prompt := h.inference.prompts[0]
+	if !strings.Contains(prompt, "explicit.go") || strings.Contains(prompt, "saved.go") {
+		t.Fatalf("the explicit request range must win over the saved source, prompt=%q", prompt)
+	}
+}
+
+// With no saved review_source, the session workspace remains the scope.
+func TestRunnerNoSavedReviewSourceUsesWorkspace(t *testing.T) {
+	h := newRunnerHarness(t,
+		map[string]any{"workspace.go": fileEntry("workspace.go", "@@ -1 +1,2 @@\n x\n+y\n", "", "")},
+		[]string{okResponse("workspace.go", 1)},
+	)
+
+	run, err := h.runner.Run(context.Background(), RunRequest{TaskID: "task-1"})
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if run.Status != models.ReviewRunCompleted {
+		t.Fatalf("run = %+v", run)
+	}
+	if h.inference.promptCount() == 0 {
+		t.Fatal("expected the workspace set to be reviewed")
+	}
+	if prompt := h.inference.prompts[0]; !strings.Contains(prompt, "workspace.go") {
+		t.Fatalf("the workspace set must be reviewed without a saved source, prompt=%q", prompt)
+	}
+}
+
+// A saved review_source that resolves to no files must end the request with the
+// existing no-changes reason instead of silently falling through to the
+// workspace and reviewing unrelated files.
+func TestRunnerSavedReviewSourceEmptyRangeDoesNotFallThrough(t *testing.T) {
+	clean := localCleanRepo(t)
+	h := newRunnerHarness(t,
+		map[string]any{"workspace.go": fileEntry("workspace.go", "@@ -1 +1,2 @@\n x\n+y\n", "", "")},
+		[]string{okResponse("workspace.go", 1)},
+	)
+	h.runner.taskContext = localSourceTaskContext{map[string]any{
+		"review_source": map[string]any{"worktree_path": clean, "base_ref": "HEAD"},
+	}}
+
+	_, err := h.runner.Run(context.Background(), RunRequest{TaskID: "task-1"})
+	if !errors.Is(err, ErrNoChanges) {
+		t.Fatalf("an empty saved range must be ErrNoChanges, got %v", err)
+	}
+	if h.store.runCount() != 0 {
+		t.Fatalf("an empty saved range must not create a run, got %d", h.store.runCount())
+	}
+	if h.inference.promptCount() != 0 {
+		t.Fatal("an empty saved range must not fall through to the workspace and call the reviewer")
+	}
+}
+
+// The explicit scope label must name the fields actually set: a base/head pair
+// reads as a range, a worktree-only request reads as the path rather than an
+// empty "base..head".
+func TestExplicitSourceLabelUsesFieldsActuallySet(t *testing.T) {
+	if got := explicitSourceLabel(RunRequest{BaseRef: "main", HeadRef: "abc123"}); got != "explicit range main..abc123" {
+		t.Fatalf("range label = %q", got)
+	}
+	if got := explicitSourceLabel(RunRequest{WorktreePath: `C:\worktrees\slot`}); got != `explicit worktree C:\worktrees\slot` {
+		t.Fatalf("worktree label = %q", got)
+	}
+}
diff --git a/apps/backend/internal/review/runner_terminal_write_test.go b/apps/backend/internal/review/runner_terminal_write_test.go
new file mode 100644
index 00000000000..518c94e5271
--- /dev/null
+++ b/apps/backend/internal/review/runner_terminal_write_test.go
@@ -0,0 +1,307 @@
+package review
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/task/models"
+	taskservice "github.com/kandev/kandev/internal/task/service"
+)
+
+// scriptedStore wraps fakeStore to script terminal-write failures and record the
+// context each attempt wrote with, so the retry and detachment contracts are
+// observable without a database.
+type scriptedStore struct {
+	*fakeStore
+	mu                   sync.Mutex
+	failBudget           int
+	failErr              error
+	completeBudget       int
+	completeErr          error
+	failAttempts         int
+	completeAttempts     int
+	failWriteCtxErrs     []error
+	completeWriteCtxErrs []error
+}
+
+func (s *scriptedStore) FailRun(ctx context.Context, runID, code, message string, durationMs int) (*models.TaskReviewRun, error) {
+	s.mu.Lock()
+	s.failAttempts++
+	s.failWriteCtxErrs = append(s.failWriteCtxErrs, ctx.Err())
+	fail := s.failBudget > 0
+	if fail {
+		s.failBudget--
+	}
+	err := s.failErr
+	s.mu.Unlock()
+	if fail {
+		return nil, err
+	}
+	return s.fakeStore.FailRun(ctx, runID, code, message, durationMs)
+}
+
+func (s *scriptedStore) CompleteRun(ctx context.Context, req taskservice.CompleteRunRequest) (*models.TaskReviewRun, error) {
+	s.mu.Lock()
+	s.completeAttempts++
+	s.completeWriteCtxErrs = append(s.completeWriteCtxErrs, ctx.Err())
+	fail := s.completeBudget > 0
+	if fail {
+		s.completeBudget--
+	}
+	err := s.completeErr
+	s.mu.Unlock()
+	if fail {
+		return nil, err
+	}
+	return s.fakeStore.CompleteRun(ctx, req)
+}
+
+// newScriptedHarness builds a runner over a scripted store with a zero backoff,
+// so retry tests stay fast while still exercising multiple attempts.
+func newScriptedHarness(t *testing.T) (*Runner, *scriptedStore) {
+	t.Helper()
+	store := &scriptedStore{fakeStore: newFakeStore()}
+	runner := NewRunner(RunnerDeps{
+		Store:       store,
+		Resolver:    NewResolver(nil, &fakeUtility{found: true, enabled: true, agentID: "claude-acp", model: "haiku"}, nil),
+		Changes:     &fakeChangeSource{uncommitted: map[string]any{"a.go": fileEntry("a.go", "@@ -1 +1,2 @@\n x\n+y\n", "", "")}},
+		Inference:   &fakeInference{responses: []string{okResponse("a.go", 2)}},
+		Prompts:     &fakePrompts{},
+		TaskContext: &fakeTaskContext{ctx: PromptContext{TaskTitle: "T"}},
+		Sessions:    &fakeSessions{sessionID: "sess-1"},
+		Logger:      testLogger(t),
+	})
+	runner.writePolicy = terminalWritePolicy{attempts: 3, timeout: time.Second, backoff: 0}
+	runner.Start(context.Background())
+	t.Cleanup(runner.Stop)
+	return runner, store
+}
+
+// TestRunner_TerminalWriteRetriesOnDetachedContext covers
+// AC-AGENTS-REVIEW-RUN-RECOVERY-001.1: a failure write that loses to a busy
+// writer twice, then succeeds, still records the terminal state, and every
+// attempt writes on a context detached from the (expired) pass context.
+func TestRunner_TerminalWriteRetriesOnDetachedContext(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.failBudget = 2
+	store.failErr = errors.New("database is locked")
+
+	run, err := store.CreateRun(context.Background(), taskservice.CreateRunRequest{TaskID: "task-retry"})
+	if err != nil {
+		t.Fatalf("CreateRun: %v", err)
+	}
+	if _, err := store.MarkRunRunning(context.Background(), run.ID); err != nil {
+		t.Fatalf("MarkRunRunning: %v", err)
+	}
+
+	expired, cancel := context.WithTimeout(context.Background(), 0)
+	cancel()
+	_ = runner.fail(expired, run.ID, fmt.Errorf("%w: provider exploded", ErrExecutionFailed), time.Now())
+
+	if got := store.statusOf(run.ID); got != models.ReviewRunFailed {
+		t.Fatalf("run should be failed after retry, got %q", got)
+	}
+	if store.failAttempts != 3 {
+		t.Fatalf("expected 3 attempts (2 fail, 1 succeed), got %d", store.failAttempts)
+	}
+	for i, ctxErr := range store.failWriteCtxErrs {
+		if ctxErr != nil {
+			t.Fatalf("attempt %d wrote on a non-detached context: %v", i, ctxErr)
+		}
+	}
+}
+
+// TestRunner_CompletionWriteFailureRecordsFailedRun covers
+// AC-AGENTS-REVIEW-RUN-RECOVERY-001.2: a completion write that fails on every
+// attempt leaves a failed run with a reason, never a running one.
+func TestRunner_CompletionWriteFailureRecordsFailedRun(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.completeBudget = 99
+	store.completeErr = errors.New("database is locked")
+
+	run, err := runner.Run(context.Background(), RunRequest{TaskID: "task-complete-fail"})
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if got := store.statusOf(run.ID); got != models.ReviewRunFailed {
+		t.Fatalf("a failed completion write must record failed, got %q", got)
+	}
+	if store.completeAttempts < 2 {
+		t.Fatalf("expected the completion write retried, got %d attempts", store.completeAttempts)
+	}
+	if failure, ok := store.lastFailure(); !ok || failure.code != CodeExecutionFailed {
+		t.Fatalf("expected a recorded execution failure, got %+v ok=%v", failure, ok)
+	}
+}
+
+// TestRunner_NormalCompletionWritesOnce guards that the retry path does not
+// change the ordinary, first-attempt-success completion.
+func TestRunner_NormalCompletionWritesOnce(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	run, err := runner.Run(context.Background(), RunRequest{TaskID: "task-ok"})
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if store.completeAttempts != 1 {
+		t.Fatalf("expected 1 completion attempt, got %d", store.completeAttempts)
+	}
+	if got := store.statusOf(run.ID); got != models.ReviewRunCompleted {
+		t.Fatalf("expected completed, got %q", got)
+	}
+}
+
+// TestRunner_AbandonedRunIsFinalizedAndNewReviewStarts covers
+// AC-AGENTS-REVIEW-RUN-RECOVERY-001.3: a pending/running run past the
+// progress-less limit is recorded failed and no longer blocks a new pass.
+func TestRunner_AbandonedRunIsFinalizedAndNewReviewStarts(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	stale := &models.TaskReviewRun{
+		ID: "run-stale", TaskID: "task-abandoned", Status: models.ReviewRunRunning,
+		CreatedAt: time.Now().Add(-time.Hour),
+	}
+	store.runs[stale.ID] = stale
+	store.active = stale
+
+	run, err := runner.Run(context.Background(), RunRequest{TaskID: "task-abandoned"})
+	if err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if got := store.statusOf("run-stale"); got != models.ReviewRunFailed {
+		t.Fatalf("abandoned run should be failed, got %q", got)
+	}
+	if run.ID == "run-stale" {
+		t.Fatal("the new request must not rejoin the abandoned run")
+	}
+	if got := store.runCount(); got != 2 {
+		t.Fatalf("expected a new run alongside the abandoned one, got %d", got)
+	}
+	if failure, ok := store.lastFailure(); !ok || failure.code != CodeAbandoned {
+		t.Fatalf("expected the abandonment recorded with %q, got %+v ok=%v", CodeAbandoned, failure, ok)
+	}
+}
+
+// TestRunner_FreshActiveRunIsRejoined guards that an in-limit active run is
+// still returned unchanged, with no finalization and no duplicate pass.
+func TestRunner_FreshActiveRunIsRejoined(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.active = &models.TaskReviewRun{
+		ID: "run-fresh", TaskID: "task-fresh", Status: models.ReviewRunRunning, CreatedAt: time.Now(),
+	}
+
+	got, err := runner.Launch(context.Background(), RunRequest{TaskID: "task-fresh"})
+	if err != nil {
+		t.Fatalf("Launch: %v", err)
+	}
+	if got.ID != "run-fresh" {
+		t.Fatalf("expected the fresh run rejoined, got %q", got.ID)
+	}
+	if store.runCount() != 0 {
+		t.Fatal("a fresh active run must not be duplicated")
+	}
+	if store.failAttempts != 0 {
+		t.Fatal("a fresh active run must not be finalized")
+	}
+}
+
+// TestRunner_ActiveRunWithUnknownAgeIsRejoined guards the fail-open rule: a run
+// with no recorded age is never classified as abandoned.
+func TestRunner_ActiveRunWithUnknownAgeIsRejoined(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.active = &models.TaskReviewRun{
+		ID: "run-unknown", TaskID: "task-unknown", Status: models.ReviewRunRunning,
+	}
+
+	got, err := runner.Launch(context.Background(), RunRequest{TaskID: "task-unknown"})
+	if err != nil {
+		t.Fatalf("Launch: %v", err)
+	}
+	if got.ID != "run-unknown" {
+		t.Fatalf("expected the active run rejoined, got %q", got.ID)
+	}
+	if store.failAttempts != 0 {
+		t.Fatal("an active run with no recorded age must not be finalized")
+	}
+}
+
+// TestRunner_TerminalRunIsNotAbandoned guards that the predicate never touches a
+// run that already reached a terminal state.
+func TestRunner_TerminalRunIsNotAbandoned(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.active = &models.TaskReviewRun{
+		ID: "run-done", TaskID: "task-done", Status: models.ReviewRunCompleted,
+		CreatedAt: time.Now().Add(-time.Hour),
+	}
+
+	got, err := runner.Launch(context.Background(), RunRequest{TaskID: "task-done"})
+	if err != nil {
+		t.Fatalf("Launch: %v", err)
+	}
+	if got.ID != "run-done" {
+		t.Fatalf("expected the terminal run returned, got %q", got.ID)
+	}
+	if store.failAttempts != 0 {
+		t.Fatal("a terminal run must not be finalized")
+	}
+}
+
+// TestRunner_AbandonedRunStaysWhenFinalizeFails guards the single-active-run
+// invariant: if the abandonment cannot be recorded, the existing run is
+// reported rather than a duplicate pass started.
+func TestRunner_AbandonedRunStaysWhenFinalizeFails(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.failBudget = 99
+	store.failErr = errors.New("database is locked")
+	store.active = &models.TaskReviewRun{
+		ID: "run-stuck", TaskID: "task-stuck", Status: models.ReviewRunRunning,
+		CreatedAt: time.Now().Add(-time.Hour),
+	}
+
+	got, err := runner.Launch(context.Background(), RunRequest{TaskID: "task-stuck"})
+	if err != nil {
+		t.Fatalf("Launch: %v", err)
+	}
+	if got.ID != "run-stuck" {
+		t.Fatalf("expected the existing run returned when finalization failed, got %q", got.ID)
+	}
+	if store.runCount() != 0 {
+		t.Fatal("no new run may start while the abandoned row could not be finalized")
+	}
+	if store.failAttempts < 2 {
+		t.Fatalf("expected the abandonment write retried, got %d attempts", store.failAttempts)
+	}
+}
+
+// TestRunner_ActiveRunReadErrorFailsClosed covers the review finding on the
+// downstream `ActiveRun` read: an unreadable active-run set may already hold a
+// row, so a launch must not proceed to create a second run.
+func TestRunner_ActiveRunReadErrorFailsClosed(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.activeErr = errors.New("database is locked")
+
+	if _, err := runner.Launch(context.Background(), RunRequest{TaskID: "task-read-error"}); err == nil {
+		t.Fatal("Launch must fail closed when the active-run read fails")
+	}
+	if store.runCount() != 0 {
+		t.Fatalf("no run may be created when the active-run read failed, got %d", store.runCount())
+	}
+}
+
+// TestRunner_CompletionWriteDeadlineKeepsExecutionFailureReason guards that a
+// storage write that timed out on a detached context is not mislabeled as the
+// pass exceeding its time budget; only the pass's own deadline is a timeout.
+func TestRunner_CompletionWriteDeadlineKeepsExecutionFailureReason(t *testing.T) {
+	runner, store := newScriptedHarness(t)
+	store.completeBudget = 99
+	store.completeErr = context.DeadlineExceeded
+
+	if _, err := runner.Run(context.Background(), RunRequest{TaskID: "task-complete-deadline"}); err != nil {
+		t.Fatalf("Run: %v", err)
+	}
+	if failure, ok := store.lastFailure(); !ok || failure.code != CodeExecutionFailed {
+		t.Fatalf("a completion-write timeout must keep the execution-failure reason, got %+v ok=%v", failure, ok)
+	}
+}
