+
+func TestActiveUpdateStreamReattachStopExcludesPrompt(t *testing.T) {
+	h := newWorkspaceEventsHarness(t)
+	generation, err := h.mgr.BeginPrompt("exec-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	h.mgr.executionStore.MarkPromptDispatched(h.exec.ID, generation)
