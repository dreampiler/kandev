+		ahead=$(git rev-list --count "$merge_base..HEAD")
+		if [ -z "$best_ahead" ] || [ "$ahead" -lt "$best_ahead" ]; then
+			base_ref=$candidate
+			best_ahead=$ahead
+		fi
+	done
+	[ -n "$base_ref" ] || base_ref=$(normalize_remote_ref "$origin_head")
 fi
 
 git rev-parse --verify --quiet "$base_ref^{commit}" >/dev/null || die "base ref does not resolve locally: $base_ref"
