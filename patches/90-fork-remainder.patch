+package usage
+
+import (
+	"testing"
+	"time"
+	_ "time/tzdata"
+)
+
+func TestProviderTierOwnerOverrideKeepsItsFullAllowance(t *testing.T) {
+	defaults := TierLimits{RequestsPerDay: limitNumber(100), DailyReset: "00:00 UTC"}
+	learned := TierLimits{RequestsPerDay: limitNumber(80), Learned: true}
+	owner := TierLimits{RequestsPerDay: limitNumber(90)}
+	effective := MergeTierLimits(MergeTierLimits(defaults, learned), owner)
+	now := time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC)
+	if got := EvaluateTierLimits(effective, LimitUsage{RequestsDay: 89}, now); got.Reason != "" {
+		t.Fatalf("owner allowance was reduced by the learned reserve: %+v", got)
+	}
+	got := EvaluateTierLimits(effective, LimitUsage{RequestsDay: 90}, now)
+	if got.Reason != "limit_daily" || !got.RetryAt.Equal(time.Date(2026, 10, 15, 0, 0, 0, 0, time.UTC)) {
+		t.Fatalf("daily admission = %+v", got)
+	}
+	effective = MergeTierLimits(effective, TierLimits{RequestsPerDay: limitNumber(0)})
+	if got := EvaluateTierLimits(effective, LimitUsage{RequestsDay: 1000}, now); got.Reason != "" {
+		t.Fatalf("explicit zero must disable the local cap: %+v", got)
+	}
+}
+
+func TestProviderTierMergePreservesWindowLearning(t *testing.T) {
+	now := time.Now()
+	learned := TierLimits{Windows: []LimitBudget{{Window: "5h", Unit: "tokens", Value: limitNumber(100), Reset: "rolling", Learned: true}}}
+	effective := MergeTierLimits(TierLimits{}, learned)
+	if !effective.Windows[0].Learned {
+		t.Fatal("merging a window discarded its learned provenance")
+	}
+	if got := EvaluateTierLimits(effective, LimitUsage{Windows: map[string]float64{"5h": 95}}, now); got.Reason != "limit_window" {
+		t.Fatalf("learned window lost its reserve: %+v", got)
+	}
+	owner := TierLimits{Windows: []LimitBudget{{Window: "5h", Unit: "tokens", Value: limitNumber(100), Reset: "rolling"}}}
+	effective = MergeTierLimits(effective, owner)
+	if got := EvaluateTierLimits(effective, LimitUsage{Windows: map[string]float64{"5h": 95}}, now); got.Reason != "" || effective.Windows[0].Learned {
+		t.Fatalf("owner window must replace learned provenance and reserve: %+v", got)
+	}
+}
+
+func TestProviderTierWindowRulesInheritAllowance(t *testing.T) {
+	base := TierLimits{Windows: []LimitBudget{{Window: "5h", Unit: "tokens", Value: limitNumber(100), Reset: "rolling", Learned: true}}}
+	owner := TierLimits{Windows: []LimitBudget{{Window: "5h", Unit: "tokens", Reset: "utc"}}}
+	effective := MergeTierLimits(base, owner)
+	budget := effective.Windows[0]
+	if budget.Value == nil || *budget.Value != 100 || !budget.Learned || budget.Reset != "utc" {
+		t.Fatalf("rule-only owner edit discarded inherited allowance: %+v", budget)
+	}
+}
+
+func TestProviderTierUnknownLearningRetainsWindowUncertainty(t *testing.T) {
+	used := LimitUsage{RequestsDay: 80, Windows: map[string]float64{"5h": 500}}
+	learned := LearnTierLimits(TierLimits{}, "daily", used)
+	if learned.RequestsPerDay == nil || *learned.RequestsPerDay != 80 || !learned.Learned {
+		t.Fatalf("daily learned allowance = %+v", learned)
+	}
+	known := LearnTierLimits(TierLimits{RequestsPerDay: limitNumber(100)}, "daily", used)
+	if *known.RequestsPerDay != 100 || known.Learned {
+		t.Fatalf("PR1 must retain a known default: %+v", known)
+	}
+	provisional := LearnTierLimits(TierLimits{}, "unknown_subscription", used)
+	if len(provisional.Windows) != 1 || provisional.Windows[0].Window != "5h" || !provisional.Windows[0].WindowEstimated {
+		t.Fatalf("ambiguous subscription evidence = %+v", provisional)
+	}
+}
+
+func TestProviderTierResetUsesTheOwnerTimeZone(t *testing.T) {
+	now := time.Date(2026, 10, 14, 0, 0, 0, 0, time.UTC)
+	start, reset, err := DailyLimitWindow(now, "05:00 Asia/Seoul")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !start.Equal(time.Date(2026, 10, 13, 20, 0, 0, 0, time.UTC)) || !reset.Equal(start.Add(24*time.Hour)) {
+		t.Fatalf("window = %v..%v", start, reset)
+	}
+	if err := ValidateTierLimits(TierLimits{DailyReset: "05:00 Invalid/Zone"}); err == nil {
+		t.Fatal("invalid owner reset must be rejected")
+	}
+}
+
+func TestOpenRouterZeroRemainingIsExhaustedDespiteAnEarlierUsedCounter(t *testing.T) {
+	var raw openRouterKeyResponse
+	zero := 0.0
+	raw.Data.FreeModelDailyRequests = &struct {
+		Used      float64  `json:"used"`
+		Limit     float64  `json:"limit"`
+		Remaining *float64 `json:"remaining"`
+	}{Used: 48, Limit: 50, Remaining: &zero}
+	usage := parseOpenRouterUsage(raw, time.Date(2026, 10, 14, 12, 0, 0, 0, time.UTC), 0)
+	if len(usage.Windows) != 1 || !usage.Windows[0].LimitReached || usage.FreeModelDailyRequests.Remaining != 0 {
+		t.Fatalf("explicit zero remaining was ignored: %+v", usage)
+	}
+}
diff --git a/apps/backend/internal/agent/usage/tier_scopes.go b/apps/backend/internal/agent/usage/tier_scopes.go
new file mode 100644
index 00000000000..7f155f7c7bb
--- /dev/null
+++ b/apps/backend/internal/agent/usage/tier_scopes.go
@@ -0,0 +1,198 @@
+package usage
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// Request scope kinds. A model scope covers one provider model; a group scope
+// is one allowance shared by several models of the same account.
+const (
+	ScopeKindModel = "model"
+	ScopeKindGroup = "group"
+)
+
+// Provenance of a default value.
+const (
+	ProvenancePublished   = "published"
+	ProvenanceMeasured    = "measured"
+	ProvenanceApproximate = "approximate"
+	ProvenanceProvider    = "provider"
+)
+
+// RequestScope is a daily request allowance for one model or a shared model
+// group inside a tier. Models are provider model IDs without the provider
+// prefix. Nil RequestsPerDay inherits; an explicit zero disables the scope.
+type RequestScope struct {
+	ID             string     `json:"id"`
+	Kind           string     `json:"kind,omitempty"`
+	Models         []string   `json:"models,omitempty"`
+	RequestsPerDay *float64   `json:"requests_per_day,omitempty"`
+	DailyReset     string     `json:"daily_reset,omitempty"`
+	Provenance     string     `json:"provenance,omitempty"`
+	Learned        bool       `json:"learned,omitempty"`
+	Provisional    bool       `json:"provisional,omitempty"`
+	LearnedAt      *time.Time `json:"learned_at,omitempty"`
+}
+
+// ModelScopeID is the stable ID of a single-model scope.
+func ModelScopeID(model string) string { return ScopeKindModel + ":" + model }
+
+// ScopeModelID strips the provider prefix from a profile model ID.
+func ScopeModelID(modelID string) string {
+	if _, model, found := strings.Cut(strings.TrimSpace(modelID), "/"); found {
+		return model
+	}
+	return strings.TrimSpace(modelID)
+}
+
+// Covers reports whether the scope applies to a provider model ID.
+func (s RequestScope) Covers(model string) bool {
+	model = ScopeModelID(model)
+	for _, m := range s.Models {
+		if strings.EqualFold(m, model) {
+			return true
+		}
+	}
+	return false
+}
+
+// ScopeUsageKey is the LimitUsage.Resets key of a scope.
+func ScopeUsageKey(id string) string { return "scope:" + id }
+
+// EvaluateScopeLimits checks every scope covering the model, after the tier
+// checks, and reports the first exhausted one with its daily reset.
+func EvaluateScopeLimits(scopes []RequestScope, model string, used LimitUsage, now time.Time) LimitAdmission {
+	for _, scope := range scopes {
+		if !scope.Covers(model) || !positive(scope.RequestsPerDay) {
+			continue
+		}
+		margin := 1.0
+		if scope.Learned {
+			margin = 0.95
+		}
+		if !exceeds(used.Scopes[scope.ID], scope.RequestsPerDay, margin) {
+			continue
+		}
+		_, reset, err := DailyLimitWindow(now, scope.DailyReset)
+		if err != nil || !reset.After(now) {
+			reset = now.Add(time.Minute)
+		}
+		return LimitAdmission{Reason: "limit_daily", RetryAt: reset}
+	}
+	return LimitAdmission{}
+}
+
+// CoveringScope returns the scope that learns for a model: its group first,
+// then its own model scope.
+func CoveringScope(scopes []RequestScope, model string) (RequestScope, bool) {
+	var own RequestScope
+	found := false
+	for _, scope := range scopes {
+		if !scope.Covers(model) {
+			continue
+		}
+		if scope.Kind == ScopeKindGroup {
+			return scope, true
+		}
+		own, found = scope, true
+	}
+	return own, found
+}
+
+// LearnScope replaces the learned value of one scope with the requests counted
+// in it. Learned values move down as well as up because a provider can lower
+// an allowance; owner values live in a separate column and are untouched.
+func LearnScope(learned []RequestScope, scope RequestScope, counted float64, at time.Time) []RequestScope {
+	if counted <= 0 {
+		return learned
+	}
+	scope.RequestsPerDay = limitNumber(counted)
+	scope.Learned = true
+	scope.Provenance = ""
+	stamp := at.UTC()
+	scope.LearnedAt = &stamp
+	if scope.DailyReset == "" {
+		scope.DailyReset = defaultDailyReset
+	}
+	scope.Models = append([]string(nil), scope.Models...)
+	result := make([]RequestScope, 0, len(learned)+1)
+	for _, existing := range learned {
+		if existing.ID != scope.ID {
+			result = append(result, existing)
+		}
+	}
+	return append(result, scope)
+}
+
+func mergeRequestScopes(base, next []RequestScope, learned bool) []RequestScope {
+	if len(next) == 0 {
+		return base
+	}
+	result := append([]RequestScope(nil), base...)
+	for _, scope := range next {
+		index := -1
+		for i := range result {
+			if result[i].ID == scope.ID {
+				index = i
+				break
+			}
+		}
+		if index < 0 {
+			scope.Learned = scope.Learned || learned
+			result = append(result, scope)
+			continue
+		}
+		result[index] = mergeRequestScope(result[index], scope, learned)
+	}
+	return result
+}
+
+func mergeRequestScope(base, next RequestScope, learned bool) RequestScope {
+	if next.Kind != "" && len(next.Models) > 0 {
+		base.Kind, base.Models = next.Kind, next.Models
+	}
+	if next.DailyReset != "" {
+		base.DailyReset = next.DailyReset
+	}
+	if next.RequestsPerDay != nil {
+		base.RequestsPerDay = next.RequestsPerDay
+		base.Learned = next.Learned || learned
+		base.Provisional = next.Provisional
+		base.LearnedAt = next.LearnedAt
+	}
+	return base
+}
+
+func validateRequestScope(scope RequestScope) error {
+	if strings.TrimSpace(scope.ID) == "" {
+		return fmt.Errorf("scope requires an id")
+	}
+	if !validLimitNumber(scope.RequestsPerDay) {
+		return fmt.Errorf("limits must be finite non-negative numbers")
+	}
+	if scope.Kind != "" && !oneOf(scope.Kind, ScopeKindModel, ScopeKindGroup) {
+		return fmt.Errorf("invalid scope kind")
+	}
+	if scope.Kind == ScopeKindModel && len(scope.Models) != 1 {
+		return fmt.Errorf("model scope requires one model")
+	}
+	if scope.Kind == ScopeKindGroup && len(scope.Models) < 2 {
+		return fmt.Errorf("group scope requires at least two models")
+	}
+	if scope.DailyReset != "" {
+		if _, _, err := DailyLimitWindow(time.Now(), scope.DailyReset); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// OwnerScopes clears learned markers from owner-entered scopes.
+func OwnerScopes(scopes []RequestScope) []RequestScope {
+	for i := range scopes {
+		scopes[i].Learned, scopes[i].Provisional, scopes[i].LearnedAt, scopes[i].Provenance = false, false, nil, ""
+	}
+	return scopes
+}
