+func TestHealthMissingTableUnhealthyWhileWriterCommits(t *testing.T) {
+	writer, _, pool := newWriterReaderPair(t)
+	_, health := newProgressHealth(t, pool, "required_probe", "missing_table")
+	holdCommittingWriter(t, writer)
