-	job, err := createKillOnCloseJob()
+	return InstallNamedKillOnCloseJobForSuspendedProcess(pid, "")
+}
+
+// InstallNamedKillOnCloseJobForSuspendedProcess retains the job's kernel name
+// so a saved runtime owner can inspect containment after its launcher exits.
+func InstallNamedKillOnCloseJobForSuspendedProcess(pid int, name string) (KillOnCloseJob, error) {
+	job, err := createNamedKillOnCloseJob(name)
 	if err != nil {
 		return KillOnCloseJob{}, errors.Join(err, terminateSuspendedProcess(pid))
 	}
@@ -207,7 +213,19 @@ func activeJobProcesses(job windows.Handle) (uint32, error) {
 }
 
 func createKillOnCloseJob() (windows.Handle, error) {
-	job, err := windows.CreateJobObject(nil, nil)
+	return createNamedKillOnCloseJob("")
+}
+
+func createNamedKillOnCloseJob(name string) (windows.Handle, error) {
+	var jobName *uint16
+	if name != "" {
+		var err error
+		jobName, err = windows.UTF16PtrFromString(name)
+		if err != nil {
+			return 0, err
+		}
+	}
+	job, err := windows.CreateJobObject(nil, jobName)
 	if err != nil {
 		return 0, fmt.Errorf("CreateJobObject: %w", err)
 	}
@@ -313,3 +331,20 @@ func IsTaskkillMissing(msg string) bool {
 		strings.Contains(lower, "not be found") ||
 		strings.Contains(lower, "no running instance")
 }
+
+// HideConsoleWindow marks a one-shot child console process so Windows starts it
+// without showing a new console window. It preserves fields the caller already
+// set and keeps the child attached to a console, so a .cmd or .bat shim's
+// default console descendants inherit the hidden console. Windows also applies
+// the hidden show state to a GUI program's first window, so callers must pass
+// console processes only.
+func HideConsoleWindow(cmd *exec.Cmd) {
+	if cmd == nil {
+		return
+	}
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.HideWindow = true
+	cmd.SysProcAttr.CreationFlags |= syscall.CREATE_NEW_PROCESS_GROUP
+}
