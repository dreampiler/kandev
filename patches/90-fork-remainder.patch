diff --git a/apps/backend/internal/mcp/handlers/task_id_resolution.go b/apps/backend/internal/mcp/handlers/task_id_resolution.go
new file mode 100644
index 00000000000..4e5ba70b36f
--- /dev/null
+++ b/apps/backend/internal/mcp/handlers/task_id_resolution.go
@@ -0,0 +1,159 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"go.uber.org/zap"
+
+	mcpscope "github.com/kandev/kandev/internal/mcp/scope"
+	"github.com/kandev/kandev/internal/task/models"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+// shortTaskIDPattern matches a prefix of a dashed UUID: at least 8 characters
+// of hex, optionally broken by the UUID's own dashes, at most 35 characters in
+// total. Stored ids are dashed, so a dash-free pattern would reject every
+// prefix longer than the first group and leave the "pass a longer prefix"
+// remedy unusable. The 35-character ceiling is what keeps a full 36-character
+// UUID out, so existing callers that pass full ids keep their exact behavior.
+// Only hex and dashes are accepted, so the value is safe to pass to the
+// repository's LIKE as a literal prefix.
+var shortTaskIDPattern = regexp.MustCompile(`^[0-9a-fA-F]{8}[0-9a-fA-F-]{0,27}$`)
+
+// taskRefScalarFields are the payload keys that name a task by id and that a
+// short-id expansion may rewrite. They are shared across the MCP control
+// surface (archive, move, plan read/write, related-task lookup).
+var taskRefScalarFields = []string{
+	"task_id",
+	"caller_task_id",
+	"source_task_id",
+	"parent_id",
+	"depends_on_task_id",
+}
+
+// maxTaskIDCandidates bounds the candidate list returned for an ambiguous
+// prefix so a rejection stays small.
+const maxTaskIDCandidates = 20
+
+// expandShortTaskRefs rewrites any short task-id prefix in a known task-ref
+// field to the full id, resolving it against the caller's own workspace. It
+// runs before the authorization guards so those guards see the resolved id.
+//
+// A value that is not an 8-35 character hex prefix is returned unchanged. When
+// a prefix matches more than one task in the workspace the request is rejected
+// with the candidate list rather than guessing, so a controller learns the full
+// ids without the tool silently acting on the wrong task. When no task matches,
+// the original value is left in place and the target tool keeps its own
+// not-found behavior. Returns (msg, nil) for a pass-through or rewritten
+// message, or (nil, errorMsg) to reject the request.
+func (h *Handlers) expandShortTaskRefs(ctx context.Context, msg *ws.Message) (*ws.Message, *ws.Message) {
+	if h.taskSvc == nil || len(msg.Payload) == 0 {
+		return msg, nil
+	}
+	principal, ok := mcpscope.PrincipalFromContext(ctx)
+	if !ok || principal.WorkspaceID == "" {
+		return msg, nil
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(msg.Payload, &fields); err != nil || fields == nil {
+		return msg, nil
+	}
+
+	changed := false
+	for _, key := range taskRefScalarFields {
+		raw, present := fields[key]
+		if !present {
+			continue
+		}
+		resolved, candidates, ok := h.expandShortTaskRefValue(ctx, principal.WorkspaceID, raw)
+		if !ok {
+			continue
+		}
+		if candidates != nil {
+			errorMsg, _ := shortTaskIDAmbiguous(msg, resolved, candidates)
+			return nil, errorMsg
+		}
+		encoded, err := json.Marshal(resolved)
+		if err != nil {
+			continue
+		}
+		fields[key] = encoded
+		changed = true
+		h.logger.Info("expanded short task id", zap.String("field", key), zap.String("task_id", resolved))
+	}
+	if !changed {
+		return msg, nil
+	}
+	payload, err := json.Marshal(fields)
+	if err != nil {
+		return msg, nil
+	}
+	replacement := *msg
+	replacement.Payload = payload
+	return &replacement, nil
+}
+
+// expandShortTaskRefValue resolves one raw field value. It returns
+// (fullID, nil, true) when the value is a unique short id, (rawPrefix,
+// candidates, true) when it is ambiguous, and ("", nil, false) when the value
+// is not a short id, matches no task, or the lookup failed — in which case the
+// caller leaves the original value in place.
+func (h *Handlers) expandShortTaskRefValue(
+	ctx context.Context, workspaceID string, raw json.RawMessage,
+) (string, []*models.Task, bool) {
+	var value string
+	if err := json.Unmarshal(raw, &value); err != nil {
+		return "", nil, false
+	}
+	value = strings.TrimSpace(value)
+	if !shortTaskIDPattern.MatchString(value) {
+		return "", nil, false
+	}
+	tasks, err := h.taskSvc.FindTasksByIDPrefix(ctx, workspaceID, strings.ToLower(value))
+	if err != nil {
+		h.logger.Warn("short task id prefix lookup failed",
+			zap.String("prefix", value), zap.Error(err))
+		return "", nil, false
+	}
+	switch len(tasks) {
+	case 0:
+		return "", nil, false
+	case 1:
+		return tasks[0].ID, nil, true
+	default:
+		return value, tasks, true
+	}
+}
+
+// shortTaskIDAmbiguous builds the rejection for a prefix that matches several
+// tasks in the caller's workspace, listing the candidates it may have meant.
+// The lookup is capped, so a count at the cap is reported as a lower bound
+// rather than as the exact number of matches.
+func shortTaskIDAmbiguous(msg *ws.Message, prefix string, tasks []*models.Task) (*ws.Message, error) {
+	candidates := make([]map[string]interface{}, 0, maxTaskIDCandidates)
+	for i, task := range tasks {
+		if i >= maxTaskIDCandidates {
+			break
+		}
+		candidates = append(candidates, map[string]interface{}{
+			"task_id": task.ID,
+			"title":   task.Title,
+			"state":   string(task.State),
+		})
+	}
+	count := strconv.Itoa(len(tasks)) + " tasks"
+	if len(tasks) >= maxTaskIDCandidates {
+		count = "at least " + count
+	}
+	return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeValidation,
+		"task id prefix "+prefix+" matches "+count+
+			" in this workspace; pass a longer prefix or the full id", map[string]interface{}{
+			"reason":     "ambiguous_task_id_prefix",
+			"prefix":     prefix,
+			"candidates": candidates,
+		})
+}
diff --git a/apps/backend/internal/mcp/handlers/task_id_resolution_test.go b/apps/backend/internal/mcp/handlers/task_id_resolution_test.go
new file mode 100644
index 00000000000..6139ca4b793
--- /dev/null
+++ b/apps/backend/internal/mcp/handlers/task_id_resolution_test.go
@@ -0,0 +1,172 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	mcpprofile "github.com/kandev/kandev/internal/mcp/profile"
+	mcpscope "github.com/kandev/kandev/internal/mcp/scope"
+	"github.com/kandev/kandev/internal/task/models"
+	sqliterepo "github.com/kandev/kandev/internal/task/repository/sqlite"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+const (
+	sharedPrefixTaskA = "15c6b3f2-0000-4000-8000-000000000001"
+	sharedPrefixTaskB = "15c6b3f2-0000-4000-8000-000000000002"
+	uniquePrefixTask  = "082e5aad-0000-4000-8000-000000000003"
+)
+
+func kanbanPrincipalCtx(workspaceID, taskID string) context.Context {
+	return mcpscope.WithPrincipal(context.Background(), mcpscope.Principal{
+		WorkspaceID:     workspaceID,
+		CallerTaskID:    taskID,
+		CallerSessionID: taskID + "-session",
+		Surface:         mcpprofile.SurfaceKanbanTask,
+	})
+}
+
+func newPrefixHandlers(t *testing.T) (*Handlers, *sqliterepo.Repository, string) {
+	t.Helper()
+	svc, repo := newTestTaskService(t)
+	ctx := context.Background()
+	require.NoError(t, repo.CreateWorkspace(ctx, &models.Workspace{ID: "ws-prefix", Name: "Prefix"}))
+	require.NoError(t, repo.CreateWorkflow(ctx, &models.Workflow{ID: "wf-prefix", WorkspaceID: "ws-prefix", Name: "Board"}))
+	require.NoError(t, repo.CreateWorkspace(ctx, &models.Workspace{ID: "ws-elsewhere", Name: "Elsewhere"}))
+	for _, task := range []*models.Task{
+		{ID: sharedPrefixTaskA, WorkspaceID: "ws-prefix", WorkflowID: "wf-prefix", Title: "First", State: v1.TaskStateInProgress},
+		{ID: sharedPrefixTaskB, WorkspaceID: "ws-prefix", WorkflowID: "wf-prefix", Title: "Second", State: v1.TaskStateInProgress},
+		{ID: uniquePrefixTask, WorkspaceID: "ws-prefix", WorkflowID: "wf-prefix", Title: "Unique", State: v1.TaskStateInProgress},
+		{ID: "cafebabe-0000-4000-8000-000000000004", WorkspaceID: "ws-elsewhere", Title: "Other", State: v1.TaskStateInProgress},
+	} {
+		require.NoError(t, repo.CreateTask(ctx, task))
+	}
+	h := &Handlers{taskSvc: svc, logger: testLogger(t).WithFields()}
+	return h, repo, "ws-prefix"
+}
+
+func msgTaskID(t *testing.T, msg *ws.Message) string {
+	t.Helper()
+	var fields map[string]string
+	require.NoError(t, json.Unmarshal(msg.Payload, &fields))
+	return fields["task_id"]
+}
+
+func TestExpandShortTaskRefs_ResolvesUniquePrefix(t *testing.T) {
+	h, _, wsID := newPrefixHandlers(t)
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+	msg := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "082e5aad"})
+	expanded, errMsg := h.expandShortTaskRefs(ctx, msg)
+	require.Nil(t, errMsg)
+	require.NotNil(t, expanded)
+	assert.NotSame(t, msg, expanded)
+	assert.Equal(t, uniquePrefixTask, msgTaskID(t, expanded))
+}
+
+func TestExpandShortTaskRefs_RejectsAmbiguousPrefixWithCandidates(t *testing.T) {
+	h, _, wsID := newPrefixHandlers(t)
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+	msg := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "15c6b3f2"})
+	expanded, errMsg := h.expandShortTaskRefs(ctx, msg)
+	require.Nil(t, expanded)
+	require.NotNil(t, errMsg)
+	assertWSError(t, errMsg, ws.ErrorCodeValidation)
+	var ep ws.ErrorPayload
+	require.NoError(t, json.Unmarshal(errMsg.Payload, &ep))
+	assert.Equal(t, "ambiguous_task_id_prefix", ep.Details["reason"])
+	candidates, ok := ep.Details["candidates"].([]interface{})
+	require.True(t, ok, "details must carry the candidate list")
+	assert.Len(t, candidates, 2)
+}
+
+func TestExpandShortTaskRefs_LeavesFullUnknownAndUnownedValuesAlone(t *testing.T) {
+	h, _, wsID := newPrefixHandlers(t)
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+
+	full := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": uniquePrefixTask})
+	expanded, errMsg := h.expandShortTaskRefs(ctx, full)
+	require.Nil(t, errMsg)
+	assert.Same(t, full, expanded, "a full UUID is never rewritten")
+
+	unknown := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "deadbeef"})
+	expanded, errMsg = h.expandShortTaskRefs(ctx, unknown)
+	require.Nil(t, errMsg)
+	assert.Same(t, unknown, expanded, "an unmatched prefix keeps its value")
+
+	noPrincipal := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "082e5aad"})
+	expanded, errMsg = h.expandShortTaskRefs(context.Background(), noPrincipal)
+	require.Nil(t, errMsg)
+	assert.Same(t, noPrincipal, expanded, "resolution requires a workspace principal")
+
+	foreign := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "cafebabe"})
+	expanded, errMsg = h.expandShortTaskRefs(ctx, foreign)
+	require.Nil(t, errMsg)
+	assert.Same(t, foreign, expanded, "a prefix that lives in another workspace is not resolved")
+}
+
+// TestExpandShortTaskRefs_ResolvesDashedLongerPrefix pins the disambiguation
+// remedy the ambiguity message offers: stored ids are dashed, so a prefix past
+// the first group must resolve too.
+func TestExpandShortTaskRefs_ResolvesDashedLongerPrefix(t *testing.T) {
+	h, _, wsID := newPrefixHandlers(t)
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+
+	ambiguous := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "15c6b3f2"})
+	expanded, errMsg := h.expandShortTaskRefs(ctx, ambiguous)
+	require.Nil(t, expanded)
+	require.NotNil(t, errMsg)
+
+	longer := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "15c6b3f2-0000-4000-8000-000000000002"})
+	expanded, errMsg = h.expandShortTaskRefs(ctx, longer)
+	require.Nil(t, errMsg)
+	require.NotNil(t, expanded)
+	assert.Equal(t, sharedPrefixTaskB, msgTaskID(t, expanded))
+}
+
+// TestHandleArchiveTask_ResolvesShortID is the completion-path check: a
+// controller that knows only the first eight characters archives the task.
+func TestHandleArchiveTask_ResolvesShortID(t *testing.T) {
+	h, repo, wsID := newPrefixHandlers(t)
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+	msg := makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "082e5aad"})
+	expanded, errMsg := h.expandShortTaskRefs(ctx, msg)
+	require.Nil(t, errMsg)
+	require.NotNil(t, expanded)
+
+	resp, err := h.handleArchiveTask(ctx, expanded)
+	require.NoError(t, err)
+	require.Equal(t, ws.MessageTypeResponse, resp.Type)
+
+	archived, err := repo.GetTask(ctx, uniquePrefixTask)
+	require.NoError(t, err)
+	require.NotNil(t, archived)
+	assert.NotNil(t, archived.ArchivedAt, "the resolved task must actually be archived")
+}
+
+// TestGuardedDispatcherResolvesShortIDBeforeArchive pins the dispatcher wiring
+// itself: a short id sent through the production guarded dispatcher must be
+// expanded before the authorization guards, so reordering or dropping the
+// expansion step would reintroduce the original short-id archive failure.
+func TestGuardedDispatcherResolvesShortIDBeforeArchive(t *testing.T) {
+	h, repo, wsID := newPrefixHandlers(t)
+	dispatcher := ws.NewDispatcher()
+	(&guardedMCPDispatcher{Dispatcher: dispatcher, handlers: h}).
+		RegisterFunc(ws.ActionMCPArchiveTask, h.handleArchiveTask)
+
+	ctx := kanbanPrincipalCtx(wsID, sharedPrefixTaskA)
+	resp, err := dispatcher.Dispatch(ctx,
+		makeWSMessage(t, ws.ActionMCPArchiveTask, map[string]string{"task_id": "082e5aad"}))
+	require.NoError(t, err)
+	require.NotNil(t, resp)
+	require.Equal(t, ws.MessageTypeResponse, resp.Type)
+
+	archived, err := repo.GetTask(ctx, uniquePrefixTask)
+	require.NoError(t, err)
+	require.NotNil(t, archived)
+	assert.NotNil(t, archived.ArchivedAt, "the dispatcher must resolve the short id before the archive handler")
+}
diff --git a/apps/backend/internal/mcp/handlers/task_list_workspace.go b/apps/backend/internal/mcp/handlers/task_list_workspace.go
new file mode 100644
index 00000000000..906df91683c
--- /dev/null
+++ b/apps/backend/internal/mcp/handlers/task_list_workspace.go
@@ -0,0 +1,60 @@
+package handlers
+
+import (
+	"context"
+
+	"go.uber.org/zap"
+
+	mcpprofile "github.com/kandev/kandev/internal/mcp/profile"
+	mcpscope "github.com/kandev/kandev/internal/mcp/scope"
+	"github.com/kandev/kandev/internal/task/dto"
+	"github.com/kandev/kandev/internal/task/models"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+// workspaceTaskListPageSize bounds the workspace-scoped task list. It matches
+// the largest page the sidebar list uses, so a controller sees the same tasks
+// a person does in one call. The workspace form is a single page: tasks past
+// this bound are counted in total but not returned.
+const workspaceTaskListPageSize = 200
+
+// handleListWorkspaceTasks lists every non-archived, non-ephemeral task in a
+// workspace, including tasks that belong to no workflow. A controller principal
+// (see callerIsWorkspaceController) also sees automation-run outputs; an
+// ordinary task principal keeps the provenance-hiding list, so those rows stay
+// out of a normal worker's view. A non-Office caller may only list its own
+// workspace; cross-workspace listing stays on the Office reach path.
+func (h *Handlers) handleListWorkspaceTasks(ctx context.Context, msg *ws.Message, workspaceID string) (*ws.Message, error) {
+	if principal, ok := mcpscope.PrincipalFromContext(ctx); ok &&
+		principal.Surface != mcpprofile.SurfaceOfficeTask &&
+		principal.WorkspaceID != "" && workspaceID != principal.WorkspaceID {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeForbidden,
+			"listing another workspace's tasks requires the Office cross-workspace setting", nil)
+	}
+	tasks, total, err := h.listWorkspaceTasks(ctx, workspaceID)
+	if err != nil {
+		h.logger.Error("failed to list workspace tasks", zap.Error(err))
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeInternalError, "Failed to list tasks", nil)
+	}
+	dtos := make([]dto.TaskDTO, 0, len(tasks))
+	for _, task := range tasks {
+		dtos = append(dtos, dto.FromTask(task))
+	}
+	h.enrichTasksWithPendingActions(ctx, tasks, dtos)
+	h.enrichTasksWithPRs(ctx, dtos)
+	return ws.NewResponse(msg.ID, msg.Action, dto.ListTasksResponse{Tasks: dtos, Total: total})
+}
+
+// listWorkspaceTasks selects the workspace-list variant for the caller. A
+// controller principal reads through the inclusive contract so it can find and
+// act on a board-less automation-run output; every other principal reads the
+// provenance-hiding contract, so automation runs stay out of an ordinary
+// worker's view. Both variants include workflow-less tasks.
+func (h *Handlers) listWorkspaceTasks(ctx context.Context, workspaceID string) ([]*models.Task, int, error) {
+	if h.callerIsWorkspaceController(ctx) {
+		return h.taskSvc.ListTasksByWorkspaceIncludingAutomation(
+			ctx, workspaceID, "", "", "", 1, workspaceTaskListPageSize, "", false, false, false, false, false)
+	}
+	return h.taskSvc.ListTasksByWorkspace(
+		ctx, workspaceID, "", "", "", 1, workspaceTaskListPageSize, "", false, false, false, false)
+}
