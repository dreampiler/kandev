#!/usr/bin/env bash
# Pre-commit supplies repository-relative Go filenames. Lint their complete
# packages for type information; CI owns the full-backend scan.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE \
	GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

cd "$(dirname "${BASH_SOURCE[0]}")/.."

packages=()
for file in "$@"; do
	case "$file" in
		apps/backend/*.go) ;;
		*) continue ;;
	esac
	package="./${file#apps/backend/}"
	package=${package%/*}
	for existing in ${packages[@]+"${packages[@]}"}; do
		if [ "$existing" = "$package" ]; then
			continue 2
		fi
	done
	packages+=("$package")
done

[ "${#packages[@]}" -gt 0 ] || exit 0

# golangci-lint guards one run per host through os.TempDir()/golangci-lint.lock.
# Concurrent worktrees of the same repository share that path, so a second copy
# aborts with "parallel golangci-lint is running" instead of linting. Keep the
# analysis cache and the lock file inside this worktree so parallel checkouts
# never contend. GOCACHE stays shared: it is content-addressed and lock-free.
lint_state="$PWD/.lint-cache"
GOLANGCI_LINT_CACHE="$lint_state/cache"; export GOLANGCI_LINT_CACHE
TMPDIR="$lint_state/tmp"; TMP="$lint_state/tmp"; TEMP="$lint_state/tmp"
export TMPDIR TMP TEMP
mkdir -p "$GOLANGCI_LINT_CACHE" "$TMPDIR"

base=$(scripts/resolve-go-lint-base --comparison-base)
cd apps/backend
exec golangci-lint run "${packages[@]}" --new-from-rev="$base" --timeout=5m
